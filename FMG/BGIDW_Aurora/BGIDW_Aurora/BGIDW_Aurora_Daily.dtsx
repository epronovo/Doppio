        <DTS:Executable
          DTS:refId="Package\Chart of Accounts\Upsert"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{64113B94-A5F2-49FE-8B75-B5B7E0520837}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Upsert"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server 2008 R2; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F8976FEE-7128-4781-B650-C187019B6D6A}"
              SQLTask:TimeOut="1800"
              SQLTask:SqlStatementSource="INSERT INTO dbo.gl_chart_of_account&#xA;(&#xA;    row_id,&#xA;    system_id,&#xA;    system_entity_id,&#xA;    ledger_id,&#xA;    acct_id,&#xA;    internal_acct_id,&#xA;    type,&#xA;    currency,&#xA;    description,&#xA;    eff_date,&#xA;    obs_date,&#xA;    BPC_extractflag,&#xA;    cat_acct,&#xA;    acct_level1,&#xA;    acct_level2,&#xA;    acct_level3,&#xA;    acct_level4,&#xA;    acct_level5,&#xA;    control_account,&#xA;    reports_to_acct,&#xA;    acct_display,&#xA;    date_inserted,&#xA;    acct_level6,&#xA;    acct_level7&#xA;)&#xA;SELECT a.row_id,&#xA;       a.system_id,&#xA;       a.system_entity_id,&#xA;       a.ledger_id,&#xA;       a.acct_id,&#xA;       a.internal_acct_id,&#xA;       a.type,&#xA;       a.currency,&#xA;       a.description,&#xA;       a.eff_date,&#xA;       a.obs_date,&#xA;       a.BPC_extractflag,&#xA;       a.cat_acct,&#xA;       a.acct_level1,&#xA;       a.acct_level2,&#xA;       a.acct_level3,&#xA;       a.acct_level4,&#xA;       a.acct_level5,&#xA;       a.control_account,&#xA;       a.reports_to_acct,&#xA;       a.acct_display,&#xA;       GETDATE(),&#xA;       a.acct_level6,&#xA;       a.acct_level7&#xA;FROM gl_chart_of_account_stage a&#xA;    LEFT JOIN gl_chart_of_account b&#xA;        ON a.system_id = b.system_id&#xA;           AND a.system_entity_id = b.system_entity_id&#xA;           AND a.ledger_id = b.ledger_id&#xA;           AND a.acct_id = b.acct_id&#xA;WHERE b.acct_id IS NULL;&#xA;&#xA;UPDATE gl_chart_of_account&#xA;SET [description] = b.[description]&#xA;FROM gl_chart_of_account a&#xA;    INNER JOIN gl_chart_of_account_stage b&#xA;        ON a.system_id = b.system_id&#xA;           AND a.system_entity_id = b.system_entity_id&#xA;           AND a.ledger_id = b.ledger_id&#xA;           AND a.acct_id = b.acct_id&#xA;WHERE a.currency &lt;&gt; b.currency&#xA;      OR a.[description] &lt;&gt; b.[description];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
