                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 1 AS system_id,
CONO15 AS system_entity_id,
CASE PRMT15 WHEN 'TN' THEN 'salesperson'
               WHEN 'SN' THEN 'sales_region'
               WHEN 'TR' THEN 'sales_territory'
              END AS desc_type,
ltrim(rtrim(PSAR15)) AS  desc_key,
ltrim(rtrim(PRMD15)) AS desc_value 
FROM DB2LOCAL.AULT2F2PRD.INP15
WHERE PRMT15 in ('SN','TR','TN') AND CONO15 in ('27','65','75','76','78')</property>
