                </component>
                <component
                  refId="Package\Vendors\Load Vendors\ADO NET Source"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT   DISTINCT a.cono05 ,
         a.supn05 ,
         a.dseq05 ,
         snam05 ,
         sad105 ,
         sad205 ,
         sad305 ,
         sad405 ,
         sad505 ,
         pcd105 ,
         pcd205 ,
         cocd05 ,
         CASE WHEN rsts05 = ' ' THEN 1
              ELSE 0
         END AS rsts05 ,
         COALESCE(b.ct, 0) AS po_count_last_3_yr,
         MAX(c.zstate) AS zstate ,
         MIN(zcity) AS zcity,

CAST(PTTD05 AS VARCHAR(20)) AS payment_terms,
		 '' as discount,
		 '' as discount_days,
		 PLP05X.GACT05 as gl_account,
		 '' as notes,
		 Cast(PLP05X.PAMT05 as varChar(30)) as PreApproval_amount,
		 PLP05X.OACT05 as customer_account,
		 CASE
			WHEN CURN05 = 'CAN'  THEN 'CAD'
			WHEN CURN05 = 'PES' THEN 'MXN'
			WHEN CURN05 = 'RMB' THEN 'CNX'
			ELSE CURN05
		 END AS currency,
		 PLP05X.POST05 as matching_type,
		 OFNB1A as office_phone,
		 CNTN1A contact_first_name,
		 '' as contact_last_name,
		 EMIL1A as email_address,
		 CASE
			WHEN PAY105 = 'X' THEN 'Y'
			ELSE 'N'
		 END AS ADFLAG,
		 VTID05 as tax_id
FROM     ault1f2prd.plp05 a
         LEFT JOIN zclib.zccity c ON a.pcd105 = c.zcode
         LEFT OUTER JOIN PRDMODSF4.PLP05X AS PLP05X ON A.CONO05 = PLP05X.CONO05 AND A.SUPN05 = PLP05X.SUPN05 AND PLP05X.DSEQ05 = '000'
 LEFT JOIN
    (
        SELECT cono02,
               vndr02,
               COUNT(*) AS ct
        FROM ault2f2prd.pmp02
        where DATE(TIMESTAMP_FORMAT(CAST(ORDT02 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) &gt; current date - 3 years
        GROUP BY cono02,
                 vndr02
    ) b
        ON a.cono05 = b.cono02
           AND a.supn05 = b.vndr02
	LEFT OUTER JOIN Ault1F2PRD.T1P1A01P AS T1P1A01P
		ON T1P1A01P.TPAC1A = A.SUPN05
		AND T1P1A01P.CONO1A = A.CONO05
		AND T1P1A01P.DSEQ1A = A.DSEQ05
		AND T1P1A01P.APPL1A = 'PL'
		AND T1P1A01P.CTNU1A = 1
WHERE    a.supn05 &lt;&gt; '' AND NOT (a.CONO05='69' AND a.SUPN05='REC02' )
GROUP BY a.cono05 ,
         a.supn05 ,
         a.dseq05 ,
         snam05 ,
         sad105 ,
         sad205 ,
         sad305 ,
         sad405 ,
         sad505 ,
         pcd105 ,
         pcd205 ,
         cocd05 ,
         COALESCE(b.ct, 0) ,
         CASE WHEN rsts05 = ' ' THEN 1
              ELSE 0
         END,
        PTTD05,
GACT05,
PAMT05,
OACT05,
CURN05,
POST05,
OFNB1A,
CNTN1A,
EMIL1A,
PAY105,
VTID05</property>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.Boolean"
                      description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                      name="AllowImplicitStringConversion">true</property>
                    <property
                      dataType="System.String"
                      description="The Source database table name."
                      expressionType="Notify"
                      name="TableOrViewName"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                    <property
                      dataType="System.Int32"
                      description="Specify the mode to retrieve external column information"
                      name="AccessMode"
                      typeConverter="Microsoft.SqlServer.Dts.Pipeline.DataReaderSourceAdapter+EnumToStringConverter">2</property>
                    <property
                      dataType="System.String"
                      name="UserComponentTypeName">Microsoft.DataReaderSourceAdapter</property>
                  </properties>
