                <component
                  refId="Package\List Price For System Entity ID (76,78,27,65,75)\Populate Temp Table tmp_item_list_price\OLE DB Source JBA OLEDB"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source JBA OLEDB"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
	1 system_id
	,LTRIM(RTRIM(oep80.CONO80)) system_entity_id
 	,LTRIM(RTRIM(oep80.CATN80)) item_num
	,LTRIM(RTRIM(oep80.LIST80)) price_disc_list
	,DATE(TIMESTAMP_FORMAT(CAST(im.DTEF80 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) effective_start
	,LTRIM(RTRIM(oep80.CURN80)) currency_code
	,1 qty_break_01
	,oep80.PRCE80 price_01
	,maxa.date_last_modified update_dt
from AULT2F2PRD.OEP80 oep80
inner join
	(
		select
			LTRIM(RTRIM(oep80.CONO80)) CONO80
			,LTRIM(RTRIM(oep80.CATN80)) CATN80
			,LTRIM(RTRIM(oep80.LIST80)) LIST80
			,LTRIM(RTRIM(oep80.CURN80)) CURN80
			,max(DTEF80) DTEF80
		from AULT2F2PRD.OEP80 oep80
		where DATE(TIMESTAMP_FORMAT(CAST(DTEF80 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) &lt;= CURRENT_DATE
	and cono80 in('76','78','27','65','75')
		group by CONO80
			,CATN80
			,LIST80
			,CURN80

	) im on im.cono80=oep80.cono80 and im.catn80=oep80.catn80 and im.list80=oep80.list80 and im.curn80=oep80.curn80 and im.dtef80=oep80.dtef80
left outer join 
	(
		select 
			LTRIM(RTRIM(CONO80)) CONO80
			,LTRIM(RTRIM(LIST80)) LIST80
			,LTRIM(RTRIM(CATN80)) CATN80
			,LTRIM(RTRIM(CURN80)) CURN80
			,max(DATE(TIMESTAMP_FORMAT(CAST(adat80 + 19000000 AS VARCHAR(20)), 'YYYYMMDD'))) date_last_modified 
		from AULT2F2PRD.OEP80a 
		where cono80 in('76','78','27','65','75')
		group by CONO80
			,LIST80
			,CATN80
			,CURN80
	)maxa on maxa.cono80=oep80.cono80 and maxa.list80=oep80.list80 and maxa.catn80=oep80.catn80 and maxa.curn80=oep80.curn80
where oep80.cono80 in('76','78','27','65','75')</property>
