                <component
                  refId="Package\PO Lines JBA\po_line\ERP Open PO Lines - PLP03 and PLP02"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="ERP Open PO Lines - PLP03 and PLP02"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select DISTINCT
1 as system_id,
CONO03 as system_entity_id,
ORDN03 as po_num,
LINE03 as po_line,
CAST(BOSN03 AS NVARCHAR(15)) as po_seq,
ACRC03 as status,
ORDC02 as po_class,
VNDR03 as vendor_num,
SSEQ02 as vendor_seq,
CAST(CASE WHEN ORDC02 = 7 THEN VCAT03 ELSE ITEM03 END AS NVARCHAR(60)) as item_num_internal,
CURC02 as currency_code,
OQTY03 as qty_ordered,
QREC03 as qty_received,
QTOS03 as qty_outstanding,
--DATE(TIMESTAMP_FORMAT(CAST(DUED03 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) as due_date,
CAST(LEFT(CAST(DUED03 + 19000000 AS VARCHAR(20)), 4) CONCAT '-' CONCAT
LEFT(RIGHT(CAST(DUED03 + 19000000 AS VARCHAR(20)), 4), 2) CONCAT '-' CONCAT
RIGHT(CAST(DUED03 + 19000000 AS VARCHAR(20)),2)  AS NVARCHAR(10))
  as due_date,
PLAN03 as planner_code,
ACTF03 as active_flag,
DATE(TIMESTAMP_FORMAT(CAST( b.ORDT02 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) as po_date,
PRIC03 as unit_price,
OUOM03 as unit_of_measure_order,
PUOM03 as unit_of_measure_purchase,
SUOM03 as unit_of_measure_stock,
PRIC03 * OQTY03 as extended_price
FROM AULT2F2PRD.PMP03 a
INNER JOIN AULT2F2PRD.PMP02 b
on a.CONO03=b.CONO02 and a.ORDN03=b.ORDN02 AND a.VNDR03=b.VNDR02

WHERE ACRC02 &lt;&gt; 'C' 
AND DTLC03=9999999
AND CONO03 NOT IN ('AB','G1','G7','SW','SP')
AND ORDN03 NOT IN ('3602507','3602504')</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
