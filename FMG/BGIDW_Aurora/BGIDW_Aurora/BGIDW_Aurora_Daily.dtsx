                <component
                  refId="Package\PO Header\Po_Header\Get Po Headers"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Get Po Headers"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">Select
	1 as system_id,
	cast(CONO02 as nvarchar(10)) as system_entity_id,
	cast(ORDN02 as nvarchar(20)) as po_num,
	cast(ORDC02 as nvarchar(10)) as po_type,
	cast(rtrim(VNDR02)as nvarchar(30)) as vend_num,
	cast(SSEQ02 as nvarchar(15)) as vend_seq,
	cast(PLAN02 as nvarchar(10))as buyer_id,
	cast(COALESCE(PLNN06, '') as nvarchar(20)) AS buyer_name,
	cast((CAST(((CAST(SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 1, 1) AS NUMERIC(4,0)) - 1) + 20) 
           AS VARCHAR(2)) CONCAT 
		SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 2, 2) CONCAT
		'-' CONCAT
		SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 4, 2)  CONCAT 
		'-' CONCAT
		SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 6, 2)) as date) as po_date,                
	cast((select count(*) from AULT2F2PRD.desc inner join PRDMODSF4.pmp75u on cono15=cono75 and chgc75=substr(psar15, 1, 3) where prmt15='A080' and prml15=1 and cono75=cono02 and ordn75=ordn02 )as decimal(18,4)) as fuel_surcharge,
	cast((select count(*) from AULT2F2PRD.desc inner join PRDMODSF4.pmp75u on cono15=cono75 and chgc75=substr(psar15, 1, 3) where prmt15='A080' and prml15=2 and cono75=cono02 and ordn75=ordn02 )as decimal(18,4)) as matl_surcharge,
	cast((select count(*) from AULT2F2PRD.desc inner join PRDMODSF4.pmp75u on cono15=cono75 and chgc75=substr(psar15, 1, 3) where prmt15='A080' and prml15=3 and cono75=cono02 and ordn75=ordn02 )as decimal(18,4)) as freight,
	cast((select count(*) from AULT2F2PRD.desc inner join PRDMODSF4.pmp75u on cono15=cono75 and chgc75=substr(psar15, 1, 3) where prmt15='A080' and prml15=4 and cono75=cono02 and ordn75=ordn02 )as decimal(18,4)) as sales_tax,
	cast((select count(*) from AULT2F2PRD.desc inner join PRDMODSF4.pmp75u on cono15=cono75 and chgc75=substr(psar15, 1, 3) where prmt15='A080' and prml15=5 and cono75=cono02 and ordn75=ordn02 )as decimal(18,4)) as other_charges,
	cast((select count(*) from AULT2F2PRD.desc inner join PRDMODSF4.pmp75u on cono15=cono75 and chgc75=substr(psar15, 1, 3) where prmt15='A080' and prml15=6 and cono75=cono02 and ordn75=ordn02 )as decimal(18,4)) as misc_charges,
	cast(PTTD05 as nvarchar(15)) as terms_code,
	Case when CONO02 = '77' then 
		'1F1F24FF61074118AC91'
	Else 
		'98EF03C78F06440A9545'
	End  as PolicyExternalID,
	cast('' as nvarchar(50)) as ship_name,
	cast('' as nvarchar(50)) as ship_address_1,
	cast('' as nvarchar(50)) as ship_address_2,
	cast('' as nvarchar(50)) as ship_address_3,
	cast('' as nvarchar(50)) as ship_city,
	cast('' as nvarchar(50)) as ship_state,
	cast('' as nvarchar(10)) as ship_zip_code,
	cast('' as nvarchar(5)) as ship_country_code,
	cast((select NOMM03 from ault2f2prd.pmp03 where cono03 = cono02 and ordn03 = ordn02 and acrc03 &lt;&gt; 'C'  and DTLC03 = 9999999 fetch first 1 rows only)as nvarchar(15)) as ledger_code,
	cast (0 as decimal(18,4)) as discount,
	cast ('0'as varchar(10)) as discountdays           
From  AULT2F2PRD.PMP02
/*inner join ault2f2PRD.pmp03 on
      CONO03 = CONO02 AND
       ORDN03 = ORDN02 AND
       ACRC03 &lt;&gt; 'C'  AND  
       DLTF03 = ' '      AND 
       DTLC03 = 9999999 AND
       LINE03 = (SELECT MIN(LINE03) from AULT2F2PRD.PMP03 where 
      CONO03 = CONO02 AND
       ORDN03 = ORDN02 AND
       ACRC03 &lt;&gt; 'C'  AND  
       DLTF03 = ' '      AND 
       DTLC03 = 9999999)    */
LEFT JOIN AULT2F2PRD.PMP06 ON CONO02 = CONO06 
	AND PLAN02 = PLAN06
INNER JOIN AULT1F2PRD.PLP05 ON CONO02 = CONO05 
	AND VNDR02 = SUPN05 
	AND SSEQ02 = DSEQ05  
Where
    ACRC02 &lt;&gt; 'C'  AND  DTLC02 = 9999999 AND
    ORDN02  in (Select ORDN03 from  AULT2F2PRD.PMP03 
	INNER JOIN   AULT2F2PRD.PMP09   ON
      	   CONO03 = CONO09 AND
      	   ORDN03 = ORDN09 AND
      	   LINE03 = LINE09 AND
     	   BOSN03 =  BRS#09 AND 
     	   INVN09=' ' AND 
                      INVT09 = ' '
         WHERE        CONO02 = CONO03 AND
	       ACRC03 &lt;&gt; 'C' AND   DLTF03 = ' ' 
	       AND DTLC03 = 9999999   AND
    ((STYP03 &lt;&gt; ' ' AND BOSN03 between 1 and 99998)
OR
   (STYP03 = ' ' AND  BOSN03 = 0)))
AND
( (CONO02 not in ('AB','G1','G7','SW','SP') )    
--( (CONO02 in ('27','78','76') )    
 and ordt02 &gt;=
(select CAST('1' concat right(year(current date- 24 months),2) concat right('0' concat month(current date - 24 months), 2)  
 concat right('0' concat day(current date - 24 months), 2)
  AS INT) AS Range from sysibm.sysdummy1 ))  



ORDER BY  CONO02, ORDN02</property>
