                <component
                  refId="Package\Customers\Load Customers\ADO NET Source"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
      
a.cono05,
       rtrim(LTRIM(a.cusn05)) AS cusn05,
       a.dseq05,
       LTRIM(RTRIM(cnam05)) AS cnam05,
       LTRIM(RTRIM(cad105)) AS cad105,
       LTRIM(RTRIM(cad205)) AS cad205,
       LTRIM(RTRIM(cad305)) AS cad305,
       LTRIM(RTRIM(cad405)) AS cad405,
       LTRIM(RTRIM(cad505)) AS cad505,
       pcd105,
       pcd205,
       CASE
           WHEN rsts05 = ' ' THEN
               1
           ELSE
               0
       END AS rsts05,
       MIN(b.MACN05) AS MACN05,
       MIN(b.MDSQ05) AS MDSQ05,
       CASE
           WHEN cocd05 = '' THEN
               CASE
                   WHEN d.SPFIPS = ''
                        AND SPSTNM NOT LIKE 'Armed%' THEN
                       'CANADA'
                   WHEN d.SPFIPS = '72' THEN
                       'PR'
                   WHEN d.SPFIPS &lt;&gt; '' THEN
                       'USA'
               END
           ELSE
               cocd05
       END AS cocd05,
       CASE
           WHEN cocd05 = ''
                OR cocd05 = 'USA' THEN
               c.zstate
           ELSE
               ''
       END AS zstate,
       CASE
           WHEN cocd05 = ''
                OR cocd05 = 'USA' THEN
               MIN(zcity)
           ELSE
               ''
       END AS zcity,
       a.FAXN05 AS fax_number,
       a.PHON05 AS phone_number,
       a.CURN05 AS currency_code,
       a.PTTP05 AS terms_type,
       a.PTPR05 AS terms_days,
       a.PTTD05 AS terms_range,
       COALESCE(pl.LIST20, '') AS price_list,
       COALESCE(pl.DGRP20, '') AS discount_group,
       TRIM(COALESCE(pl.car320, '')) AS delivery_method_code,
       COALESCE(e.prmd15, '') AS delivery_method,
       a.CRLM05 AS credit_limit,
       CASE LTRIM(RTRIM(a.CSTP05))
           WHEN '' THEN
               NULL
           ELSE
               CAST(LTRIM(RTRIM(a.CSTP05)) AS INTEGER)
       END AS credit_hold,
SUBSTR(a.TLXN05,1,2) As Collect_Type,
CAST(SUBSTR(a.TLXN05,4,3) AS CHAR(10)) As Collect_Code,
CASE
    WHEN DTPY06 = 0 THEN null
    WHEN DTPY06 &lt; 0940101 THEN null
    WHEN DTPY06 &gt; 1991231 THEN null
    ELSE DATE(TIMESTAMP_FORMAT(CAST(DTPY06 + 19000000 AS VARCHAR(20)), 'YYYY/MM/DD'))--DTPY06
END AS last_payment_date,
pl.regn20 AS sales_region,
pl.trty20 AS sales_territory,
pl.slmn20 AS salesperson,
CASE
    WHEN DTLS06 = 0 THEN null
    WHEN DTLS06 &lt; 0940101 THEN null

    WHEN DTLS06 &gt; 1991231 THEN null

    ELSE DATE(TIMESTAMP_FORMAT(CAST(DTLS06 + 19000000 AS VARCHAR(20)), 'YYYY/MM/DD'))--DTLS06
END AS last_transaction_date,
SUBSTR(TLXN05,7,2) As Credit_Score,
CASE
    WHEN a.ACDT05 = 0 THEN null
    WHEN a.ACDT05 &lt; 0940101 THEN null
    WHEN a.ACDT05 &gt; 1991231 THEN null
    ELSE DATE(TIMESTAMP_FORMAT(CAST(a.ACDT05 + 19000000 AS VARCHAR(20)), 'YYYY/MM/DD'))--DTPY06
END date_account_opened,
LEFT(CNTN1A, 20) contact
FROM ault1f2prd.slp05 a
    LEFT JOIN prdmodsf4.slp05x b
        ON a.cono05 = b.cono05
           AND a.cusn05 = b.cusn05
           AND a.dseq05 = b.dseq05
    LEFT JOIN zclib.zccity c
        ON a.pcd105 = c.zcode
    LEFT JOIN zclib.zcstsp d
        ON c.zstate = d.spstat
    LEFT JOIN  ( select distinct * from ault2f2prd.oep20) pl
        ON a.cono05 = pl.cono20
           AND a.cusn05 = pl.cusn20
           AND a.dseq05 = pl.dseq20
    LEFT JOIN ault2f2prd.inp15 e
        ON cono15 = cono20
           AND prmt15 = 'TDEL'
           AND psar15 = TRIM(pl.car320)
	LEFT JOIN (select * from AULT1F2PRD.SLP06 where DTST06 &lt;&gt; '0') AS SLP06 ON a.CONO05 = SLP06.CONO06 AND a.CUSN05 = SLP06.CUSN06
	LEFT JOIN AULT1F2PRD.T1P1A AS T1P1A ON a.CONO05 = T1P1A.GLCO1A AND a.CUSN05 = T1P1A.TPAC1A AND a.DSEQ05 = T1P1A.DSEQ1A AND T1P1A.APPL1A='SL' AND a.PYCT05=T1P1A.CTNU1A	
WHERE a.cusn05 &lt;&gt; ''  and a.CONO05 not in ('01','02','03','07','12','30','33','36','77')
GROUP BY a.cono05,
         a.cusn05,
         a.dseq05,
         cnam05,
         cad105,
         cad205,
         cad305,
         cad405,
         cad505,
         pcd105,
         pcd205,
         cocd05,
         rsts05,
         c.zstate,
         zfips,
         CASE
             WHEN cocd05 = '' THEN
                 CASE
                     WHEN d.SPFIPS = ''
                          AND SPSTNM NOT LIKE 'Armed%' THEN
                         'CANADA'
                     WHEN d.SPFIPS = '72' THEN
                         'PR'
                     WHEN d.SPFIPS &lt;&gt; '' THEN
                         'USA'
                 END
             ELSE
                 cocd05
         END,
         a.FAXN05,
         a.PHON05,
         a.CURN05,
         a.PTTP05,
         a.PTPR05,
         a.PTTD05,
         COALESCE(pl.LIST20, ''),
         COALESCE(pl.DGRP20, ''),
         TRIM(COALESCE(pl.car320, '')),
         COALESCE(e.prmd15, ''),
         a.CRLM05,
         CASE LTRIM(RTRIM(a.CSTP05))
             WHEN '' THEN
                 NULL
             ELSE
                 CAST(LTRIM(RTRIM(a.CSTP05)) AS INTEGER)
         END,
	SUBSTR(a.TLXN05,1,2),
	CAST(SUBSTR(a.TLXN05,4,3) AS CHAR(10)),
CASE
    WHEN DTPY06 = 0 THEN null
    WHEN DTPY06 &lt; 0940101 THEN null
    WHEN DTPY06 &gt; 1991231 THEN null
    ELSE DATE(TIMESTAMP_FORMAT(CAST(DTPY06 + 19000000 AS VARCHAR(20)), 'YYYY/MM/DD'))--DTPY06
END,
pl.regn20,
pl.trty20,
pl.slmn20,
CASE
    WHEN DTLS06 = 0 THEN null
    WHEN DTLS06 &lt; 0940101 THEN null

    WHEN DTLS06 &gt; 1991231 THEN null

    ELSE DATE(TIMESTAMP_FORMAT(CAST(DTLS06 + 19000000 AS VARCHAR(20)), 'YYYY/MM/DD'))--DTLS06
END,
SUBSTR(TLXN05,7,2),
CASE
    WHEN a.ACDT05 = 0 THEN null
    WHEN a.ACDT05 &lt; 0940101 THEN null
    WHEN a.ACDT05 &gt; 1991231 THEN null
    ELSE DATE(TIMESTAMP_FORMAT(CAST(a.ACDT05 + 19000000 AS VARCHAR(20)), 'YYYY/MM/DD'))--DTPY06
END,
LEFT(CNTN1A, 20)</property>
