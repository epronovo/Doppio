      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Items\Execute SQL Task Create Temp Table tmp_item"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{a1e766e3-e610-47b3-a6b1-d93963a19ccc}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute SQL Task Create Temp Table tmp_item"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1559B06A-4BED-4A4A-A375-2BB4F3DDEE08}"
              SQLTask:TimeOut="1800"
              SQLTask:SqlStatementSource="IF OBJECT_ID('tempdb..##tmp_item') IS NOT NULL&#xA;    DROP TABLE ##tmp_item&#xA;&#xA;select * into ##tmp_item from item where system_id = -1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Items\Execute SQL Task Merge tmp_item into item"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{52470c54-dd50-4de1-a259-1f75666a2cdf}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute SQL Task Merge tmp_item into item"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1559B06A-4BED-4A4A-A375-2BB4F3DDEE08}"
              SQLTask:TimeOut="1800"
              SQLTask:SqlStatementSource="merge item as [target]&#xA;using ##tmp_item as [source]&#xA;on source.system_id=target.system_id &#xA;&#x9;and source.system_entity_id=target.system_entity_id&#xA;&#x9;and source.item_num=target.item_num&#x9;&#x9;&#xA;when matched then update &#xA;set target.item_desc=source.item_desc&#xA;,target.item_type=source.item_type&#xA;,target.active_flag=source.active_flag&#xA;,target.attrib_text_1=source.attrib_text_1&#xA;,target.attrib_text_2=source.attrib_text_2&#xA;,target.attrib_text_3=source.attrib_text_3&#xA;,target.attrib_num_1=source.attrib_num_1&#xA;,target.attrib_num_2=source.attrib_num_2&#xA;,target.revrec_leadtime=source.revrec_leadtime&#xA;,target.export_control_flag=source.export_control_flag&#xA;,target.product_code_1=source.product_code_1&#xA;,target.product_code_2=source.product_code_2&#xA;,target.product_code_3=source.product_code_3&#xA;,target.costing_method=source.costing_method&#xA;,target.prod_num_1=source.prod_num_1&#xA;,target.prod_num_2=source.prod_num_2&#xA;,target.cost_standard=source.cost_standard&#xA;,target.cost_average=source.cost_average&#xA;,target.cost_material=source.cost_material&#xA;,target.cost_labor=source.cost_labor&#xA;,target.cost_fixed_ovh=source.cost_fixed_ovh&#xA;,target.cost_variable_ovh=source.cost_variable_ovh&#xA;,target.cost_outside=source.cost_outside&#xA;,target.update_dt=getdate()&#xA;,target.innovation_date=source.innovation_date&#xA;,target.drawing_number_c=source.drawing_number_c&#xA;,target.gross_weight_c=source.gross_weight_c&#xA;,target.item_group_c=source.item_group_c&#xA;,target.item_type_c=source.item_type_c&#xA;,target.item_variant=source.item_variant&#xA;,target.attrib_num_3=source.attrib_num_3&#xA;,target.material_type=source.material_type&#xA;,target.uom_base=source.uom_base&#xA;,target.net_weight=source.net_weight&#xA;when not matched by target then&#xA;insert &#xA;(&#xA;&#x9;system_id&#xA;&#x9;,system_entity_id&#xA;&#x9;,item_num&#xA;&#x9;,item_desc&#xA;&#x9;,item_type&#xA;&#x9;,active_flag&#xA;&#x9;,attrib_text_1&#xA;&#x9;,attrib_text_2&#xA;&#x9;,attrib_text_3&#xA;&#x9;,attrib_num_1&#xA;&#x9;,attrib_num_2&#xA;&#x9;,revrec_leadtime&#xA;&#x9;,export_control_flag&#xA;&#x9;,product_code_1&#xA;&#x9;,product_code_2&#xA;&#x9;,product_code_3&#xA;&#x9;,costing_method&#xA;&#x9;,prod_num_1&#xA;&#x9;,prod_num_2&#xA;&#x9;,cost_standard&#xA;&#x9;,cost_average&#xA;&#x9;,cost_material&#xA;&#x9;,cost_labor&#xA;&#x9;,cost_fixed_ovh&#xA;&#x9;,cost_variable_ovh&#xA;&#x9;,cost_outside&#x9;&#x9;&#x9;&#xA;&#x9;,innovation_date&#xA;&#x9;,drawing_number_c&#xA;&#x9;,gross_weight_c&#xA;&#x9;,item_group_c&#xA;&#x9;,item_type_c&#xA;&#x9;,item_variant&#xA;&#x9;,attrib_num_3&#xA;&#x9;,material_type&#xA;&#x9;,uom_base&#xA;&#x9;,net_weight&#xA;&#xA;)&#xA;values&#xA;(&#xA;&#x9;source.system_id&#xA;&#x9;,source.system_entity_id&#xA;&#x9;,source.item_num&#xA;&#x9;,source.item_desc&#xA;&#x9;,source.item_type&#xA;&#x9;,source.active_flag&#xA;&#x9;,source.attrib_text_1&#xA;&#x9;,source.attrib_text_2&#xA;&#x9;,source.attrib_text_3&#xA;&#x9;,source.attrib_num_1&#xA;&#x9;,source.attrib_num_2&#xA;&#x9;,source.revrec_leadtime&#xA;&#x9;,source.export_control_flag&#xA;&#x9;,source.product_code_1&#xA;&#x9;,source.product_code_2&#xA;&#x9;,source.product_code_3&#xA;&#x9;,source.costing_method&#xA;&#x9;,source.prod_num_1&#xA;&#x9;,source.prod_num_2&#xA;&#x9;,source.cost_standard&#xA;&#x9;,source.cost_average&#xA;&#x9;,source.cost_material&#xA;&#x9;,source.cost_labor&#xA;&#x9;,source.cost_fixed_ovh&#xA;&#x9;,source.cost_variable_ovh&#xA;&#x9;,source.cost_outside&#x9;&#x9;&#x9;&#xA;&#x9;,source.innovation_date&#xA;&#x9;,source.drawing_number_c&#xA;&#x9;,source.gross_weight_c&#xA;&#x9;,source.item_group_c&#xA;&#x9;,source.item_type_c&#xA;&#x9;,source.item_variant&#xA;&#x9;,source.attrib_num_3&#xA;&#x9;,source.material_type&#xA;&#x9;,source.uom_base&#xA;&#x9;,source.net_weight&#xA;&#xA;);&#xA;&#xA;drop table ##tmp_item;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
