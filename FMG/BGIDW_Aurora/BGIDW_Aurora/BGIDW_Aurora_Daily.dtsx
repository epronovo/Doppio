                <component
                  refId="Package\Invoice Header\Load invoice headers\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
 1 as system_id,
 oep65.cono65,
 oep65.invn65,
 0 as invs65,
 cusn65,
 CASE WHEN TRIM(dseq65)='' THEN CUSQ65 ELSE DSEQ65 END AS DSEQ65,
 cusi65,
 cusq65,
 curc65,
 curt65,
 case when dtin65 = 0 then '' else SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 4, 2)  CONCAT '/' CONCAT
  SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
  SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 2, 2)  
 end as dtin65,
 biit65,
 curn65,
 case when type65 = 'IN' then 'I'
   when type65 = 'DR' then 'D'
   when type65 = 'CR' then 'C'
   else 'X'
 end as type65,
 case when dtin65 = 0 then '' else SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 4, 2)  CONCAT '/' CONCAT
  SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
  SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 2, 2)  
 end as shdt65,   /* ship date */
 0 as sseq65,  /* ship seq */
 stat65,
 pttd65,
 CASE WHEN HEX(ordn65)='FFFFFFFFFFFFFF' THEN '' ELSE ORDN65 END as ORDN65,
 cuso65,
 CASE WHEN LEFT(CAST(pern65 AS VARCHAR(5)), 1) = '1' THEN
      '20' CONCAT RIGHT(CAST(pern65 as varchar(5)), 4)
 ELSE
      '19' CONCAT RIGHT(CAST(pern65 as varchar(5)), 4)
 END AS pern,
 case when PBAL15 = 0.00 then 'X' else 'O' end inv_status

from ault2f2prd.oep65 oep65
left outer join (select CONO15, lref15, cusn15, SUM(PBAL15) AS PBAL15
FROM AULT1F2PRD.SLP15
GROUP BY CONO15, lref15, cusn15) as slp15 on slp15.CONO15=oep65.CONO65 and slp15.LREF15=oep65.INVN65 and slp15.cusn15=oep65.cusn65


where --oep65.cono65 IN  (SELECT CONO FROM ASGHDCA.DWCOMPANY) and
(dtin65 &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 15 days, 'YYMMDD') FROM sysibm.sysdummy1) AS INT)
OR dtlc65 &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 15 days, 'YYMMDD') FROM sysibm.sysdummy1) AS INT))</property>
