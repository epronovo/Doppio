                <component
                  refId="Package\Item List Price Current And Upcoming\Populate Temp tmp_item_list_price\Get list price"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Get list price"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select Distinct
    '1' system_id
    ,a.CONO16 system_entity_id
    ,UPPER(LTRIM(RTRIM(a.PNUM16))) item_num
    ,a.PRTP16 price_disc_list
    ,a.CURN16 currency_code
    ,DATE(TIMESTAMP_FORMAT(CAST(a.SDAT16 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) as effective_start    
    ,a.QL0116 qty_break_01
    ,a.QL0216 qty_break_02
    ,a.QL0316 qty_break_03
    ,a.QL0416 qty_break_04
    ,a.QL0516 qty_break_05
    ,a.QL0616 qty_break_06
    ,a.QL0716 qty_break_07
    ,a.QL0816 qty_break_08
    ,a.QL0916 qty_break_09
    ,a.QL1016 qty_break_10
    ,a.VRT116 price_01
    ,a.VRT216 price_02
    ,a.VRT316 price_03
    ,a.VRT416 price_04
    ,a.VRT516 price_05
    ,a.VRT616 price_06
    ,a.VRT716 price_07
    ,a.VRT816 price_08
    ,a.VRT916 price_09
    ,a.VRT016 price_10
    ,maxa.audit_dt update_dt
from AULT2F2PRD.oep16 a
inner join
(
    select
        CONO16
        ,UPPER(LTRIM(RTRIM(PNUM16))) AS PNUM16
        ,PRTP16
        ,CURN16
        ,max(SDAT16) as SDAT16
    from AULT2F2PRD.oep16
    where DATE(TIMESTAMP_FORMAT(CAST(SDAT16 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) &lt;= CURRENT_DATE
    	and cono16  in ('35','55','94')
    group by CONO16
        ,UPPER(LTRIM(RTRIM(PNUM16)))
        ,PRTP16
        ,CURN16
) b ON b.CONO16=a.CONO16
    AND UPPER(LTRIM(RTRIM(b.PNUM16)))=UPPER(LTRIM(RTRIM(a.PNUM16)))
    AND b.PRTP16=a.PRTP16
    AND b.CURN16=a.CURN16
    AND b.SDAT16=a.SDAT16
LEFT OUTER JOIN
(
    select 
        CONO16
        ,UPPER(LTRIM(RTRIM(PNUM16))) AS PNUM16
        ,PRTP16
        ,CURN16
        ,MAX(DATE(TIMESTAMP_FORMAT(CAST(adat16 + 19000000 AS VARCHAR(20)), 'YYYYMMDD'))) audit_dt
    from AULT2F2PRD.oep16a
    where cono16  in ('35','55','94')
    group by CONO16
        ,UPPER(LTRIM(RTRIM(PNUM16)))
        ,PRTP16
        ,CURN16
)maxa on maxa.cono16=a.cono16
    AND UPPER(LTRIM(RTRIM(maxa.pnum16)))=UPPER(LTRIM(RTRIM(a.pnum16)))
    AND maxa.PRTP16=a.PRTP16
    AND maxa.CURN16=a.CURN16
where a.cono16  in ('35','55','94')
	and maxa.audit_dt &gt;= (CURRENT_DATE - 7 DAYS)
AND Not (a.VRT116= 0 and a.VRT216 = 0 and a.VRT316 = 0 and a.VRT416 = 0 and a.VRT516 = 0 and a.VRT616 = 0 and a.VRT716= 0 and a.VRT816 = 0 and a.VRT916 = 0 and a.VRT016 = 0)


UNION


select 
	'1' system_id
	,a.CONO16 system_entity_id
	,a.PNUM16 item_num
	,a.PRTP16 price_disc_list
	,a.CURN16 currency_code
	,DATE(TIMESTAMP_FORMAT(CAST(a.SDAT16 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) as effective_start	
	,a.QL0116 qty_break_01
	,a.QL0216 qty_break_02
	,a.QL0316 qty_break_03
	,a.QL0416 qty_break_04
	,a.QL0516 qty_break_05
	,a.QL0616 qty_break_06
	,a.QL0716 qty_break_07
	,a.QL0816 qty_break_08
	,a.QL0916 qty_break_09
	,a.QL1016 qty_break_10
	,a.VRT116 price_01
	,a.VRT216 price_02
	,a.VRT316 price_03
	,a.VRT416 price_04
	,a.VRT516 price_05
	,a.VRT616 price_06
	,a.VRT716 price_07
	,a.VRT816 price_08
	,a.VRT916 price_09
	,a.VRT016 price_10
	,DATE(TIMESTAMP_FORMAT(CAST(maxa.audit_dt+ 19000000 AS VARCHAR(20)), 'YYYYMMDD')) update_dt
from AULT2F2PRD.oep16 a
inner join
(
	select
		CONO16
		,PNUM16
		,PRTP16
		,CURN16
		,max(SDAT16) as SDAT16
	from AULT2F2PRD.oep16
	where DATE(TIMESTAMP_FORMAT(CAST(SDAT16 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) &gt; CURRENT_DATE
	group by CONO16
		,PNUM16
		,PRTP16
		,CURN16
) b ON b.CONO16=a.CONO16
	AND b.PNUM16=a.PNUM16
	AND b.PRTP16=a.PRTP16
	AND b.CURN16=a.CURN16
	AND b.SDAT16=a.SDAT16
LEFT OUTER JOIN
(
	select 
		CONO16
		,PNUM16
		,PRTP16
		,CURN16
		,MAX(adat16) audit_dt
	from AULT2F2PRD.oep16a
	group by CONO16
		,PNUM16
		,PRTP16
		,CURN16
)maxa on maxa.cono16=a.cono16
	AND maxa.pnum16=a.pnum16
	AND maxa.PRTP16=a.PRTP16
	AND maxa.CURN16=a.CURN16
