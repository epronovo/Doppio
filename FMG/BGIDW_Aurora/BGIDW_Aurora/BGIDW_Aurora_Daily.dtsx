                <component
                  refId="Package\PO Receipts\po_line_receipt\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
1 as system_id,
cono09 as system_entity_id,
ordn09 as po_num,
LINE09 as po_line,
BRS#09 as po_seq,
ACRC09 as status,
ORDC02 as po_class,
'' as po_line_desc,
DATE(TIMESTAMP_FORMAT(CAST( b.ORDT02 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) as po_date,
DATE(TIMESTAMP_FORMAT(CAST( a.DUED09 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) as due_date,
DATE(TIMESTAMP_FORMAT(CAST( a.RECD09 + 19000000 AS VARCHAR(20)), 'YYYYMMDD')) as date_received,
vndr09 as vendor_num,
b.SSEQ02 as vendor_seq,
CAST(CASE WHEN ITEM09 &lt;&gt; '' THEN ITEM09 ELSE VCAT09 END AS NVARCHAR(35)) AS item_num_internal,
CAST(VCAT09 AS NVARCHAR(35)) as item_num_vendor,
OQTY09 as qty_ordered,
TQTY09 as qty_received,
CURN09 as currency_code,
PRIC09 as unit_price,
OUOM09 as unit_of_measure_order,
IUOM09 as unit_of_measure_stock,
RUOM09 as unit_of_measure_purchase,
PRIC09 * TQTY09 as extended_price,
PRIC09 * CRTR09 as unit_price_base,
PRIC09 * CRTR09 * TQTY09 as extended_price_base,
CRTR09 as conversion_rate_base
FROM AULT2F2PRD.PMP09 a
LEFT JOIN AULT2F2PRD.PMP02 b ON a.CONO09=b.CONO02 and a.ORDN09=b.ORDN02 and b.dtlc02 = 9999999
WHERE  b.ORDT02 &gt;= 1130101 AND ACRC09 &lt;&gt; 'C'</property>
