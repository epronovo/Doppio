                <component
                  refId="Package\PO Lines\po_line\ERP Open PO Lines - PLP03 and PLP02"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="ERP Open PO Lines - PLP03 and PLP02"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">Select
	1 as system_id,
	cast(CONO03 as nvarchar(10)) as system_entity_id,
	cast(ORDN03 as nvarchar(20)) as po_num,
	cast(Right('00' CONCAT CAST(LINE03 AS VARCHAR(3)),3) as nvarchar(15)) as po_line,
	cast(Right('0000' CONCAT  CAST(BOSN03 AS VARCHAR(5)),5) as nvarchar(15)) as po_seq,
	cast(VNDR03 as nvarchar(30)) as vendor_num,
	cast(SSEQ02 as nvarchar(15)) as vendor_seq,
	cast(OQTY03 as decimal(18,5)) as qty_ordered,
	cast(QTOS03 as decimal(18,5)) as qty_outstanding,
	cast(QREC03 as decimal(18,5)) as qty_received,
	cast(OUOM03 as nvarchar(10)) as unit_of_measure_order,
	cast(PUOM03 as nvarchar(10)) as unit_of_measure_purchase,
	cast(SUOM03 as nvarchar(10)) as unit_of_measure_stock,
	cast(ACRC03 as nvarchar(10)) as status,
	cast(ORDC02 as nvarchar(15)) as po_class,
	cast((CAST(((CAST(SUBSTR(Right('0' concat CAST(DUED03 AS VARCHAR(7)),7), 1, 1) AS NUMERIC(4,0)) - 1) + 20) 
			   AS VARCHAR(2)) CONCAT 
	SUBSTR(Right('0' concat CAST(DUED03 AS VARCHAR(7)),7), 2, 2)  CONCAT 
	'-' CONCAT
	SUBSTR(Right('0' concat CAST(DUED03 AS VARCHAR(7)),7), 4, 2)  CONCAT 
	'-' CONCAT
	SUBSTR(Right('0' concat CAST(DUED03 AS VARCHAR(7)),7), 6, 2)) as date) as due_date,     
	cast((CAST(((CAST(SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 1, 1) AS NUMERIC(4,0)) - 1) + 20) 
	   AS VARCHAR(2)) CONCAT 
	SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 2, 2) CONCAT
	'-' CONCAT
	SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 4, 2)  CONCAT 
	'-' CONCAT
	SUBSTR(Right('0' concat CAST(ORDT02 AS VARCHAR(7)),7), 6, 2)) as date) as po_date,
	cast(NOMM03 as nvarchar(15)) as ledger_code,
	CAST(PRIC03 AS DECIMAL(18,5))  as unit_price,
	Cast((QTOS03 * PRIC03) AS DECIMAL(18,5)) AS extended_price,
	cast(Case when CURC02 = 'CAN' then 'CAD'
		 when CURC02 = 'PES' then 'MXN'
		 when CURC02 = 'RMB' then 'CNX'
	else 
		CURC02 
	end as nvarchar(4))as currency_code,
	cast(ITEM03 as nvarchar(80)) as item_num_internal,
	cast(Case when ORDC02 &lt; 5 then 
		ITEM03
	else 
		VCAT03
	end as nvarchar(80))as item_num_vendor,
	cast(Case 
		when ORDC02 = 1 then
			(Select coalesce (PDES35, ' ' ) from AULT2F2PRD.INP35 where  CONO02 = CONO35 and ITEM03 = PNUM35)
		when ORDC02 = 7 then
			(Select coalesce (PDES35, ' ' ) from AULT2F2PRD.INP35 where  CONO02 = CONO35 and VCAT03 = PNUM35)
		WHEN ORDC02 = 5 or ORDC02 = 6 then
			(Select coalesce (TLIN11, '' ) from AULT2F2PRD.PMP11 where CONO11 = CONO02 and VNDR11 = VNDR02 and XTYP11  = 'L' and USGE11  = 'O' and XREF11 = (ORDN03 CONCAT '          ' CONCAT RIGHT('000' CONCAT CAST(LINE03 AS VARCHAR(5)), 3) ) and TLNO11 = 1)
	end as nvarchar(512)) as po_line_desc
From  AULT2F2PRD.PMP02 
	INNER JOIN AULT2F2PRD.PMP03 ON CONO02 = CONO03 
		AND ORDN02 = ORDN03 
		AND ACRC03 &lt;&gt; 'C'  
		AND  DLTF03 = ' ' 
		AND DTLC03 = 9999999 
		AND PRIC03 &lt;&gt; 0.0
LEFT JOIN AULT2F2PRD.INP35 ON CONO03 = CONO35 
	AND ITEM03 = PNUM35
Where ACRC02 &lt;&gt; 'C'  AND  DTLC02 = 9999999 
	AND((STYP03 &lt;&gt; ' ' AND BOSN03 between 1 and 99998) OR (STYP03 = ' ' AND  BOSN03 = 0))
	AND ((CONO02 not in ('AB','G1','G7','SW','SP') )
	--AND ((CONO02 in ('27','78','76') )
	AND ordt02 &gt;= (select CAST('1' concat right(year(current date- 24 months),2) concat right('0' concat month(current date - 24 months), 2) concat right('0' concat day(current date - 24 months), 2) AS INT) AS Range from sysibm.sysdummy1 ))
	AND (Select  COUNT(*) from AULT2F2PRD.PMP09  WHERE CONO03 = CONO09 AND ORDN03 = ORDN09 AND LINE03 = LINE09 AND BOSN03 =  BRS#09 AND INVN09 = ' ' AND INVT09= ' ' ) &gt; 0
ORDER BY  CONO03, ORDN03, LINE03, BOSN03</property>
