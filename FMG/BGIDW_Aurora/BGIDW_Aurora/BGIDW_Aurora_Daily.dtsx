                <component
                  refId="Package\Populate AR Mast\Load AR Mast\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT  
DISTINCT 
1  AS system_id,
cast(LTRIM(RTRIM(CONO15)) as nvarchar(10)) system_entity_id,
cast(LTRIM(RTRIM(LREF15)) as nvarchar(20)) invoice_no,
cast(CASE
   WHEN ETYP15 = 'IN' THEN 'I' 
   WHEN ETYP15 = 'CR' THEN 'C'   
   WHEN ETYP15 = 'UC' AND PTMT15 &gt;= 0 THEN 'D'
   WHEN ETYP15 = 'UC' AND PTMT15 &lt; 0 THEN 'U'  
   WHEN ETYP15 = 'DN' THEN 'D'  
   WHEN ETYP15 = 'OP' THEN 'U' 
   WHEN ETYP15 = 'CA' THEN 'A'
   WHEN ETYP15 = 'JL' AND PTMT15 &gt;= 0 THEN 'D'
    When ETYP15 = 'JL' and PTMT15 &lt; 0 THEN 'U'
   ELSE ''
END AS nvarchar(10)) invoice_type,       
cast(LTRIM(RTRIM(CUSN15)) as nvarchar(30)) cust_num,
cast('000' as nvarchar(30)) cust_seq,
cast(LTRIM(RTRIM(CUSN65)) as nvarchar(30)) cust_ship_num,
cast(LTRIM(RTRIM(DSEQ65)) as nvarchar(15)) cust_ship_seq,
cast(LTRIM(RTRIM(SOPN15)) as nvarchar(15)) co_num,
cast(PTMT15 as decimal(21,8)) invoice_amount,
cast(BTMT15 as decimal(21,8)) invoice_amount_base,
cast(0.00 as decimal(21,8)) freight_amount,
cast(INVC65 as decimal(21,8)) misc_charges,
cast(PVAT15 as decimal(21,8)) sales_tax,
case when PBAL15 = 0.00 then 'X' else 'O' end invoice_status,
cast(substring(cast(DOCD15 as varchar(7)),4,2) concat '/' concat
       substring(cast(DOCD15 as varchar(7)),6,2) concat  '/' concat
       substring(cast(DOCD15 as varchar(7)),2,2) as varchar(8)) invoice_date,
cast(CURN15 as nvarchar(5)) currency_code,
--CURC15 exchange_rate,
cast ( case when coalesce(PTMT15,0)&lt;&gt;0 then BTMT15/PTMT15 end as decimal(21,8)) exchange_rate,
cast(PTMT15 as decimal(21,8)) invoice_total,
cast(BTMT15 as decimal(21,8)) invoice_total_base,
cast(PTMT15-PBAL15 as decimal(23,8)) total_payments,
cast(BTMT15-BBAL15 as decimal(23,8)) total_payments_base,
cast(PTTD05 as int) net_days,
cast(LTRIM(RTRIM(CUSO65)) as nvarchar(25)) purchase_order_no,
cast(LTRIM(RTRIM(SOPN15)) as nvarchar(30)) packing_slip,
CAST(LTRIM(RTRIM(T03.BOLN65)) AS nvarchar(35)) bol,
cast(	   
case when CLRD15 = 0 then 
	null 
else 	   
(CAST(((CAST(SUBSTR(Right('0' concat CAST(CLRD15 AS VARCHAR(7)),7), 1, 1) AS NUMERIC(4,0)) - 1) + 20) 
	   AS VARCHAR(2)) CONCAT 
	SUBSTR(Right('0' concat CAST(CLRD15 AS VARCHAR(7)),7), 2, 2) CONCAT
	'-' CONCAT
	SUBSTR(Right('0' concat CAST(CLRD15 AS VARCHAR(7)),7), 4, 2)  CONCAT 
	'-' CONCAT
	SUBSTR(Right('0' concat CAST(CLRD15 AS VARCHAR(7)),7), 6, 2)) end as date) clear_date,
cast(case when PDUE15 = 0 then 
	null 
else
substring(cast(PDUE15 as varchar(7)),4,2) concat '/' concat
       substring(cast(PDUE15 as varchar(7)),6,2) concat  '/' concat
       substring(cast(PDUE15 as varchar(7)),2,2) end as varchar(8)) due_date
FROM AULT1F2PRD.SLP15 as T01
Left outer join AULT1F2PRD.CSP20 as CSP on CSP.CONO20 = T01.CONO15 
	and CSP.CBRF20 = T01.LREF15
LEFT JOIN AULT2F2PRD.OEP65 as T02 ON CONO15 = T02.CONO65 
	AND LREF15 = T02.INVN65
LEFT JOIN PRDMODSF4.OEP65X AS T03 ON CONO15 = T03.CONO65 
	AND LREF15 = T03.INVN65   
LEFT JOIN AULT1F2PRD.SLP05 as T04 ON CONO15 = T04.CONO05 
	AND CUSN15 = T04.CUSN05 
	AND T04.DSEQ05 = '000'
INNER JOIN AULT1F2PRD.SLP20 AS T05 ON CONO15 = T05.CONO20 
	AND CUSN15 = T05.CUSN20 
	AND ETYP15 = T05.ETYP20 
	AND LREF15 = T05.LREF20 
LEFT JOIN AULT1F2PRD.SLP30 AS T06 ON CONO15 =  T06.CONO30 
	AND CUSN15 = T06.CUSN30 
	AND ETYP15 = SUBSTR(T06.XREF30, 1, 2) 
	AND LREF15 = SUBSTR(T06.XREF30, 3, 8)
WHERE T01.CONO15 IN (SELECT CONO FROM ASGHDCA.GPCOMPANY WHERE SERVER='AUR' AND GPCOMP in ('2','3')) and
 ((BBAL15 &lt;&gt; 0) or (T01.docd15 &gt;=
(select CAST('1' concat right(year(current date - 60 months),2) concat right('0' concat month(current date - 60 months), 2)  
 concat right('0' concat day(current date - 60 months), 2)
  AS INT) AS Range from sysibm.sysdummy1 )))</property>
                    <property
