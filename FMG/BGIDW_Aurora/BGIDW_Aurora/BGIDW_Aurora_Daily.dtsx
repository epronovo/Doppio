                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT a.CONO, a.ACCN03, a.ATYP03, a.ACDESC, a.LEDNO, b.BPC103 , a.lvcd01, a.lvcd02, a.lvcd03, a.lvcd04, TRIM(c.CONACC) AS CTRL_ACCT, a.dcur03 FROM AULT1F2PRD.FLP003 as a
LEFT JOIN (SELECT DISTINCT CONO, ACCN03, MAX(CASE WHEN RTRIM(COALESCE(BPC103, ''))='' THEN 0 ELSE 1 END) AS BPC103 FROM PRDMODSF4.FLP003E GROUP BY CONO, ACCN03) as b
ON a.CONO=b.CONO AND a.accn03=b.accn03
LEFT JOIN AULT1F2PRD.FLP002 AS c on a.CONO=c.CONO AND a.LEDNO=c.LEDNO 
WHERE a.CONO IN (SELECT CONO FROM ASGHDCA.DWCOMPANY)</property>
