                <component
                  refId="Package\Items\Populate Temp Table tmp_item\OLE DB Source JBA OLEDB"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source JBA OLEDB"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT DISTINCT
1 as system_id,
CONO35 as system_entity_id,
RTRIM(PNUM35) as item_num,
RTRIM(PDES35) as item_desc,
PTYP35 as item_type,
ACTF35 as active_flag,
PPUN35 as attrib_text_1,
SPC135 as attrib_num_1,
SPC235 as attrib_num_2,
SPC335 as attrib_num_3,
PGMJ35 as product_code_1,
PGMN35 as product_code_2,
DISG35 as product_code_3,
CSTM35 as costing_method,
SCSU35 as cost_standard,
ACSU35 as cost_average,
WTSU35 as gross_weight_c,
b.EDNO04 as drawing_number_c,
c.PRMD15 as Item_Group_c,
d.PRMD15 as Item_Type_c

FROM AULT2F2PRD.INP35 a
LEFT JOIN	AULT3F2PRD.MSP04 b  ON b.CONO04 = a.CONO35 AND b.ITEM04 = a.PNUM35
LEFT JOIN	AULT2F2PRD.INP15 c ON a.CONO35 = c.CONO15 AND a.PGMN35 = c.PSAR15 AND c.PRMT15 = 'PGMN'
LEFT JOIN	AULT2F2PRD.INP15 d ON a.CONO35 = d.CONO15 AND a.PTYP35 = d.PSAR15 AND d.PRMT15 = 'PTYP'</property>
                    <property
