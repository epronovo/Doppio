          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1559B06A-4BED-4A4A-A375-2BB4F3DDEE08}"
              SQLTask:TimeOut="1800"
              SQLTask:SqlStatementSource="IF OBJECT_ID('tempdb..##tmp_item_list_price') IS NOT NULL&#xA;    &#xA;DROP TABLE ##tmp_item_list_price&#xA;&#xA;select * into ##tmp_item_list_price from item_list_price where system_id = -1&#xA;&#xA;delete from ##tmp_item_list_price" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Item List Price Current And Upcoming\Execute SQL Task Merge tmp_item into item"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{9af822f4-a90a-4121-a98a-5f3a7560d10f}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute SQL Task Merge tmp_item into item"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1559B06A-4BED-4A4A-A375-2BB4F3DDEE08}"
