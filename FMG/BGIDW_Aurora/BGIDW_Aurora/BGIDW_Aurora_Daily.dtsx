                <component
                  refId="Package\BI Ar_cash\Load AR Cash\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">1800</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
1 AS system_id,
LTRIM(RTRIM(slp15.CONO15)) as system_entity_id,
LTRIM(RTRIM(slp15.CUSN15)) AS cust_num,
'000' cust_seq,
cast(substring(cast(slp202.DOCD20 as varchar(7)),4,2) concat '/' concat
       substring(cast(slp202.DOCD20 as varchar(7)),6,2) concat  '/' concat
       substring(cast(slp201.DOCD20 as varchar(7)),2,2) as varchar(8))
       as ar_chk_dat,
LTRIM(RTRIM(SLP202.LREF20)) as ar_chk_no, 
LTRIM(RTRIM(SLP202.PTMT20)) as chk_amount,
LTRIM(RTRIM(SLP202.PTMT20)) as chk_appld,
LTRIM(RTRIM(slp201.lref20)) as ar_ivc_no,
case when slp201.etyp20 = 'IN' then 'C'
else 'A'
end as type,
LTRIM(RTRIM(curn15)) as currency, 
LTRIM(RTRIM(slp201.sesn20)) as batch_no,
case when slp201.etyp20 = 'DC' then '5'
     when slp201.etyp20 = 'IN' then '0'
     when slp201.etyp20 = 'AJ' then '2'
     when slp201.etyp20 = 'FC' then '0'
     when slp201.etyp20 = 'CA' then '4' 
     when slp201.etyp20 = 'UP' then '1'
     when slp201.etyp20 = 'OP' then '2'
     when slp201.etyp20 = 'JT' then '9'
     when slp201.etyp20 = 'DN' then '3'
else '14'
end as Operation
from ault1f2prd.slp15 slp15
inner join ault1f2prd.slp20 slp202 on slp202.lref20 = slp15.lref15 and slp202.cono20 = slp15.cono15
    and slp202.etyp20 = 'UC' and slp202.ttyp20 = 'AL'

inner join ault1f2prd.slp20 slp201 on slp201.evnt20 = slp202.evnt20 and slp201.cono20 = slp202.cono20
    and ((slp201.etyp20 not in ('DC', 'UC') and slp201.ttyp20 = 'AL') or (slp201.etyp20 = 'DC' and slp201.ttyp20 = 'DC'))

where cono15 in (SELECT CONO FROM ASGHDCA.GPCOMPANY WHERE SERVER='AUR' AND GPCOMP in ('2','3'))
  and etyp15 ='UC' and docd15 &gt; 
(select CAST('1' concat right(year(current date - 12 months),2) concat right('0' concat month(current date - 12 months), 2)  
 concat right('0' concat day(current date - 12 months), 2)
  AS INT) AS Range from sysibm.sysdummy1 )</property>
