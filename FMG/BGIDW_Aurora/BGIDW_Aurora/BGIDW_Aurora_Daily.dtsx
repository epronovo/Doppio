    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{7FCE76A6-B716-42E1-998E-C539E06B95E9}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT a.*, DATE(TIMESTAMP_FORMAT(CAST(\&quot;Date WO Costed (Closed)\&quot; + 19000000 AS VARCHAR(20)), 'YYYYMMDD'))  as job_close_date FROM PRDMODSF4.MFGCOSTADJ a WHERE \&quot;Date WO Costed (Closed)\&quot; &gt; &quot; + (DT_WSTR, 30) @[User::last_job_cost_date]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="sql_job_cost">
      <DTS:VariableValue
        DTS:DataType="8">SELECT a.*, DATE(TIMESTAMP_FORMAT(CAST("Date WO Costed (Closed)" + 19000000 AS VARCHAR(20)), 'YYYYMMDD'))  as job_close_date FROM PRDMODSF4.MFGCOSTADJ a WHERE "Date WO Costed (Closed)" &gt; 0</DTS:VariableValue>
    </DTS:Variable>
