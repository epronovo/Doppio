        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnPostExecute]\SSISOpsEhObj_7B0BA4FAD19048F7B771F9CC2D45149A_1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="SSISOps : DON'T CHANGE PREFIX. Row Count Logging For [Load invoice detail=&gt;Inv Lines from Aurora]"
          DTS:DTSID="{1DBB1D27-9D46-4D07-B7FA-40AAB9113949}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SSISOpsEhObj_7B0BA4FAD19048F7B771F9CC2D45149A_1"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:TransactionOption="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1AEF01EA-9187-46EE-9E36-4113E684FAD6}"
              SQLTask:SqlStatementSource="[bix].[usp_SSISOps_Audit_Insert_RowCount_67] @ComponentUniqueID='{7B0BA4FA-D190-48F7-B771-F9CC2D45149A}_66',@ComponentTypeCode='SRC',@ComponentTypeName='OLEDB',@ComponentName='Inv Lines from Aurora',@DataObjectType='SqlCommand',@DataObjectName='',@DataObjectQuery='select &#xA;&#x9;1 as system_id,&#xA;&#x9;cono70 as entity_id,&#xA;&#x9;invn70 as inv_num ,&#xA;&#x9;CAST(desn70 as nvarchar(6)) as inv_seq,&#xA;&#x9;ordl70 as inv_line, &#xA; &#x9;case when dtin65 = 0 then null else &#xA;&#x9;&#x9;SUBSTR(Right(''0'' concat CAST(dtin65 AS VARCHAR(7)),7), 4, 2) CONCAT ''/'' CONCAT&#xA;               &#x9;&#x9;SUBSTR(Right(''0'' concat CAST(dtin65 AS VARCHAR(7)),7), 6, 2) CONCAT ''/20'' CONCAT&#xA;              &#x9;&#x9;SUBSTR(Right(''0'' concat CAST(dtin65 AS VARCHAR(7)),7), 2, 2)  &#xA;        &#x9;end as dtin65,&#xA;&#x9;ordn70 as co_num,&#xA;&#x9;ordl70 as co_line,&#xA;&#x9;0 as co_release,&#xA;&#x9;CAST('''' as nvarchar(1)) as item_customer,&#xA;&#x9;catn70 as item_internal,&#xA;&#x9;lqty70 as qty_invoiced,&#xA;&#x9;bdis70 as discount,&#xA;&#x9;cval70 as cost,&#xA;&#x9;uprc70 as price,&#xA;&#x9;bliv70 as base_line_value,&#xA;&#x9;lval70 AS inv_line_value,&#xA;&#x9;curn00 as currency_code,&#xA;&#x9;desn70 as ship_ref,&#xA;&#x9;CAST('''' as nvarchar(1)) as ship_line,&#xA;&#x9;CAST('''' as nvarchar(1)) as ship_seq,&#xA;&#x9;invn70 as source_inv_num,&#xA;&#x9;''I'' as line_type,&#xA;&#x9;CASE&#xA;&#x9;&#x9;WHEN d.qtor55 = (SELECT SUM(lqty70) FROM ault2f2prd.oep70 AS sq where sq.cono70=a.cono70 and sq.ordn70=a.ordn70 AND sq.ordl70=a.ordl70 AND sq.dttr70 &lt;= a.dttr70 AND sq.invn70 &lt;= a.invn70)&#xA;&#x9;&#x9;THEN 1&#xA;&#x9;&#x9;ELSE 0&#xA;&#x9;END Line_Count,&#xA;&#x9;CASE &#xA;&#x9;&#x9;WHEN a.dttr70 &gt; d.dtdr55&#xA;&#x9;&#x9;THEN 0&#xA;&#x9;&#x9;ELSE 1&#xA;&#x9;END as ot_count,&#xA;&#x9;d.qtor55 as order_qty,&#xA;(SELECT SUM(lqty70) FROM ault2f2prd.oep70 AS sq where sq.cono70=a.cono70 and sq.ordn70=a.ordn70 AND sq.ordl70=a.ordl70 AND sq.dttr70 &lt;= a.dttr70 AND sq.invn70 &lt;= a.invn70) as cum_ship_qty&#xA;&#x9;&#xA;from ault2f2prd.oep70 a&#xA;inner join ault2f2prd.oep65 b on b.cono65 = a.cono70 and&#xA;b.invn65 = a.invn70&#xA;inner join AULT1F2PRD.COMPANY c&#xA;on a.cono70=c.cono&#xA;LEFT JOIN ault2f2prd.oep55 d&#xA;&#x9;&#x9;&#x9;ON a.cono70=d.cono55 and a.ordn70=d.ordn55 and a.ordl70=d.ordl55&#xA;where (dtin65 &gt;= CAST(''1'' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 30 days, ''YYMMDD'') FROM sysibm.sysdummy1) AS INT)&#xA;OR dtlc65 &gt;= CAST(''1'' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 30 days, ''YYMMDD'') FROM sysibm.sysdummy1) AS INT))&#xA;&#xA;&#xA;UNION ALL&#xA;select &#xA;&#x9;1 as system_id,&#xA;&#x9;cono50 as entity_id,&#xA;&#x9;invn50 as inv_num,&#xA;&#x9;CAST(1000 + CAST(DESN50 AS INT) as nvarchar(6)) as inv_seq,&#xA;&#x9;sqno50 as inv_line,&#xA;&#x9;case when dtin65 = 0 then null else &#xA;&#x9;&#x9;SUBSTR(Right(''0'' concat CAST(dtin65 AS VARCHAR(7)),7), 4, 2) CONCAT ''/'' CONCAT&#xA;               &#x9;&#x9;SUBSTR(Right(''0'' concat CAST(dtin65 AS VARCHAR(7)),7), 6, 2) CONCAT ''/20'' CONCAT&#xA;              &#x9;&#x9;SUBSTR(Right(''0'' concat CAST(dtin65 AS VARCHAR(7)),7), 2, 2)  &#xA;        &#x9;end as dtin65,&#xA;&#x9;ordn50 as CO_NUM,&#xA;&#x9;SQNO50 AS CO_LINE,&#xA;&#x9;0 AS CO_RELEASE,&#xA;&#x9;CAST('''' as nvarchar(1)) as item_customer,&#xA;&#x9;ODES50 AS item_internal,&#xA;&#x9;1 as qty_invoiced,&#xA;&#x9;0 as discount,&#xA;&#x9;0 as cost,&#xA;&#x9;chgv50 as price,&#xA;&#x9;bchv50 as base_line_value,&#xA;&#x9;chgv50 AS inv_line_value,&#xA;&#x9;curn00 as currency_code,&#xA;&#x9;desn65 as ship_ref,&#xA;&#x9;0 as ship_line,&#xA;&#x9;0 as ship_seq,&#xA;&#x9;invn50 as source_inv_num,&#xA;&#x9;''C'' as line_type,&#xA;0 as Line_Count,&#xA;0 as ot_count,&#xA;0 as order_qty,&#xA;0 as cum_ship_qty&#xA;&#xA;from ault2f2prd.oep50 a &#xA;inner join ault2f2prd.oep65 b on a.cono50=b.cono65  and&#xA;a.invn50=b.invn65&#xA;inner join AULT1F2PRD.COMPANY c&#xA;on a.cono50=c.cono&#xA;where  (dtin65 &gt;= CAST(''1'' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 48 months, ''YYMMDD'') FROM sysibm.sysdummy1) AS INT)&#xA;OR dtlc65 &gt;= CAST(''1'' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 48 months, ''YYMMDD'') FROM sysibm.sysdummy1) AS INT))&#xA;and RTRIM(LTRIM(INVN50)) &lt;&gt; ''''',@DataObjectConnectionString=?,@DataObjectConnectionName='JBA OLEDB',@DataObjectDataSource=?,@DataObjectUserName=?,@DataObjectCatalog=?,@ExecutionID=?,@SourceName=?,@SourceID=?,@RecordCount=?" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::varSSISOps_7B0BA4FAD19048F7B771F9CC2D45149A_RowCount_1_DataObjectConnectionString"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
