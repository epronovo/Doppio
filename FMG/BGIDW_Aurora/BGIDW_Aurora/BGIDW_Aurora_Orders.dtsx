                <component
                  refId="Package\CO Lines\Load CO Lines\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
cono55 as system_entity_id,
ordn55 as co_num,
ordl55 as co_line,
'0' as co_release,
ortp55 as order_type,
osrc55 as order_source,
cusn40 as cust_bill_num,
'000' as cust_bill_seq,
cusn40 as cust_ship_num,
dseq40 as cust_ship_seq,
catn55 as item,
'' as cust_item,
qtor55 as qty_ordered,
qtds55 as qty_shipped,
disp55 as disc_pct,
bdis55 as disc_amt,
uprc55 as price,
curn40 as currency_code,
case when DTDR55 = 0 then NULL else SUBSTR(Right('0' concat CAST(DTDR55 AS VARCHAR(7)),7), 4, 2)  CONCAT '/' CONCAT
SUBSTR(Right('0' concat CAST(DTDR55 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
SUBSTR(Right('0' concat CAST(DTDR55 AS VARCHAR(7)),7), 2, 2)  
end as due_date,
case when DTLP55 = 0 then NULL else SUBSTR(Right('0' concat CAST(DTLP55 AS VARCHAR(7)),7), 4, 2)  CONCAT '/' CONCAT
SUBSTR(Right('0' concat CAST(DTLP55 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
SUBSTR(Right('0' concat CAST(DTLP55 AS VARCHAR(7)),7), 2, 2)  
end as promise_date,
' ' as status,
'' as DPAS_code,
cuso40 as cust_po_num,
(ORLV55/QTOR55) * (QTOR55 - QTDS55) as line_value,
(BORL55/QTOR55) * (QTOR55 - QTDS55) as base_line_value,
EXDF55 as rev_rec_flag,
case when DTLC55= 0 then null else SUBSTR(Right('0' concat CAST(DTLC55 AS VARCHAR(7)),7), 4, 2)  CONCAT '/' CONCAT
SUBSTR(Right('0' concat CAST( DTLC55 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
SUBSTR(Right('0' concat CAST( DTLC55 AS VARCHAR(7)),7), 2, 2)  
end as date_last_changed
from 
ault2f2prd.OEP55 OEP55

inner join ault2f2prd.OEP40 OEP40 on OEP40.cono40 = OEP55.CONO55 and
OEP40.ORDN40 = OEP55.ORDN55

where 
CONO55 IN (SELECT CONO FROM ASGHDCA.DWCOMPANY) 
and stat55=' '
and qtno55=' '
and ORLV55 &lt;&gt; 0
and QTOR55 &lt;&gt; 0</property>
