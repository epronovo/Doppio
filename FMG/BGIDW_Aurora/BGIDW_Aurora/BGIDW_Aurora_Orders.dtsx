cono40 = OEP55.CONO55 and&#xA;OEP40.ORDN40 = OEP55.ORDN55&#xA;&#xA;where &#xA;CONO55 IN (SELECT CONO FROM ASGHDCA.DWCOMPANY) &#xA;and stat55='' ''&#xA;and qtno55='' ''&#xA;and ORLV55 &lt;&gt; 0&#xA;and QTOR55 &lt;&gt; 0',@DataObjectConnectionString=?,@DataObjectConnectionName='172.16.101.19.DB2LOCAL.PCSRVR2',@DataObjectDataSource=?,@DataObjectUserName=?,@DataObjectCatalog=?,@ExecutionID=?,@SourceName=?,@SourceID=?,@RecordCount=?" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
