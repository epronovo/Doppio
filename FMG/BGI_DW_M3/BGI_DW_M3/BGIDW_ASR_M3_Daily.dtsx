                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT * FROM (SELECT 
    system_id,
    system_entity_id,
    item_num,
    price_disc_list,
    pl_effective_start,
    currency_code,
    qty_break_01,
    effective_start,
    effective_end,
    price_01,
