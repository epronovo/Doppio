    <DTS:Executable
      DTS:refId="Package\Load erp product codes"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{14F99CF8-1FC7-48AA-A6B5-9E5614B84ABB}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load erp product codes">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Load erp product codes\Load ERP product codes"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:DelayValidation="True"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{43276F03-25BF-4E07-81AE-80717C717927}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load ERP product codes"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[MITMAS - Product Codes].[SqlCommand]">"SELECT DISTINCT
       " + (DT_WSTR, 2)@[User::system_id_for_M3_map] + " AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       RTRIM(LTRIM(a.MMITNO)) AS key_code,
       RTRIM(LTRIM(a.MMITCL)) AS erp_product1,
       RTRIM(LTRIM(a.MMCFI3)) AS erp_product2,
       RTRIM(LTRIM(a.MMBUAR)) AS erp_product3,
       RTRIM(LTRIM(a.MMACRF)) AS erp_product4
      
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
WHERE CAST(SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 7, 2) AS DATE) &gt;= DATEADD(d, -15, GETDATE())
      AND MMCONO = " +@[$Package::CompanyParameter] +" AND COALESCE(a.deleted ,0 ) = 0"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Load erp product codes\Load ERP product codes\MITMAS - Product Codes"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="MITMAS - Product Codes"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
       33 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       RTRIM(LTRIM(a.MMITNO)) AS key_code,
       RTRIM(LTRIM(a.MMITCL)) AS erp_product1,
       RTRIM(LTRIM(a.MMCFI3)) AS erp_product2,
       RTRIM(LTRIM(a.MMBUAR)) AS erp_product3,
       RTRIM(LTRIM(a.MMACRF)) AS erp_product4
      
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
WHERE CAST(SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 7, 2) AS DATE) &gt;= DATEADD(d, -15, GETDATE())
      AND MMCONO = 910 AND COALESCE(a.deleted ,0 ) = 0</property>
                    <property
