        <DTS:Executable
          DTS:refId="Package\PO\Po Line Receipts"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:DelayValidation="True"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{AAF12227-2124-4215-9036-22FB0BBBD90B}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Po Line Receipts"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\PO\Po Line Receipts\ADO NET Source"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 33 system_id
    ,CONCAT(RIGHT(CONCAT('000', polr.ICCONO), 3), polr.ICFACI) AS system_entity_id
    ,cast(polr.ICPUNO as nvarchar(15)) [po_num]
    ,cast(polr.ICPNLI as nvarchar(15)) po_line
    ,cast(pol.ibitno as nvarchar(80)) item_num_internal
,cast(pol.IBPNLS as nvarchar(15)) po_seq
    ,cast('' as nvarchar(80)) item_num_vendor
    ,polr.icrpqa qty_ordered
    ,polr.icrpqt qty_received
    ,case when poh.IAPUDT=0 then null else CONVERT(date, CAST(poh.IAPUDT AS NVARCHAR(10))) end [po_date]
    ,case when polr.icpldt= 0 then null else cast(CONVERT(date, CAST(polr.icpldt AS NVARCHAR(10))) as nvarchar(10)) end [due_date]
    ,case when polr.icpldt= 0 then null else CONVERT(date, CAST(polr.icpldt AS NVARCHAR(10))) end [date_received]
    ,pol.ibpupr [unit_price]
    ,pol.ibpupr [unit_price_base]
    ,cast(pol.ibpupr * polr.icrpqt as decimal(18,4)) [extended_price]
    ,cast(pol.ibpupr * polr.icrpqt as decimal(18,4)) [extended_price_base]
    ,cast(pol.IBPUUN as nvarchar(10)) unit_of_measure_order
    ,cast(pol.IBPUUN as nvarchar(10)) unit_of_measure_stock
    ,cast(pol.IBPUUN as nvarchar(10)) unit_of_measure_purchase
    ,cast(poh.iacucd as nvarchar(4)) currency_code 
    ,1.00 [conversion_rate_base]
    ,cast(poh.IASUNO as nvarchar(30)) [vendor_num]
  ,CASE WHEN isnull(addr.SAADID,'')='' then '000' else addr.SAADID end [vendor_seq]   --,cast(posa.ADADID as nvarchar(15)) vendor_seq 
,cast(polr.ICSUDO as nvarchar(20)) [packing_slip],cast(CONCAT(ICCONO, ICPUNO, ICPNLI,ICPNLS,ICPNLX)  as varchar(50))[external_id]  
from MPLIND polr 
    inner join MPLINE pol (nolock) on pol.ibpuno=polr.icpuno and pol.ibpnli=polr.icpnli and polr.iccono=pol.ibcono and pol.deleted = 0 and polr.ICPNLS = pol.IBPNLS
    inner join MPHEAD poh (nolock) on poh.iapuno=polr.icpuno and poh.iacono=polr.iccono
    inner join MPPOAD posa (nolock) on posa.ADCONO=poh.IACONO and posa.ADPUNO=poh.IAPUNO and posa.ADPOAD=3
    left outer join FGRECL recl (nolock) on recl.f2cono=polr.iccono 
        and recl.f2divi=polr.icfaci
        and recl.f2puno=polr.ICPUNO
        and recl.f2pnli=polr.ICPNLI
        and recl.f2pnls=polr.icpnls
        and recl.f2itno=pol.ibitno
        and recl.f2rpqa=polr.icrpqa
        and recl.f2rpqt=polr.icrpqt
and recl.f2repn=polr.icrepn
left outer join CIDADR addr (nolock) on addr.SACONO=posa.ADCONO and addr.sasuno=poh.iasuno and addr.SAADID=case when posa.ADADID ='' then '000'else posa.ADADID end  
where polr.ICCONO='910'
   -- and polr.dlDocumentDate &gt;=DATEADD(WEEK, -8, cast(GETDATE() as date))  
    and polr.ICPUOS in (75) 
    and not recl.f2imst = '9'    
    --and polr.ICPUNO in ('1126424','1125837','1125684')</property>
                    <property
