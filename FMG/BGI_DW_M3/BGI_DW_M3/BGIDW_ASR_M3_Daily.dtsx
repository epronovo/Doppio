        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Vendor New\Vendors"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:DelayValidation="True"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{95018573-9346-43C9-B398-2ED0B495EAD4}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Vendors"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[ADO NET Source].[SqlCommand]">"SELECT DISTINCT " + (DT_WSTR, 2)@[User::system_id_for_M3_map] + " AS system_id, 
       CONCAT(CAST(C.IDCONO AS NVARCHAR(7)), '088') AS system_entity_id,
       C.IDSUNO AS vend_num,
       ISNULL(A.SAADID, '000') AS vend_seq,
       C.IDSUNM AS name,
       A.SAADR1 AS address_1,
       A.SAADR2 AS address_2,
       A.SAADR3 AS address_3,
       A.SAADR4 AS address_4,
       '' AS address_5,
       A.SATOWN AS city,
       A.SAECAR AS state,
       A.SAPONO AS postal_code1,
       '' AS postal_code2,
       A.SACSCD AS erp_country,
       C.IDSTAT AS active_flag,
       '' AS system_identifier_1,
       '' AS system_identifier_2,
       LEFT(REPLACE(B.IITEPY, 'N', ''), 20) AS payment_terms,
       B.IICUCD AS currency_code,
       C.IDCFI5 AS matching_type,
       CASE
           WHEN LEFT(C.IDSUNO, 4) = 'INT0' THEN
               1
           ELSE
               0
       END AS intercompany_flag
FROM CIDMAS AS C
    left outer JOIN CIDADR AS A
        ON C.IDCONO = A.SACONO
           AND C.IDSUNO = A.SASUNO
    left outer JOIN CIDVEN AS B
        ON C.IDCONO = B.IICONO
           AND C.IDSUNO = B.IISUNO   
WHERE C.IDCONO = '" +@[$Package::CompanyParameter] +"'
	  AND C.deleted=0"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Vendor New\Vendors\ADO NET Source"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 33 AS system_id, 
       CONCAT(CAST(C.IDCONO AS NVARCHAR(7)), '088') AS system_entity_id,
       C.IDSUNO AS vend_num,
       ISNULL(A.SAADID, '000') AS vend_seq,
       C.IDSUNM AS name,
       A.SAADR1 AS address_1,
       A.SAADR2 AS address_2,
       A.SAADR3 AS address_3,
       A.SAADR4 AS address_4,
       '' AS address_5,
       A.SATOWN AS city,
       A.SAECAR AS state,
       A.SAPONO AS postal_code1,
       '' AS postal_code2,
       A.SACSCD AS erp_country,
       C.IDSTAT AS active_flag,
       '' AS system_identifier_1,
       '' AS system_identifier_2,
       LEFT(REPLACE(B.IITEPY, 'N', ''), 20) AS payment_terms,
       B.IICUCD AS currency_code,
       C.IDCFI5 AS matching_type,
       CASE
           WHEN LEFT(C.IDSUNO, 4) = 'INT0' THEN
               1
           ELSE
               0
       END AS intercompany_flag
FROM CIDMAS AS C
    left outer JOIN CIDADR AS A
        ON C.IDCONO = A.SACONO
           AND C.IDSUNO = A.SASUNO
    left outer JOIN CIDVEN AS B
        ON C.IDCONO = B.IICONO
           AND C.IDSUNO = B.IISUNO   
WHERE C.IDCONO = '910'
	  AND C.deleted=0</property>
