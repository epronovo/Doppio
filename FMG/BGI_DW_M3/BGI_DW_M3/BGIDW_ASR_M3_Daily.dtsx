    <DTS:Executable
      DTS:refId="Package\AR Mast"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{A0DEE351-22E8-4AC8-9B0D-543827A7EAD7}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="AR Mast">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\AR Mast\Load AR Mast"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:DelayValidation="True"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{FE592D30-50B9-4000-A6D6-019CE8E9AD51}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load AR Mast"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\AR Mast\Load AR Mast\ADO NET Source"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 33 AS system_id
    ,cast(CONCAT(mast.ESCONO, mast.ESDIVI) as nvarchar(10)) AS [system_entity_id]
    ,cast(ltrim(rtrim(mast.[ESCINO])) as nvarchar(20)) AS [invoice_no]
    ,mast.[ESINYR] AS [invoice_seq]    
    ,cast(CASE WHEN [ESIVTP] = '' THEN
            'I'
        WHEN [ESIVTP] = 'CN' THEN
            'C'
        WHEN [ESIVTP] = 'DN' THEN
            'D'
        WHEN [ESIVTP] = 'AP'  THEN
            'U'
        WHEN [ESIVTP] = 'WO' THEN
            'A'
    ELSE
            'U'
    END as nvarchar(10)) AS [invoice_type]
    ,cast(mast.[ESCUNO] as nvarchar(30)) AS [cust_num]
    ,cast('' as nvarchar(30)) AS [cust_seq]
    ,cast(mast.ESCUCD as nvarchar(5)) [currency_code]
    ,null cust_ship_num
    ,null cust_ship_seq
    ,cast(co.essexi  as nvarchar(15)) [co_num]
    ,NULL AS dr_amount
    ,0 AS freight_amount
    ,0 AS misc_charges
    ,0 AS sales_tax
    ,NULL AS payment_amount
    ,NULL AS credit_amount
    ,NULL AS discount_amount
    ,case when inva.invoice_amount = 0 then 
        'X' 
    else 
        case when (inva.invoice_amount + tp.total_payments)=0 then 
            'X'
        else
            'O'
        END
    end as [invoice_status]
    --,case when (ESCUAM + tp.total_payments)=0 then 'X' else 'O' end as [invoice_status]    
    ,CAST(mast.[ESIVDT] AS NVARCHAR(8)) AS invoice_date
    ,CAST(mast.[ESDUDT] AS NVARCHAR(8)) AS due_date
    ,NULL AS pif_date
    ,NULL AS ship_date
    ,NULL AS ship_via
    ,cast(DATEDIFF(DAY, CONVERT(DATE, CAST([ESIVDT] AS CHAR(8)), 112), CONVERT(DATE, CAST([ESDUDT] AS CHAR(8)), 112)) as int) AS net_days
    --,ESCUAM invoice_amount
    --,ESCUAM invoice_total
    ,cast(inva.invoice_amount as decimal(21,8))invoice_amount
    ,cast(inva.invoice_amount as decimal(21,8)) invoice_total    
    ,cast(COALESCE(tp.total_payments, 0) * -1 as decimal(23,8)) AS total_payments
    ,NULL AS terms
    ,NULL AS new_line
    ,cast(po.essexi as nvarchar(25)) purchase_order_no
    ,cast(coalesce(cast(del.uadlix as varchar),vou.EGVTXT) as nvarchar(30)) as packing_slip
    ,NULL bol 
FROM [FSLEDG] mast
INNER JOIN (
    select
        mast.ESCONO
        ,mast.ESDIVI
        ,mast.ESCINO
        ,mast.[ESINYR]
        ,mast.[esjrno]    
        ,mast.estrcd
        ,mast.ESYEA4
        ,mjsno.ESJSNO
        ,sum(ESCUAM) AS invoice_amount
    --,mast.*
    FROM [FSLEDG] mast
    inner join 
        (
            select min(esjsno)[ESJSNO]
                ,ESCONO
                ,ESDIVI
                ,ESCINO
                ,ESINYR
                ,ESJRNO
                ,ESTRCD
                ,ESYEA4
            from FSLEDG
            where ESCONO='910'
                AND ESDIVI='088'
                AND [ESTRCD] = 10
                --AND [ESCINO] in( '999900106','CIA 1113')    
            group by 
                    ESCONO
                    ,ESDIVI
                    ,ESCINO
                    ,ESINYR
                    ,ESJRNO
                    ,ESTRCD
                    ,ESYEA4
        )mjsno on mjsno.ESCINO=mast.ESCINO
            and mjsno.ESCONO=mast.ESCONO
            and mjsno.ESDIVI=mast.ESDIVI
            and mjsno.ESINYR=mast.ESINYR
            and mjsno.ESJRNO=mast.ESJRNO
            and mjsno.ESTRCD=mast.ESTRCD
            and mjsno.ESYEA4=mast.ESYEA4
            --and mjsno.ESJSNO=mast.ESJSNO
    where mast.ESCONO='910'
        and mast.ESDIVI='088'
        AND mast.[ESTRCD] = 10
        --and mast.[ESCINO] in( '999900106','CIA 1113')
    group by     
        mast.ESCONO
        ,mast.ESDIVI
        ,mast.ESCINO
        ,mast.[ESINYR]
        ,mast.[esjrno]
        ,mast.estrcd
        ,mast.ESYEA4
        ,mast.[ESTRCD]
        ,mjsno.ESJSNO
) inva on inva.ESCONO=mast.ESCONO
    and inva.ESDIVI=mast.ESDIVI
    and inva.ESCINO=mast.ESCINO
    and inva.ESINYR=mast.ESINYR
    and inva.ESJRNO=mast.ESJRNO
    and inva.ESTRCD=mast.ESTRCD
    and inva.ESYEA4=mast.ESYEA4
    and inva.ESJSNO=mast.ESJSNO
LEFT JOIN FGLEDG vou on mast.escono=vou.egcono 
    and mast.esjrno=vou.egjrno 
    and mast.esjsno=vou.egjsno 
    and mast.estrcd=vou.egtrcd 
    and mast.ESYEA4=vou.egyea4 and vou.deleted=0
left outer join [FSLEDX] po (nolock) on po.ESCONO=mast.ESCONO 
        and po.ESDIVI=mast.ESDIVI 
        and po.ESYEA4=mast.ESYEA4
        and po.ESJRNO=mast.ESJRNO
        and po.ESJSNO=mast.ESJSNO
        and po.ESSEXN=231
left outer join [FSLEDX] co (nolock) on po.ESCONO=mast.ESCONO 
        and co.ESDIVI=mast.ESDIVI 
        and co.ESYEA4=mast.ESYEA4
        and co.ESJRNO=mast.ESJRNO
        and co.ESJSNO=mast.ESJSNO
        and co.ESSEXN=203
/*
left outer join [odhead] del (nolock) on del.UACONO=mast.ESCONO
        and del.UADIVI=mast.ESDIVI
        and del.uacuno=mast.ESCUNO
        and del.uapyno=mast.ESPYNO
        and del.uayea4=mast.ESYEA4
        and cast(del.uaivno as varchar)=mast.ESCINO
*/
left outer join (
    select 
        uacono
        ,uadivi
        ,uacuno
        ,uapyno
        ,uayea4
        ,cast(uaivno as varchar) uaivno
        ,min(uadlix) uadlix
    from [odhead] 
    group by 
        uacono
        ,uadivi
        ,uacuno
        ,uapyno
        ,uayea4
        ,uaivno

) del on del.UACONO=mast.ESCONO
        and del.UADIVI=mast.ESDIVI
        and del.uacuno=mast.ESCUNO
        and del.uapyno=mast.ESPYNO
        and del.uayea4=mast.ESYEA4
        and cast(del.uaivno as varchar)=mast.ESCINO
left outer join (
    select
        ESCONO
        ,ESDIVI
        ,ESCINO
        ,[ESINYR]       
        ,SUM(ESCUAM) AS total_payments
    FROM [FSLEDG] mast
    where mast.ESCONO='910'
        and mast.ESDIVI='088'
        AND mast.[ESTRCD] &lt;&gt; 10
        --and mast.[ESCINO] = '999900025'
    GROUP BY ESCONO, ESDIVI,
                    [ESCINO],
                    [ESINYR]
)tp on tp.ESINYR=mast.ESINYR 
    and tp.ESCINO=mast.ESCINO 
    and tp.ESDIVI=mast.ESDIVI 
    and tp.ESCONO=mast.ESCONO    
where mast.ESCONO='910'
    and mast.ESDIVI='088'
    AND mast.[ESTRCD] = 10    
    --and mast.[ESCINO] in ( '999900106','999930354','999927441','CIA 1113')    
order by mast.ESCUNO,mast.ESCINO</property>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">30</property>
