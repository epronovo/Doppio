                <component
                  refId="Package\Customers\Load customers\M3 customers query"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="M3 customers query"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    cust.system_id
    ,cust.system_entity_id
    ,cust.cust_num
    ,cust.cust_seq
    ,cust.name
    ,cust.address_1
    ,cust.address_2
    ,cust.address_3
    ,cust.address_4
    ,cust.city
    ,cust.[state]
    ,cust.erp_country
    ,cust.postal_code_1
    ,cust.credit_limit
    ,cust.price_list
    ,cust.terms_payment_text
    ,isnull(dm.delivery_method,cust.delivery_method_CTSTKY) [delivery_method]
    ,isnull(dt.delivery_terms,cust.delivery_terms_CTSTKY)[terms_shipment_text]
    ,collect_code
	,system_identifier_1
    ,currency_code    
FROM(
SELECT DISTINCT 33 AS system_id,

       CONCAT(RIGHT(CONCAT('000', ISNULL(a.OPCONO, '')), 3), c.CFDIVI) AS system_entity_id,
       a.OPCUNO AS cust_num,
       a.OPADID AS cust_seq,
       a.OPCUNM AS [name],
       a.OPCUA1 AS address_1,
       a.OPCUA2 AS address_2,
       a.OPCUA3 AS address_3,
       a.OPCUA4 AS address_4,
       a.OPTOWN AS city,
       a.OPECAR AS [state],
       a.OPCSCD AS erp_country,
       a.OPPONO AS postal_code_1,
	   b.OKCRLM AS credit_limit,
	   b.OKCFC4 AS price_list,
	   b.OKTEPY AS terms_payment_text,
        a.OPMODL [delivery_method_CTSTKY],
        a.OPTEDL [delivery_terms_CTSTKY],
        a.OPCONO,
        cast(b.OKCFC3 AS varchar(20)) [collect_code],
		b.[OKALCU] AS system_identifier_1,
        b.[OKCUCD] as currency_code,
        a.OPADRT as [address_type]
FROM OCUSAD AS a
     INNER JOIN OCUSMA b ON a.OPCONO = b.OKCONO
                                    AND a.OPCUNO = b.OKCUNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.OKFACI = c.CFFACI AND COALESCE(c.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND a.OPCONO = 910 AND a.OPADRT = 1
--and NOT (a.OPCUNO = '17750' and OPADRT = '2' and OPADID = '00000')
UNION ALL
SELECT DISTINCT 33 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(a.OKCONO, '')), 3), c.CFDIVI) AS system_entity_id,
       a.OKCUNO AS cust_num,
       '' AS cust_seq,
       a.OKCUNM AS [name],
       a.OKCUA1 AS address_1,
       a.OKCUA2 AS address_2,
       a.OKCUA3 AS address_3,
       a.OKCUA4 AS address_4,
       a.OKTOWN AS city,
       a.OKECAR AS [state],
       a.OKCSCD AS erp_country,
       a.OKPONO AS postal_code_1,
	   a.OKCRLM AS credit_limit,
	   a.OKCFC4 AS price_list,
	   a.OKTEPY AS terms_payment_text,
        a.OKMODL [delivery_method],
        a.OKTEDL [delivery_terms],
        a.OKCONO,
       cast(a.OKCFC3 as varchar(20)) as collect_code,
	   a.[OKALCU] AS system_identifier_1,
       a.OKCUCD as currency_code,
       null
FROM OCUSMA a
     INNER JOIN CFACIL c ON a.OKFACI = c.CFFACI AND COALESCE(c.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND a.OKCONO = 910
)cust
left outer join 
    (
        select CTSTKY,
           cast( TRIM(REVERSE(right(REVERSE(CTPARM), len(REVERSE(CTPARM)) - charindex(' ', REVERSE(CTPARM))))) as NVARCHAR(30)) [delivery_method]
        from CSYTAB 
        where CTCONO='910' 
            and CTSTCO='MODL' 
            and CTLNCD='' --and CTSTKY='003'  -- Delivery_Method'

    )dm on dm.CTSTKY=cust.delivery_method_CTSTKY
left outer JOIN
    (
        select CTSTKY
            ,cast(case when CHARINDEX('(', CTPARM) &gt; 0 then 
                LEFT(CTPARM, CHARINDEX('(', CTPARM) - 1) 
            else 
                CTPARM 
            END as nvarchar(30)) [delivery_terms] 
        from CSYTAB 
        where CTCONO='910' 
            and CTSTCO='TEDL' 
            and CTLNCD=''--and CTSTKY='CIF'  -- Delivery_Terms'
    )dt on dt.CTSTKY=cust.delivery_terms_CTSTKY

   where coalesce([address_type],1)=1</property>
