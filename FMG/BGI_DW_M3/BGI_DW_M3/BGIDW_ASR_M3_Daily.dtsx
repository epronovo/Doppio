        <DTS:Executable
          DTS:refId="Package\Sales Order Backlog\Load co_line table"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:DelayValidation="True"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{3A6D4413-4203-471D-BC51-2B4C2E52F745}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load co_line table"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[select from schema MVXJDTA table OOLINE].[SqlCommand]">"SELECT " + (DT_WSTR, 2)@[User::system_id_for_M3_map] + "  AS [system_id],
       CONCAT(RIGHT(CONCAT('000', ISNULL(O.OBCONO, '')), 3), O.OBDIVI) AS [system_entity_id],
       O.OBORNO AS [co_num],
       O.OBPONR AS [co_line],
       O.OBPOSX AS [co_release],
       O.OBCUNO AS [cust_bill_num],
       '' AS [cust_bill_seq],
       O.OBDECU AS [cust_ship_num],
       O.OBADID AS [cust_ship_seq],
       O.OBITNO AS [item],
       O.OBPOPN AS [cust_item],
       O.OBORQT AS [qty_ordered],
       OBDLQT + OBIVQT AS [qty_shipped],
       O.OBDIP1 AS [disc_pct],
       O.OBDIA1 AS [disc_amt],
       O.OBSAPR AS [price],
       OH.OACUCD AS [currency_code],
       O.OBCUOR AS [cust_po_num],
       O.OBCUPO AS [cust_po_line_num],
       case when O.OBDWDT = 0 then null else CAST(SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 7, 2) AS DATE) end AS [due_date],
       case when O.OBCODT = 0 then null else CAST(SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 7, 2) AS DATE) end AS [promise_date],
       O.OBORST,
       CASE
           WHEN CAST(O.OBORST AS INT) &gt;= 22
                AND CAST(O.OBORST AS INT) &lt; 67
           THEN 'O'
     WHEN CAST(O.OBORST AS INT) = 99
     THEN 'X'
           ELSE 'C'
       END AS [status],
       '' AS [DPAS_code],
       O.OBCUCT AS [internal_transfer_currency],
	   case when O.OBORQT = 0 then 0 else (O.OBLNAM/O.OBORQT) * (O.OBORQT - (OBDLQT + OBIVQT)) end AS [line_value], 
       '' AS [cust_attr1],
       '' AS [cust_attr2],
       '' AS [cust_attr3],
	  COALESCE(R.CUARAT, 1) AS [rate],
       case when O.OBORQT = 0 then 0 else CAST((O.OBLNAM/O.OBORQT) * (O.OBORQT - (OBDLQT + OBIVQT)) * COALESCE(R.CUARAT, 1) AS MONEY) end AS [base_line_value]
FROM OOLINE AS O 
INNER JOIN OOHEAD AS OH 
ON O.OBCONO=OH.OACONO AND O.OBDIVI=OH.OADIVI AND O.OBORNO=OH.OAORNO AND COALESCE(OH.deleted ,0 ) = 0
LEFT JOIN (
SELECT a.CUCONO ,
       a.CUDIVI ,
       a.CUCUCD ,
       a.CUARAT
FROM   CCURRA a
       INNER JOIN (   SELECT   CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP ,
                               MAX(CUCUTD) AS CUCUTD
                      FROM     CCURRA
					  WHERE COALESCE(deleted ,0 ) = 0
                      GROUP BY CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP
                  ) AS b ON a.CUCONO = b.CUCONO
                            AND a.CUDIVI = b.CUDIVI
                            AND a.CUCUCD = b.CUCUCD
                            AND a.CUCRTP = b.CUCRTP
                            AND a.CUCUTD = b.CUCUTD
WHERE  a.CUCRTP = 1 AND COALESCE(a.deleted ,0 ) = 0

) AS R
ON O.OBCONO=R.CUCONO AND O.OBDIVI=R.CUDIVI AND OH.OACUCD=R.CUCUCD
WHERE  COALESCE(O.deleted ,0 ) = 0 AND O.OBCONO=" + @[$Package::CompanyParameter]</DTS:PropertyExpression>
