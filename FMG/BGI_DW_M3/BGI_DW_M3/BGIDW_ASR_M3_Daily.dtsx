          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"
DELETE FROM [dbo].[co_line] WHERE system_id = 33"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{70638FDC-4F5C-4844-A145-7B0F82BF1D9D}"
              SQLTask:SqlStatementSource="&#xA;DELETE FROM [dbo].[co_line] WHERE system_id = 33" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="@parmSystemID"
                SQLTask:DtsVariableName="User::system_id_for_M3_map"
