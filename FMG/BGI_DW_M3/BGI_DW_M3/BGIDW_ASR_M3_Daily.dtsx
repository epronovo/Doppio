    <DTS:Executable
      DTS:refId="Package\PO"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{46E47980-DCFC-4BBB-B24E-FD0F7A01078A}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="PO">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PO\PO Header"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:DelayValidation="True"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{AF08A5EF-01F3-4B32-8C81-8C695B13DA08}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="PO Header"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\PO\PO Header\ADO NET Source"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select DISTINCT 33 system_id
    ,CONCAT(RIGHT(CONCAT('000', poh.IACONO), 3), poh.IAFACI) AS system_entity_id
    ,poh.IAPUNO [po_num]
    ,poh.IASUNO [vend_num]
    ,CASE WHEN isnull(addr.SAADID,'')='' then '000' else addr.SAADID end [vendor_seq]  --,posa.ADADID [vendor_seq]
    ,CONVERT(DATE, CAST(poh.IAPUDT AS NVARCHAR(10))) [po_date]
    ,poh.IACUCD [currency_code]    
    ,poh.dlDocumentDate AS update_dt
    ,poh.IAORTY [po_type]
    ,poh.IABUYE [buyer_id]
    ,'' [buyer_name] -- [new column required]
    ,cast(0.00 as decimal(18,4)) [fuel_surcharge] -- [new column required]    
    ,cast(0.00 as decimal(18,4)) [matl_surcharge] -- [new column required]
    ,cast(0.00 as decimal(18,4)) [freight]
    ,cast(0.00 as decimal(18,4)) [sales_tax] -- [new column required]       
    ,cast(poh.IAEXEP as decimal(18,4)) [other_charges] -- [new column required]
    ,cast(0.00 as decimal(18,4)) [misc_charges] -- [new column required]
    ,REPLACE(poh.IATEPY, 'N', '') AS [terms_code]
    ,poh.IACOAM [total_charges]
    ,cast(posa.ADCONM as nvarchar(50)) ship_name
    ,cast(posa.ADADR1 as nvarchar(50)) ship_address_1    
    ,cast(posa.ADADR2 as nvarchar(50)) ship_address_2
    ,cast(posa.ADADR3 as nvarchar(50)) ship_address_3    
    ,cast(posa.ADTOWN as nvarchar(50)) ship_city    
    ,cast(posa.ADECAR as nvarchar(50)) ship_state    
    ,cast(posa.ADPONO as nvarchar(10)) ship_zip_code
    ,cast(posa.ADCSCD as nvarchar(5)) ship_country_code
    ,poh.IAPYME [ledger_code] -- [new column required]
    ,cast(poh.IAODAM as decimal(18,4)) [discount] -- [new column required]' 
    ,case when( (poh.IAPUSL &gt;=20 and poh.IAPUSL &lt;=80) or (poh.IAPUST &gt;=20 and poh.IAPUST &lt;=80) )then 1 else 2 end [status_code]
from MPHEAD poh
    inner join MPPOAD posa (nolock) on posa.ADCONO=poh.IACONO 
        and posa.ADPUNO=poh.IAPUNO 
        and posa.ADPOAD=1 
        and posa.deleted=0 
        and posa.ADPNLI=0
	left outer join CIDADR addr (nolock) on addr.SACONO=posa.ADCONO 
        and addr.sasuno=poh.iasuno 
        and addr.SAADID=case when posa.ADADID ='' then '000'else posa.ADADID end    
where poh.IACONO='910'    
    -- and cast(poh.dlDocumentDate as date) &gt;=DATEADD(WEEK, -8, cast(GETDATE() as date))
    and poh.deleted=0
    --and poh.IAPUNO in ('1100001015')</property>
