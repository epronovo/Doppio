        PARTITION BY 
            system_id, 
            system_entity_id, 
            item_num, 
            price_disc_list, 
            pl_effective_start, 
            currency_code, 
            qty_break_01
        ORDER BY 
            effective_start DESC
    ) AS rank_detail,
	GETDATE() AS update_dt
FROM 
    [DW_BGI_OpStage].[dbo].[item_list_price_01]) 
AS Tbl WHERE Tbl.rank_detail=1</property>
