          <DTS:PropertyExpression
            DTS:Name="[M3 - product code descriptions query].[SqlCommand]">"SELECT DISTINCT " + (DT_WSTR, 2)@[User::system_id_for_M3_map] + " AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       1 AS product_code,
       RTRIM(LTRIM(a.MMITCL)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ITCL'
                                    AND CTSTKY = a.MMITCL
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter] + "
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       2 AS product_code,
       RTRIM(LTRIM(a.MMCFI3)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'CFI3'
                                    AND CTSTKY = a.MMCFI3
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter] + "
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       3 AS product_code,
       RTRIM(LTRIM(a.MMBUAR)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'BUAR'
                                    AND CTSTKY = a.MMBUAR
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter] + "UNION ALL SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       4 AS product_code,
       RTRIM(LTRIM(a.MMACRF)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ACRF'
                                    AND CTSTKY = a.MMACRF
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter]</DTS:PropertyExpression>
