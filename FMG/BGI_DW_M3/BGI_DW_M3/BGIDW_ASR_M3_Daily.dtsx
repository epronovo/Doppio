                <component
                  refId="Package\Customers\Load Dropships\Dropship query"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="Dropship query"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select DISTINCT
    33 system_id
    ,CONCAT(RIGHT(CONCAT('000', ISNULL(cust.OKCONO, '')), 3), cfacil.CFDIVI) AS system_entity_id    
	,cust.OKCUNO cust_num   
	,oh.OAORNO [order_no]
    ,addr.ODCUNM [name]
    ,addr.ODCUA1 [address_1]
    ,addr.ODCUA2 [address_2]
    ,addr.ODCUA3 [address_3]
    ,addr.ODCUA4 [address_4]
    ,addr.ODTOWN [city]
    ,addr.ODECAR [state]
    ,addr.ODCSCD [erp_country]
    ,addr.ODPONO [postal_code_1]
    ,cust.OKCRLM [credit_limit]
    ,cust.OKCFC4 [price_list]
    ,cust.OKTEPY [terms_payment_text]
    ,addr.ODMODL [delivery_method]
    ,addr.ODTEDL [terms_shipment_text]
    
    ,cust.OKCFC3 [collect_code] 
    ,cust.OKALCU [system_identifier_1]
    --,oh.[timestamp] 
FROM [OCUSMA] cust
    inner join OOHEAD oh (nolock) on oh.OACONO=cust.OKCONO and oh.OACUNO=cust.OKCUNO
    inner join OOADRE addr (nolock) on addr.ODCONO=oh.OACONO and addr.ODORNO=oh.OAORNO
    inner join CFACIL cfacil (nolock) ON cust.OKFACI = cfacil.CFFACI AND COALESCE(cfacil.deleted ,0 ) = 0  
inner join 
(
    SELECT
        cust.OKCONO
        ,cfacil.CFDIVI
        ,cust.OKCUNO 
        ,addr.ODCUNM 
        ,addr.ODCUA1 
        ,addr.ODCUA2 
        ,addr.ODCUA3
        ,addr.ODCUA4 
        ,addr.ODTOWN 
        ,addr.ODECAR 
        ,addr.ODCSCD 
        ,addr.ODPONO 
        ,MIN(OH.variationNumber)[variationNumber]
    FROM [OCUSMA] cust
        inner join OOHEAD oh (nolock) on oh.OACONO=cust.OKCONO and oh.OACUNO=cust.OKCUNO
        inner join OOADRE addr (nolock) on addr.ODCONO=oh.OACONO and addr.ODORNO=oh.OAORNO
        inner join CFACIL cfacil (nolock) ON cust.OKFACI = cfacil.CFFACI AND COALESCE(cfacil.deleted ,0 ) = 0
    where addr.odadrt=1 
        and coalesce(addr.odadid,'')='' 
        and cust.OKCONO='910'
    GROUP BY
        cust.OKCONO
        ,cust.OKCUNO    
        ,cfacil.CFDIVI
        ,addr.ODCUNM
        ,addr.ODCUA1
        ,addr.ODCUA2
        ,addr.ODCUA3
        ,addr.ODCUA4
        ,addr.ODTOWN
        ,addr.ODECAR
        ,addr.ODCSCD
        ,addr.ODPONO
)t on t.OKCONO=cust.OKCONO 
    and t.CFDIVI=cfacil.CFDIVI and t.OKCUNO=cust.OKCUNO and t.ODCUNM=addr.ODCUNM 
    and t.ODCUA1 = addr.ODCUA1 and t.ODCUA2 = addr.ODCUA2 and t.ODCUA3 = addr.ODCUA3 
    and t.ODCUA4 = addr.ODCUA4 and t.ODTOWN=addr.ODTOWN and t.ODECAR=addr.ODECAR 
    and t.ODCSCD=addr.ODCSCD and t.ODPONO=addr.ODPONO and t.[variationNumber]=oh.variationNumber
where addr.odadrt=1 
    and coalesce(addr.odadid,'')='' 
    and cust.OKCONO='910'</property>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">30</property>
                    <property
                      dataType="System.Boolean"
                      description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                      name="AllowImplicitStringConversion">true</property>
