    <DTS:Executable
      DTS:refId="Package\Invoice Header"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{5877D17D-0B10-4606-B92A-97F4CB67635E}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Invoice Header">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Invoice Header\Load invoice header"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:DelayValidation="True"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{6BBF4536-31F7-4DD0-BD2E-CC85F0428629}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load invoice header"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[M3 Invoice Header Query].[SqlCommand]">"SELECT " + (DT_WSTR, 2)@[User::system_id_for_M3_map] + " AS [system_id], 
       CONCAT(RIGHT(CONCAT('000', ISNULL(I.UHCONO, '')), 3), I.UHDIVI) AS [system_entity_id], 
       I.UHIVNO AS [inv_num], 
       I.UHYEA4 AS [inv_seq], 
       I.UHINPX AS [inv_type], 
       SUBSTRING(CAST(I.UHACDT AS VARCHAR(8)), 1, 4) + SUBSTRING(CAST(I.UHACDT AS VARCHAR(8)), 5, 2) AS [post_period], 
       '' AS [cust_ship_num], 
       '' AS [cust_ship_seq], 
       I.UHPYNO AS [cust_inv_num], 
       '' AS [cust_inv_seq], 
       CAST(SUBSTRING(CAST(I.UHIDAT AS VARCHAR(8)), 1, 4) + '-' + SUBSTRING(CAST(I.UHIDAT AS VARCHAR(8)), 5, 2) + '-' + SUBSTRING(CAST(I.UHIDAT AS VARCHAR(8)), 7, 2) AS DATE) AS [inv_date], 
       I.UHIVAM * I.UHRAIN AS [inv_total], 
       I.UHCUCD AS [currency_code], 
       I.UHRAIN AS [currency_rate], 
       I.UHINST AS [inv_status], 
       C.OKTEPY AS [terms], 
       CAST(I.UHYEA4 AS VARCHAR(4)) + CAST(I.UHIVNO AS VARCHAR(15)) AS doc_ref
FROM OINVOH AS I
     LEFT JOIN OCUSMA AS C ON I.UHCONO = C.OKCONO
                              AND I.UHPYNO = C.OKCUNO
							  AND COALESCE(C.deleted ,0 ) = 0
WHERE CAST(SUBSTRING(CAST(I.UHLMDT AS VARCHAR(8)), 1, 4) + '-' + SUBSTRING(CAST(I.UHLMDT AS VARCHAR(8)), 5, 2) + '-' + SUBSTRING(CAST(I.UHLMDT AS VARCHAR(8)), 7, 2) AS DATE) &gt;= DATEADD(d, -15, GETDATE())
      AND I.UHCONO = " +@[$Package::CompanyParameter] +" AND COALESCE(I.deleted ,0 ) = 0;"</DTS:PropertyExpression>
