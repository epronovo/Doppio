          <DTS:PropertyExpression
            DTS:Name="[ADO NET Source].[SqlCommand]">"select 
	 " + (DT_WSTR, 2)@[User::system_id_for_M3_map] + " as system_id,
	CTCONO + '077' as system_entity_id,
	CTSTCO AS category,
	CTSTKY as [key],
	CTTX40 as [description]
from CSYTAB 
where CTSTCO IN ( 'ACRF','ITGR' )
and CTCONO=" +@[$Package::CompanyParameter] +" AND COALESCE(deleted ,0 ) = 0"</DTS:PropertyExpression>
