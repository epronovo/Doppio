                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">
SELECT  33  as system_id, CONCAT(RIGHT(CONCAT('000', ISNULL(EACONO,'')), 3),EADIVI) as entity_id, '' as ledger_id, EAAITM as acct_id,  EATX40 as description from FCHACC where COALESCE(deleted ,0 ) = 0 AND EAAITP = '1' and EACONO=910</property>
