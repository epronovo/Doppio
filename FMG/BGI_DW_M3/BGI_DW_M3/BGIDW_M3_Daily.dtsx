          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F0CF5496-1B55-4D0C-A4AE-93B2EE7A412F}"
              SQLTask:SqlStatementSource="DECLARE @dt AS DATETIME = DATEADD(d, DATEDIFF(dd, 0, getdate()),-30)&#xA;&#xA;DELETE FROM DW_BGI_Opdata.dbo.po_line&#xA;WHERE system_entity_id = '900077' &#xA;AND update_dt &gt;= @dt" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PO Lines Incremental\PO Lines"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{18995899-5f16-4999-83a2-55fc37b4fde1}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="PO Lines"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\PO Lines Incremental\PO Lines\ADO NET Source"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @dt AS DATETIME = DATEADD(d, DATEDIFF(dd, 0, getdate()),-30)

SELECT 22 AS system_id, 
       CONCAT(RIGHT(CONCAT('000', a.IBCONO), 3), a.IBFACI) AS system_entity_id, 
       IBPUNO AS po_num, 
       IBPNLI AS po_line, 
       IBPNLS AS po_seq, 
       CAST(IBPUSL AS NVARCHAR(10)) AS STATUS, 
       LEFT(RTRIM(IBPITD + ' ' + IBPITT),80) AS po_line_desc, 
       CONVERT(DATE, CAST(IAPUDT AS NVARCHAR(10))) AS po_date, 
       CAST(CONVERT(DATE, CAST(IBVDDT AS NVARCHAR(10))) AS NVARCHAR(10)) AS due_date,
       CASE
           WHEN LEN(IBRCDT) = 10
           THEN CONVERT(DATE, CAST(IBRCDT AS NVARCHAR(10)))
           ELSE NULL
       END AS date_received, 
       IBSUNO AS vendor_num, 
       '' AS vendor_seq, 
       IBITNO AS item_num_internal, 
       '' AS item_num_vendor, 
       IBORQA AS qty_ordered, 
       IBRVQA AS qty_received, 
       b.IACUCD AS currency_code, 
       a.IBLNAM AS extended_price, 
       a.IBPUPR AS unit_price, 
       IBPPUN AS unit_of_measure_order, 
       IBPUUN AS unit_of_measure_stock, 
       a.dlDocumentDate AS update_dt,
	   CASE WHEN b.IACUCD = c.CCLOCD THEN 1 ELSE d.CUARAT END AS rate_lc,
	   a.IBPUPR * CASE WHEN b.IACUCD = c.CCLOCD THEN 1 ELSE d.CUARAT END AS unit_price_lc,
	   a.IBLNAM * CASE WHEN b.IACUCD = c.CCLOCD THEN 1 ELSE d.CUARAT END AS extended_price_lc
FROM MPLINE a
     INNER JOIN MPHEAD b ON a.IBCONO = b.IACONO
                            AND a.IBFACI = b.IAFACI
                            AND a.IBPUNO = b.IAPUNO
                            AND b.deleted = 0
	 INNER JOIN CMNDIV c ON a.IBCONO = c.CCCONO
                            AND a.IBFACI = c.CCDIVI
     LEFT JOIN CCURRA d ON b.IACUCD = d.CUCUCD
                           AND c.CCLOCD = d.CULOCD
                           AND DATEADD(month, DATEDIFF(month, 0, CONVERT(DATE, CAST(IAPUDT AS NVARCHAR(10)))), 0) 
								= CAST(CAST(d.CUCUTD AS VARCHAR(8)) AS DATE)
WHERE IBCONO = '900'
      AND a.deleted = 0
AND a.dlDocumentDate &gt; @dt
AND a.IBPUSL &lt;&gt; 99</property>
                    <property
