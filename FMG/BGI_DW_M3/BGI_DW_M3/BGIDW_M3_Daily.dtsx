    <DTS:Executable
      DTS:refId="Package\Load product codes"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{C79FCA20-7180-4482-B08A-775235C434F7}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load product codes">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Load product codes\Load product codes"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{AC6554EA-1792-4FC6-B413-6EAE7281C27B}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load product codes"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[M3 - product code descriptions query].[SqlCommand]">"SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       1 AS product_code,
       RTRIM(LTRIM(a.MMITCL)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ITCL'
                                    AND CTSTKY = a.MMITCL
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter] + "
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       2 AS product_code,
       RTRIM(LTRIM(a.MMCFI3)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'CFI3'
                                    AND CTSTKY = a.MMCFI3
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter] + "
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       3 AS product_code,
       RTRIM(LTRIM(a.MMBUAR)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'BUAR'
                                    AND CTSTKY = a.MMBUAR
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter] + "UNION ALL SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       4 AS product_code,
       RTRIM(LTRIM(a.MMACRF)) AS code,
       d.CTTX15 AS [description]
FROM MITMAS a
     INNER JOIN MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
									AND COALESCE(b.deleted ,0 ) = 0
     INNER JOIN CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
									AND COALESCE(c.deleted ,0 ) = 0
     INNER JOIN CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ACRF'
                                    AND CTSTKY = a.MMACRF
									AND COALESCE(d.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " +@[$Package::CompanyParameter]</DTS:PropertyExpression>
