        <DTS:Executable
          DTS:refId="Package\Vendors\SQL upsert to DW vendor"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{979ca940-6282-4ee0-afe6-e430d39b1913}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL upsert to DW vendor"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F0CF5496-1B55-4D0C-A4AE-93B2EE7A412F}"
              SQLTask:SqlStatementSource="&#xA;WITH e AS &#xA;( &#xA; SELECT distinct a.[system_id]&#xA;      ,a.[system_entity_id]&#xA;      ,a.[vend_num]&#xA;      --,a.[vend_seq]&#xA;   ,substring(hashbytes('MD5',concat(a.[system_id],a.[system_entity_id],a.[vend_num],a.[name],a.[address_1],a.[address_2],a.[address_3],a.[address_4],a.[address_5],a.[city],a.[state]&#xA;              ,a.[postal_code1],a.[postal_code2] ,a.[erp_country],a.[system_identifier_1],a.[system_identifier_2])),1,6) as vend_seq&#xA;      ,a.[name]&#xA;      ,a.[address_1]&#xA;      ,a.[address_2]&#xA;      ,a.[address_3]&#xA;      ,a.[address_4]&#xA;      ,a.[address_5]&#xA;      ,a.[city]&#xA;      ,a.[state]&#xA;      ,a.[postal_code1]&#xA;      ,a.[postal_code2]&#xA;      ,a.[erp_country]&#xA;      --,a.[active_flag]&#xA;   ,'A' as active_flag&#xA;      ,a.[system_identifier_1]&#xA;      ,a.[system_identifier_2]&#xA;   FROM [dbo].[vendor_M3_staging] a&#xA;   WHERE   a.system_id = 22&#xA;except&#xA;SELECT distinct f.[system_id]&#xA;      ,f.[system_entity_id]&#xA;      ,f.[vend_num]&#xA;        --,f.[vend_seq]&#xA;   ,substring(hashbytes('MD5',concat(f.[system_id],f.[system_entity_id],f.[vend_num],f.[name],f.[address_1],f.[address_2],f.[address_3],f.[address_4],f.[address_5],f.[city],f.[state]&#xA;              ,f.[postal_code1],f.[postal_code2] ,f.[erp_country],f.[system_identifier_1],f.[system_identifier_2])),1,6) as vend_seq&#xA;      ,f.[name]&#xA;      ,f.[address_1]&#xA;      ,f.[address_2]&#xA;      ,f.[address_3]&#xA;      ,f.[address_4]&#xA;      ,f.[address_5]&#xA;      ,f.[city]&#xA;      ,f.[state]&#xA;      ,f.[postal_code1]&#xA;      ,f.[postal_code2]&#xA;      ,f.[erp_country]&#xA;      --,f.[active_flag]&#xA;   ,'A' as active_flag&#xA;      ,f.[system_identifier_1]&#xA;      ,f.[system_identifier_2]&#xA;   FROM  [DW_BGI_OpData].[dbo].[vendor] f&#xA;      WHERE   f.system_id = 22&#xA;) &#xA;&#xA;&#xA;INSERT INTO [dbo].[vendor]&#xA;           ([system_id]&#xA;           ,[system_entity_id]&#xA;           ,[vend_num]&#xA;           ,[vend_seq]&#xA;           ,[name]&#xA;           ,[address_1]&#xA;           ,[address_2]&#xA;           ,[address_3]&#xA;           ,[address_4]&#xA;           ,[address_5]&#xA;           ,[city]&#xA;           ,[state]&#xA;           ,[postal_code1]&#xA;           ,[postal_code2]&#xA;           ,[erp_country]&#xA;           ,[active_flag]&#xA;           ,[system_identifier_1]&#xA;           ,[system_identifier_2]&#xA;           ,[update_dt])&#xA;     &#xA;SELECT distinct e.[system_id]&#xA;      ,e.[system_entity_id]&#xA;      ,e.[vend_num]&#xA;      ,e.[vend_seq]&#xA;      ,e.[name]&#xA;      ,e.[address_1]&#xA;      ,e.[address_2]&#xA;      ,e.[address_3]&#xA;      ,e.[address_4]&#xA;      ,e.[address_5]&#xA;      ,e.[city]&#xA;      ,e.[state]&#xA;      ,e.[postal_code1]&#xA;      ,e.[postal_code2]&#xA;      ,e.[erp_country]&#xA;      --,e.[active_flag]&#xA;   ,'A' as active_flag&#xA;      ,e.[system_identifier_1]&#xA;      ,e.[system_identifier_2]&#xA;      ,getdate() as update_dt&#xA;  FROM e&#xA; --WHERE  e.vend_num = 'SE10000004'&#xA;&#xA;-- delete from [dbo].[vendor] where system_id = 22&#xA;&#xA;&#xA;&#xA;UPDATE  [DW_BGI_OpData].[dbo].[vendor]&#xA;SET     [name] = b.[name]&#xA;      ,[address_1] = b.[address_1]&#xA;      ,[address_2] = b.[address_2]&#xA;      ,[address_3] = b.[address_3]&#xA;      ,[address_4] = b.[address_4]&#xA;      ,[address_5] = b.[address_5]&#xA;      ,[city] = b.[city]&#xA;      ,[state] = b.[state]&#xA;      ,[postal_code1] = b.[postal_code1]&#xA;      ,[postal_code2] = b.[postal_code2]&#xA;      ,[erp_country] = b.[erp_country]&#xA;      ,update_dt = GETDATE()&#xA;FROM    [DW_BGI_OpData].[dbo].[vendor] a&#xA;        INNER JOIN [DW_BGI_OpData].[dbo].[vendor_M3_staging] b on a.system_id = b.system_id&#xA;                                                   AND a.[system_entity_id] = b.[system_entity_id]&#xA;               and a.[vend_num] = b.[vend_num] &#xA;               and a.[vend_seq] = b.[vend_seq]&#xA;WHERE   &#xA;  a.[name] &lt;&gt; b.[name]&#xA;      OR a.[address_1] &lt;&gt; b.[address_1]&#xA;      OR a.[address_2] &lt;&gt; b.[address_2]&#xA;      OR a.[address_3] &lt;&gt; b.[address_3]&#xA;      OR a.[address_4] &lt;&gt; b.[address_4]&#xA;      OR a.[address_5] &lt;&gt; b.[address_5]&#xA;      OR a.[city] &lt;&gt; b.[city]&#xA;      OR a.[state] &lt;&gt; b.[state]&#xA;      OR a.[postal_code1] &lt;&gt; b.[postal_code1]&#xA;      OR a.[postal_code2] &lt;&gt; b.[postal_code2]&#xA;      OR a.[erp_country] &lt;&gt; b.[erp_country]&#xA;   &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
