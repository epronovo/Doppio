        <DTS:Executable
          DTS:refId="Package\Vendors\Load vendor_M3_staging"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{ac2596ba-8207-4afc-91fa-5e022d5a4fe0}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load vendor_M3_staging"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[Schema MVXJDTA Table CIDMAS].[SqlCommand]">"
Select 22 as system_id, CONCAT(RIGHT(CONCAT('000', ISNULL(C.IDCONO,'')), 3),'077') as system_entity_id
       ,C.IDSUNO as vend_num, A.SAADID as vend_seq, 
			C.IDSUNM as name, A.SAADR1 as address_1,A.SAADR2 as address_2,A.SAADR3 as address_3,A.SAADR4 as address_4, '' as address_5,
			A.SATOWN as  city,A.SAECAR as state, A.SAPONO as postal_code1, '' as postal_code2, A.SACSCD as erp_country, C.IDSTAT as active_flag, 
			'' as system_identifier_1, '' as system_identifier_2
			,getdate() as update_dt
	from  CIDMAS as C    
				INNER Join CIDADR as A on C.IDSUNO = A.SASUNO
WHERE     C.IDCONO = " + @[$Package::CompanyParameter] +" AND A.SACONO= " + @[$Package::CompanyParameter] +"
"</DTS:PropertyExpression>
