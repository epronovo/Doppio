    <DTS:Executable
      DTS:refId="Package\customer order full"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{90F2DED0-80B5-4295-BA9A-A5B2A74A4286}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="customer order full">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\customer order full\Delete recent 90 days"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{01082312-720C-47A2-9346-2529C1DC0DEC}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Delete recent 90 days"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F0CF5496-1B55-4D0C-A4AE-93B2EE7A412F}"
              SQLTask:SqlStatementSource="Declare @load_back_date datetime;&#xA;Select @load_back_date = dateadd(day, -90, getdate())&#xA;&#xA;delete &#xA;from DW_BGI_Opdata.dbo.co_line_full &#xA;where system_id = 22 and system_entity_id = '900077'&#xA;and order_date &gt;= @load_back_date" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\customer order full\Load co_line full"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{9df1d349-1ece-48b4-9710-045162cfbb69}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load co_line full"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[select from schema MVXJDTA table OOLINE].[SqlCommand]">"Declare @load_back_date datetime;
Select @load_back_date = dateadd(day, -90, getdate())

SELECT 22 AS [system_id],
       CONCAT(RIGHT(CONCAT('000', ISNULL(O.OBCONO, '')), 3), O.OBDIVI) AS [system_entity_id],
       O.OBORNO AS [co_num],
       O.OBPONR AS [co_line],
       O.OBPOSX AS [co_release],
       O.OBCUNO AS [cust_bill_num],
       '' AS [cust_bill_seq],
       O.OBDECU AS [cust_ship_num],
       O.OBADID AS [cust_ship_seq],
       O.OBITNO AS [item],
       O.OBPOPN AS [cust_item],
       O.OBORQT AS [qty_ordered],
       OBDLQT + OBIVQT AS [qty_shipped],
       O.OBDIP1 AS [disc_pct],
       O.OBDIA1 AS [disc_amt],
       O.OBSAPR AS [price],
       OH.OACUCD AS [currency_code],
       O.OBCUOR AS [cust_po_num],
       O.OBCUPO AS [cust_po_line_num],
       CAST(SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 7, 2) AS DATE) AS [due_date],
       CAST(SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 7, 2) AS DATE) AS [promise_date],
       O.OBORST,
       CASE
           WHEN CAST(O.OBORST AS INT) &gt;= 22
                AND CAST(O.OBORST AS INT) &lt; 67
           THEN 'O'
      WHEN CAST(O.OBORST AS INT) = 99
     THEN 'X'
      ELSE 'C'
       END AS [status],
       '' AS [DPAS_code],
       O.OBCUCT AS [internal_transfer_currency],
	   O.OBORQT  * O.OBSAPR AS [line_value], 
       '' AS [cust_attr1],
       '' AS [cust_attr2],
       '' AS [cust_attr3],
	  COALESCE(R.CUARAT, 1) AS [rate],
	   CAST(O.OBORQT  * O.OBSAPR * COALESCE(R.CUARAT, 1) AS MONEY)  AS [base_line_value],
	   CAST(SUBSTRING(CAST(OH.OAORDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(OH.OAORDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(OH.OAORDT AS VARCHAR(8)), 7, 2) AS DATE) as order_date
FROM OOLINE AS O 
INNER JOIN OOHEAD AS OH 
ON O.OBCONO=OH.OACONO AND O.OBDIVI=OH.OADIVI AND O.OBORNO=OH.OAORNO AND COALESCE(OH.deleted ,0 ) = 0
LEFT JOIN (
SELECT a.CUCONO ,
       a.CUDIVI ,
       a.CUCUCD ,
       a.CUARAT
FROM   CCURRA a
       INNER JOIN (   SELECT   CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP ,
                               MAX(CUCUTD) AS CUCUTD
                      FROM     CCURRA
					  WHERE COALESCE(deleted ,0 ) = 0
                      GROUP BY CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP
                  ) AS b ON a.CUCONO = b.CUCONO
                            AND a.CUDIVI = b.CUDIVI
                            AND a.CUCUCD = b.CUCUCD
                            AND a.CUCRTP = b.CUCRTP
                            AND a.CUCUTD = b.CUCUTD
WHERE  a.CUCRTP = 1 AND COALESCE(a.deleted ,0 ) = 0

) AS R
ON O.OBCONO=R.CUCONO AND O.OBDIVI=R.CUDIVI AND OH.OACUCD=R.CUCUCD
WHERE  COALESCE(O.deleted ,0 ) = 0 
AND CAST(CAST(OH.OAORDT AS nvarchar(8)) AS DATE)  &gt;= @load_back_date AND O.OBCONO=
" + @[$Package::CompanyParameter]</DTS:PropertyExpression>
