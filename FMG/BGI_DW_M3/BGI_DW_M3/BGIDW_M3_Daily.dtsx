        <DTS:Executable
          DTS:refId="Package\Chart of Accounts\Load subAccts tp gl chart of accounts staging"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{360f82d7-3731-470b-8973-fa181b598928}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load subAccts tp gl chart of accounts staging"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[ADO NET Source 1].[SqlCommand]">"SELECT distinct 22 as system_id, CONCAT(RIGHT(CONCAT('000', ISNULL(RKCONO,'')), 3),RKDIVI) as entity_id 

       ,'' as ledger_id
       ,replace(replace(replace(replace(replace(replace(replace(concat(rtrim(RKBIT1),'-',rtrim(RKBIT2),'-',rtrim(RKBIT3),'-',rtrim(RKBIT4),'-',rtrim(RKBIT5),'-',rtrim(RKBIT6),'-',rtrim(RKBIT7),'END'),'------END','') ,'-----END',''),'----END',''),'---END',''),'--END',''),'-END',''),'END','')  as acct_id 

       ,rtrim(RKBIT1) as acct_level1
	   ,rtrim(RKBIT2) as acct_level2
	   ,rtrim(RKBIT3) as acct_level3
	   ,rtrim(RKBIT4) as acct_level4
	   ,rtrim(RKBIT5) as acct_level5
	   ,rtrim(RKBIT6) as acct_level6
	   ,rtrim(RKBIT7) as acct_level7
	   ,concat(a.EATX40,'-',b.EATX40,'-',c.EATX40,'-',d.EATX40,'-',e.EATX40) as description
      
	from FBAKEY as K
	left join FCHACC a on a.EACONO = K.RKCONO
				                             and a.EADIVI = K.RKDIVI
											 and a.EAAITP = '1'
											 and rtrim(a.EAAITM) = rtrim(K.RKBIT1) 
											 and COALESCE(a.deleted ,0 ) = 0
	left join FCHACC b on b.EACONO = K.RKCONO
				                             and b.EADIVI = K.RKDIVI
											 and b.EAAITP = '2'
											 and rtrim(b.EAAITM) = rtrim(K.RKBIT2) 
											 and COALESCE(b.deleted ,0 ) = 0
				left join FCHACC c on c.EACONO = K.RKCONO
				                             and c.EADIVI = K.RKDIVI
											 and c.EAAITP = '3'
											 and rtrim(c.EAAITM) = rtrim(K.RKBIT3) 
											 and COALESCE(c.deleted ,0 ) = 0
				left join FCHACC d on d.EACONO = K.RKCONO
				                             and d.EADIVI = K.RKDIVI
											 and d.EAAITP = '4'
											 and rtrim(d.EAAITM) = rtrim(K.RKBIT4) 
											 and COALESCE(d.deleted ,0 ) = 0
				left join FCHACC e on e.EACONO = K.RKCONO
				                             and e.EADIVI = K.RKDIVI
											 and e.EAAITP = '5'
											 and rtrim(e.EAAITM) = rtrim(K.RKBIT5) 
											 and COALESCE(e.deleted ,0 ) = 0
				left join FCHACC f on f.EACONO = K.RKCONO
				                             and f.EADIVI = K.RKDIVI
											 and f.EAAITP = '6'
											 and rtrim(f.EAAITM) = rtrim(K.RKBIT6) 
											 and COALESCE(f.deleted ,0 ) = 0
				left join FCHACC g on g.EACONO = K.RKCONO
				                             and g.EADIVI = K.RKDIVI
											 and g.EAAITP = '7'
											 and rtrim(g.EAAITM) = rtrim(K.RKBIT7) 
											 and COALESCE(g.deleted ,0 ) = 0
	where  ( rtrim(K.RKBIT2) &lt;&gt; '' OR rtrim(K.RKBIT3) &lt;&gt; ''  OR rtrim(K.RKBIT4) &lt;&gt; ''  OR rtrim(K.RKBIT5) &lt;&gt; '' OR rtrim(K.RKBIT6) &lt;&gt; '' OR rtrim(K.RKBIT7) &lt;&gt; '') 
                       	                          and K.RKBAKY=8 and COALESCE(K.deleted ,0 ) = 0 and  RKCONO=" +@[$Package::CompanyParameter]</DTS:PropertyExpression>
