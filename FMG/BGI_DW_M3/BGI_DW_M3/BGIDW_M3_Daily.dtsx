    <DTS:Executable
      DTS:refId="Package\Items"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{6023391d-8d7b-4794-9d36-273c3fb63b89}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Items">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Items\Select M3 Item Master"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{e2dd8d23-725f-43ad-b6b3-532fb9180112}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Select M3 Item Master"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[schema MVXJDTA  table MITMAS].[SqlCommand]">"SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       RTRIM(LTRIM(a.MMITNO)) AS item_num,
       RTRIM(LTRIM(a.MMITDS)) AS item_desc,
       RTRIM(LTRIM(a.MMITTY)) AS item_type,
       a.MMSTAT AS active_flag,
       RTRIM(LTRIM(a.MMITCL)) AS product_code_1,
       RTRIM(LTRIM(a.MMCFI3)) AS product_code_2,
       RTRIM(LTRIM(a.MMBUAR)) AS product_code_3,
       RTRIM(LTRIM(a.MMPDLN)) AS atrrib_text_1,
       RTRIM(LTRIM(a.MMACRF)) AS atrrib_text_2,
       RTRIM(LTRIM(a.MMITGR)) AS atrrib_text_3,
       b.M9UCOS
FROM MITMAS a
    INNER JOIN MITFAC b
        ON a.MMCONO = b.M9CONO
           AND a.MMITNO = b.M9ITNO
		   AND COALESCE(b.deleted ,0 ) = 0
    INNER JOIN CFACIL c
        ON b.M9CONO = c.CFCONO
           AND b.M9FACI = c.CFFACI
		   AND COALESCE(c.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = " + @[$Package::CompanyParameter] 
+ " AND CAST(SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 1, 4) + '-' + SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 5, 2) + '-'
           + SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 7, 2) AS DATE) &gt;= DATEADD(d, -15, GETDATE())"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Items\Select M3 Item Master\schema MVXJDTA  table MITMAS"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="schema MVXJDTA  table MITMAS"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       RTRIM(LTRIM(a.MMITNO)) AS item_num,
       RTRIM(LTRIM(a.MMITDS)) AS item_desc,
       RTRIM(LTRIM(a.MMITTY)) AS item_type,
       a.MMSTAT AS active_flag,
       RTRIM(LTRIM(a.MMITCL)) AS product_code_1,
       RTRIM(LTRIM(a.MMCFI3)) AS product_code_2,
       RTRIM(LTRIM(a.MMBUAR)) AS product_code_3,
       RTRIM(LTRIM(a.MMPDLN)) AS atrrib_text_1,
       RTRIM(LTRIM(a.MMACRF)) AS atrrib_text_2,
       RTRIM(LTRIM(a.MMITGR)) AS atrrib_text_3,
       b.M9UCOS
FROM MITMAS a
    INNER JOIN MITFAC b
        ON a.MMCONO = b.M9CONO
           AND a.MMITNO = b.M9ITNO
		   AND COALESCE(b.deleted ,0 ) = 0
    INNER JOIN CFACIL c
        ON b.M9CONO = c.CFCONO
           AND b.M9FACI = c.CFFACI
		   AND COALESCE(c.deleted ,0 ) = 0
WHERE COALESCE(a.deleted ,0 ) = 0 AND MMCONO = '900' AND CAST(SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 1, 4) + '-' + SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 5, 2) + '-'
           + SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 7, 2) AS DATE) &gt;= DATEADD(d, -15, GETDATE())</property>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">30</property>
                    <property
                      dataType="System.Boolean"
                      description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                      name="AllowImplicitStringConversion">true</property>
                    <property
