                <component
                  refId="Package\Load product codes\Load product codes\M3 - product code descriptions query"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="M3 - product code descriptions query"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       1 AS product_code,
       RTRIM(LTRIM(a.MMITCL)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ITCL'
                                    AND CTSTKY = a.MMITCL
WHERE MMCONO = '093'
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       2 AS product_code,
       RTRIM(LTRIM(a.MMCFI3)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'CFI3'
                                    AND CTSTKY = a.MMCFI3
WHERE MMCONO = '093'
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       3 AS product_code,
       RTRIM(LTRIM(a.MMBUAR)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'BUAR'
                                    AND CTSTKY = a.MMBUAR
WHERE MMCONO = '093'SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       4 AS product_code,
       RTRIM(LTRIM(a.MMACRF)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ACRF'
                                    AND CTSTKY = a.MMACRF
WHERE MMCONO = '093'</property>
