    <DTS:Executable
      DTS:refId="Package\Sales Order Backlog"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{F653F491-41BD-435F-982A-6CBEB650CD3D}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Sales Order Backlog">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Sales Order Backlog\delete co_line table"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{98E82C28-9FE9-494D-984D-84D3FE3E375E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="delete co_line table"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"
DELETE FROM [dbo].[co_line] WHERE system_id = 22"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{9938E5A1-58F2-41D6-BFFE-4BB7B044E19F}"
              SQLTask:SqlStatementSource="&#xA;DELETE FROM [dbo].[co_line] WHERE system_id = 22" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sales Order Backlog\Load co_line table"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{39438AB0-0004-4572-BC55-C9338C522F54}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load co_line table"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[select from schema MVXJDTA table OOLINE].[SqlCommand]">"SELECT 22 AS [system_id],
       CONCAT(RIGHT(CONCAT('000', ISNULL(O.OBCONO, '')), 3), O.OBDIVI) AS [system_entity_id],
       O.OBORNO AS [co_num],
       O.OBPONR AS [co_line],
       O.OBPOSX AS [co_release],
       O.OBCUNO AS [cust_bill_num],
       '' AS [cust_bill_seq],
       O.OBDECU AS [cust_ship_num],
       O.OBADID AS [cust_ship_seq],
       O.OBITNO AS [item],
       O.OBPOPN AS [cust_item],
       O.OBORQT AS [qty_ordered],
       OBDLQT + OBIVQT AS [qty_shipped],
       O.OBDIP1 AS [disc_pct],
       O.OBDIA1 AS [disc_amt],
       O.OBSAPR AS [price],
       OH.OACUCD AS [currency_code],
       O.OBCUOR AS [cust_po_num],
       O.OBCUPO AS [cust_po_line_num],
       CAST(SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 7, 2) AS DATE) AS [due_date],
       CAST(SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 7, 2) AS DATE) AS [promise_date],
       O.OBORST,
       CASE
           WHEN CAST(O.OBORST AS INT) &gt;= 22
                AND CAST(O.OBORST AS INT) &lt; 67
           THEN 'O'
           ELSE 'C'
       END AS [status],
       '' AS [DPAS_code],
       O.OBCUCT AS [internal_transfer_currency],
	   (O.OBLNAM/O.OBORQT) * (O.OBORQT - (OBDLQT + OBIVQT)) AS [line_value], 
       '' AS [cust_attr1],
       '' AS [cust_attr2],
       '' AS [cust_attr3],
	  COALESCE(R.CUARAT, 1) AS [rate],
       CAST((O.OBLNAM/O.OBORQT) * (O.OBORQT - (OBDLQT + OBIVQT)) * COALESCE(R.CUARAT, 1) AS MONEY)  AS [base_line_value]
FROM MVXJDTA.OOLINE AS O 
INNER JOIN MVXJDTA.OOHEAD AS OH 
ON O.OBCONO=OH.OACONO AND O.OBDIVI=OH.OADIVI AND O.OBORNO=OH.OAORNO
LEFT JOIN (
SELECT a.CUCONO ,
       a.CUDIVI ,
       a.CUCUCD ,
       a.CUARAT
FROM   MVXJDTA.CCURRA a
       INNER JOIN (   SELECT   CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP ,
                               MAX(CUCUTD) AS CUCUTD
                      FROM     MVXJDTA.CCURRA
                      GROUP BY CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP
                  ) AS b ON a.CUCONO = b.CUCONO
                            AND a.CUDIVI = b.CUDIVI
                            AND a.CUCUCD = b.CUCUCD
                            AND a.CUCRTP = b.CUCRTP
                            AND a.CUCUTD = b.CUCUTD
WHERE  a.CUCRTP = 1

) AS R
ON O.OBCONO=R.CUCONO AND O.OBDIVI=R.CUDIVI AND OH.OACUCD=R.CUCUCD
WHERE  O.OBCONO=" + @[$Package::CompanyParameter]</DTS:PropertyExpression>
