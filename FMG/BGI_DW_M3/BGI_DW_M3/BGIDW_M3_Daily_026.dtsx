                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="ADO NET Source 1"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT distinct 22 as system_id, CONCAT(RIGHT(CONCAT('000', ISNULL(RKCONO,'')), 3),RKDIVI) as entity_id 

       ,'' as ledger_id
       ,replace(replace(replace(replace(replace(replace(replace(concat(rtrim(RKBIT1),'-',rtrim(RKBIT2),'-',rtrim(RKBIT3),'-',rtrim(RKBIT4),'-',rtrim(RKBIT5),'-',rtrim(RKBIT6),'-',rtrim(RKBIT7),'END'),'------END','') ,'-----END',''),'----END',''),'---END',''),'--END',''),'-END',''),'END','')  as acct_id 

       ,rtrim(RKBIT1) as acct_level1
	   ,rtrim(RKBIT2) as acct_level2
	   ,rtrim(RKBIT3) as acct_level3
	   ,rtrim(RKBIT4) as acct_level4
	   ,rtrim(RKBIT5) as acct_level5
	   ,rtrim(RKBIT6) as acct_level6
	   ,rtrim(RKBIT7) as acct_level7
	   ,concat(a.EATX40,'-',b.EATX40,'-',c.EATX40,'-',d.EATX40,'-',e.EATX40) as description
      
	from MVXJDTA.FBAKEY as K
	left join MVXJDTA.FCHACC a on a.EACONO = K.RKCONO
				                             and a.EADIVI = K.RKDIVI
											 and a.EAAITP = '1'
											 and rtrim(a.EAAITM) = rtrim(K.RKBIT1) 
											 
	left join MVXJDTA.FCHACC b on b.EACONO = K.RKCONO
				                             and b.EADIVI = K.RKDIVI
											 and b.EAAITP = '2'
											 and rtrim(b.EAAITM) = rtrim(K.RKBIT2) 
				left join MVXJDTA.FCHACC c on c.EACONO = K.RKCONO
				                             and c.EADIVI = K.RKDIVI
											 and c.EAAITP = '3'
											 and rtrim(c.EAAITM) = rtrim(K.RKBIT3) 
				left join MVXJDTA.FCHACC d on d.EACONO = K.RKCONO
				                             and d.EADIVI = K.RKDIVI
											 and d.EAAITP = '4'
											 and rtrim(d.EAAITM) = rtrim(K.RKBIT4) 
				left join MVXJDTA.FCHACC e on e.EACONO = K.RKCONO
				                             and e.EADIVI = K.RKDIVI
											 and e.EAAITP = '5'
											 and rtrim(e.EAAITM) = rtrim(K.RKBIT5) 
				left join MVXJDTA.FCHACC f on f.EACONO = K.RKCONO
				                             and f.EADIVI = K.RKDIVI
											 and f.EAAITP = '6'
											 and rtrim(f.EAAITM) = rtrim(K.RKBIT6) 
				left join MVXJDTA.FCHACC g on g.EACONO = K.RKCONO
				                             and g.EADIVI = K.RKDIVI
											 and g.EAAITP = '7'
											 and rtrim(g.EAAITM) = rtrim(K.RKBIT7) 
	where  ( rtrim(K.RKBIT2) &lt;&gt; '' OR rtrim(K.RKBIT3) &lt;&gt; ''  OR rtrim(K.RKBIT4) &lt;&gt; ''  OR rtrim(K.RKBIT5) &lt;&gt; '' OR rtrim(K.RKBIT6) &lt;&gt; '' OR rtrim(K.RKBIT7) &lt;&gt; '') 
                       	                          and K.RKBAKY=8  and  RKCONO='093'</property>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">30</property>
                    <property
                      dataType="System.Boolean"
                      description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                      name="AllowImplicitStringConversion">true</property>
                    <property
                      dataType="System.String"
                      description="The Source database table name."
                      expressionType="Notify"
                      name="TableOrViewName"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                    <property
                      dataType="System.Int32"
                      description="Specify the mode to retrieve external column information"
                      name="AccessMode"
                      typeConverter="Microsoft.SqlServer.Dts.Pipeline.DataReaderSourceAdapter+EnumToStringConverter">2</property>
                    <property
                      dataType="System.String"
                      name="UserComponentTypeName">Microsoft.DataReaderSourceAdapter</property>
                  </properties>
