                <component
                  refId="Package\Customers\Load customers\M3 customers query"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="M3 customers query"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(a.OPCONO, '')), 3), c.CFDIVI) AS system_entity_id,
       a.OPCUNO AS cust_num,
       a.OPADID AS cust_seq,
       a.OPCUNM AS [name],
       a.OPCUA1 AS address_1,
       a.OPCUA2 AS address_2,
       a.OPCUA3 AS address_3,
       a.OPCUA4 AS address_4,
       a.OPTOWN AS city,
       a.OPECAR AS [state],
       a.OPCSCD AS erp_country,
       a.OPPONO AS postal_code_1
FROM MVXJDTA.OCUSAD AS a
     INNER JOIN MVXJDTA.OCUSMA b ON a.OPCONO = b.OKCONO
                                    AND a.OPCUNO = b.OKCUNO
     INNER JOIN MVXJDTA.CFACIL c ON b.OKFACI = c.CFFACI
WHERE a.OPCONO = '093'
UNION ALL
SELECT DISTINCT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(a.OKCONO, '')), 3), c.CFDIVI) AS system_entity_id,
       a.OKCUNO AS cust_num,
       '' AS cust_seq,
       a.OKCUNM AS [name],
       a.OKCUA1 AS address_1,
       a.OKCUA2 AS address_2,
       a.OKCUA3 AS address_3,
       a.OKCUA4 AS address_4,
       a.OKTOWN AS city,
       a.OKECAR AS [state],
       a.OKCSCD AS erp_country,
       a.OKPONO AS postal_code_1
FROM MVXJDTA.OCUSMA a
     INNER JOIN MVXJDTA.CFACIL c ON a.OKFACI = c.CFFACI
WHERE a.OKCONO = '093'</property>
