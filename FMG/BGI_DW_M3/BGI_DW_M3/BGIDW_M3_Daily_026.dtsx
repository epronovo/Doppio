    <DTS:Executable
      DTS:refId="Package\Invoice Lines"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{52D74FFA-AE77-4552-B13C-1B1CE17E4620}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Invoice Lines">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Invoice Lines\Select M3 Inv Lines"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{3283E8DE-767E-49ED-9749-045041E6D83E}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Select M3 Inv Lines"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[Get lines from schema MVXJDTA table OSBSTD].[SqlCommand]">"SELECT 22 AS [system_id],
       CONCAT(RIGHT(CONCAT('000', ISNULL(I.ONCONO, '')), 3), I.ONDIVI) AS [system_entity_id],
       RIGHT(RTRIM(LTRIM(I.ONIVNO)), 20) AS [inv_num],
       LEFT(RTRIM(LTRIM(I.ONIVRF)), 15) AS [inv_line],
       LEFT(RTRIM(LTRIM(I.ONIVTP)) + ' ' + CAST(ONDLIX AS nvarchar(11)), 15) AS [inv_seq],       CAST(SUBSTRING(CAST(H.UHIDAT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(H.UHIDAT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(H.UHIDAT AS VARCHAR(8)), 7, 2) AS DATE) AS [inv_date],
       RTRIM(LTRIM(COALESCE(S.UCORNO, I.ONORNO))) AS [co_num],
       --RTRIM(LTRIM(COALESCE(CAST(S.UCPONR AS VARCHAR(6)), SUBSTRING(I.ONIVRF, 1, 5) ))) AS [co_line],
	   COALESCE(CAST(S.UCPONR AS NVARCHAR(6)), SUBSTRING(I.ONIVRF, 1, 5)) AS [co_line],
       RTRIM(LTRIM(COALESCE(CAST(S.UCPOSX AS NVARCHAR(6)), ''))) AS [co_release],
       CASE WHEN I.ONIVTP = 60 THEN 'C' WHEN I.ONIVTP = 70 THEN 'R' ELSE '' END AS [line_type],
       RTRIM(LTRIM(O.OBPOPN)) AS [item_customer],
       RTRIM(LTRIM(COALESCE(S.UCITNO, I.ONIVRF))) AS [item_internal],
       S.UCIVQS AS [qty_invoiced],
       CASE
           WHEN COALESCE(S.UCCUCD, H.UHCUCD) != C.CCLOCD
           THEN O.OBUCOS * H.UHRAIN
           ELSE O.OBUCOS
       END [cost],
       CASE
           WHEN COALESCE(S.UCCUCD, H.UHCUCD) != C.CCLOCD
           THEN O.OBSAPR * H.UHRAIN
           ELSE O.OBSAPR
       END [price],
	   CASE WHEN I.ONIVTP = '32' THEN ONIVAM*-1 ELSE ONIVAM END [inv_line_value] ,
	   CASE WHEN rtrim(ltrim(I.ONIVTP)) = '32' THEN ONIVLA*-1 ELSE ONIVLA END [base_line_value] ,
       H.UHRAIN AS [currency_rate] ,
       rtrim(ltrim(COALESCE(S.UCCUCD, H.UHCUCD))) AS [currency_code] ,
	   LEFT(CONCAT(I.ONYEA4, rtrim(ltrim(I.ONIVNO))), 50) AS [doc_ref],
       LTRIM(RTRIM(COALESCE(S.UCDECU, D.UADECU))) AS [cust_ship_num],
       LTRIM(RTRIM(COALESCE(S.UCADID, D.UAADID))) AS [cust_ship_seq]
	   
FROM MVXJDTA.OINVOL AS I
     LEFT JOIN MVXJDTA.OSBSTD AS S ON SUBSTRING(I.ONIVRF, 1, 5) = RIGHT(CONCAT('00000', ISNULL(S.UCPONR, '')), 5)
                                      AND S.UCORNO = I.ONORNO
                                      AND S.UCDLIX = I.ONDLIX
                                      AND S.UCYEA4 = I.ONYEA4
                                      AND S.UCCONO = I.ONCONO
    AND S.UCDIVI = I.ONDIVI    LEFT JOIN MVXJDTA.OOLINE AS O ON S.UCORNO = O.OBORNO
                                      AND S.UCPONR = O.OBPONR
                                      AND S.UCPOSX = O.OBPOSX
                                      AND S.UCCONO = O.OBCONO
     INNER JOIN MVXJDTA.OINVOH AS H ON I.ONCONO = H.UHCONO
                                      AND I.ONDIVI = H.UHDIVI
                                      AND I.ONYEA4 = H.UHYEA4
                                      AND I.ONINPX = H.UHINPX
                                      AND I.ONIVNO = H.UHIVNO
     LEFT JOIN MVXJDTA.CMNDIV AS C ON I.ONCONO = C.CCCONO
                                      AND I.ONDIVI = C.CCDIVI
     LEFT JOIN MVXJDTA.ODHEAD AS D ON I.ONCONO = D.UACONO
                                      AND I.ONORNO = D.UAORNO
                                      AND I.ONDLIX = D.UADLIX
                                      AND I.ONWHLO = D.UAWHLO
                                      AND I.ONTEPY = D.UATEPY
WHERE ONCONO = " +@[$Package::CompanyParameter] +"
	  --invoice line type 31=item,32=discount,60 charge
      AND ONIVTP IN(31, 32, 60, 67, 70)
	  AND H.UHIDAT &gt;= CONVERT(VARCHAR(10), DATEADD(d, -15, GETDATE()), 112)"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Invoice Lines\Select M3 Inv Lines\Get lines from schema MVXJDTA table OSBSTD"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="Get lines from schema MVXJDTA table OSBSTD"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 22 AS [system_id],
       CONCAT(RIGHT(CONCAT('000', ISNULL(I.ONCONO, '')), 3), I.ONDIVI) AS [system_entity_id],
       RIGHT(RTRIM(LTRIM(I.ONIVNO)), 20) AS [inv_num],
       LEFT(RTRIM(LTRIM(I.ONIVRF)), 15) AS [inv_line],
       LEFT(RTRIM(LTRIM(I.ONIVTP)) + ' ' + CAST(ONDLIX AS nvarchar(11)), 15) AS [inv_seq],       CAST(SUBSTRING(CAST(H.UHIDAT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(H.UHIDAT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(H.UHIDAT AS VARCHAR(8)), 7, 2) AS DATE) AS [inv_date],
       RTRIM(LTRIM(COALESCE(S.UCORNO, I.ONORNO))) AS [co_num],
       --RTRIM(LTRIM(COALESCE(CAST(S.UCPONR AS VARCHAR(6)), SUBSTRING(I.ONIVRF, 1, 5) ))) AS [co_line],
	   COALESCE(CAST(S.UCPONR AS NVARCHAR(6)), SUBSTRING(I.ONIVRF, 1, 5)) AS [co_line],
       RTRIM(LTRIM(COALESCE(CAST(S.UCPOSX AS NVARCHAR(6)), ''))) AS [co_release],
       CASE WHEN I.ONIVTP = 60 THEN 'C' WHEN I.ONIVTP = 70 THEN 'R' ELSE '' END AS [line_type],
       RTRIM(LTRIM(O.OBPOPN)) AS [item_customer],
       RTRIM(LTRIM(COALESCE(S.UCITNO, I.ONIVRF))) AS [item_internal],
       S.UCIVQS AS [qty_invoiced],
       CASE
           WHEN COALESCE(S.UCCUCD, H.UHCUCD) != C.CCLOCD
           THEN O.OBUCOS * H.UHRAIN
           ELSE O.OBUCOS
       END [cost],
       CASE
           WHEN COALESCE(S.UCCUCD, H.UHCUCD) != C.CCLOCD
           THEN O.OBSAPR * H.UHRAIN
           ELSE O.OBSAPR
       END [price],
	   CASE WHEN I.ONIVTP = '32' THEN ONIVAM*-1 ELSE ONIVAM END [inv_line_value] ,
	   CASE WHEN rtrim(ltrim(I.ONIVTP)) = '32' THEN ONIVLA*-1 ELSE ONIVLA END [base_line_value] ,
       H.UHRAIN AS [currency_rate] ,
       rtrim(ltrim(COALESCE(S.UCCUCD, H.UHCUCD))) AS [currency_code] ,
	   LEFT(CONCAT(I.ONYEA4, rtrim(ltrim(I.ONIVNO))), 50) AS [doc_ref],
       LTRIM(RTRIM(COALESCE(S.UCDECU, D.UADECU))) AS [cust_ship_num],
       LTRIM(RTRIM(COALESCE(S.UCADID, D.UAADID))) AS [cust_ship_seq]
	   
FROM MVXJDTA.OINVOL AS I
     LEFT JOIN MVXJDTA.OSBSTD AS S ON SUBSTRING(I.ONIVRF, 1, 5) = RIGHT(CONCAT('00000', ISNULL(S.UCPONR, '')), 5)
                                      AND S.UCORNO = I.ONORNO
                                      AND S.UCDLIX = I.ONDLIX
                                      AND S.UCYEA4 = I.ONYEA4
                                      AND S.UCCONO = I.ONCONO
    AND S.UCDIVI = I.ONDIVI    LEFT JOIN MVXJDTA.OOLINE AS O ON S.UCORNO = O.OBORNO
                                      AND S.UCPONR = O.OBPONR
                                      AND S.UCPOSX = O.OBPOSX
                                      AND S.UCCONO = O.OBCONO
     INNER JOIN MVXJDTA.OINVOH AS H ON I.ONCONO = H.UHCONO
                                      AND I.ONDIVI = H.UHDIVI
                                      AND I.ONYEA4 = H.UHYEA4
                                      AND I.ONINPX = H.UHINPX
                                      AND I.ONIVNO = H.UHIVNO
     LEFT JOIN MVXJDTA.CMNDIV AS C ON I.ONCONO = C.CCCONO
                                      AND I.ONDIVI = C.CCDIVI
     LEFT JOIN MVXJDTA.ODHEAD AS D ON I.ONCONO = D.UACONO
                                      AND I.ONORNO = D.UAORNO
                                      AND I.ONDLIX = D.UADLIX
                                      AND I.ONWHLO = D.UAWHLO
                                      AND I.ONTEPY = D.UATEPY
WHERE ONCONO = '093'
	  --invoice line type 31=item,32=discount,60 charge
      AND ONIVTP IN(31, 32, 60, 67, 70)
	  AND H.UHIDAT &gt;= CONVERT(VARCHAR(10), DATEADD(d, -15, GETDATE()), 112)</property>
