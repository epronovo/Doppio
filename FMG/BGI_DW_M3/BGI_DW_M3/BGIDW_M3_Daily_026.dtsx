          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{9938E5A1-58F2-41D6-BFFE-4BB7B044E19F}"
              SQLTask:SqlStatementSource="DELETE FROM [dbo].[gl]&#xA;WHERE system_id = 22&#xA;      AND (   acct_period = CAST(YEAR(GETDATE()) AS VARCHAR(4))&#xA;                            + RIGHT('0'&#xA;                                    + CAST(MONTH(GETDATE()) AS VARCHAR(2)), 2)&#xA;              OR acct_period = CAST(YEAR(DATEADD(d, -15, GETDATE())) AS VARCHAR(4))&#xA;                               + RIGHT('0'&#xA;                                       + CAST(MONTH(DATEADD(d, -15, GETDATE())) AS VARCHAR(2)), 2)&#xA;          )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Load GL Lines\Load GL detail"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{D8B75A84-3EAC-4A3E-AA48-5426166E9CC2}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load GL detail"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[db M3FDBGRD schema MVXJDTA table FGLEDG].[SqlCommand]">"SELECT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(EGCONO, '')), 3), EGDIVI) AS system_entity_id,
       EGJRNO AS batch_num,
       EGJSNO AS batch_seq,
       F.EGTDSC AS batch_source,
       C.CDCYP1 AS acct_period,
       replace(replace(replace(replace(replace(replace(replace(concat(RTRIM(EGAIT1), '-', RTRIM(EGAIT2), '-', RTRIM(EGAIT3), '-', RTRIM(EGAIT4), '-', RTRIM(EGAIT5), '-', RTRIM(EGAIT6), '-', RTRIM(EGAIT7), 'END'), '------END', ''), '-----END', ''), '----END', ''), '---END', ''), '--END', ''), '-END', ''), 'END', '') AS acct_id,
       '' AS pj_acct_id,
       '' AS category_account,
       F.EGTRCD AS trans_code,
       LEFT(F.EGACDT, 4)+'-'+SUBSTRING(CONVERT(NVARCHAR, F.EGACDT), 5, 2)+'-'+SUBSTRING(CONVERT(NVARCHAR, F.EGACDT), 7, 2) AS trans_date,
       F.EGVTXT AS trans_desc,
       CASE
           WHEN F.EGACAM &lt; 0
           THEN 'C'
           ELSE 'D'
       END db_cr,
       (F.EGACAM * -1) AS trans_amount,
       '' AS cust_num
       ,  
		   --,F.[EGVRNO] as doc_ref
       CASE
           WHEN SUBSTRING(F.EGVTXT, 17, 2) in ('77', '99')
           THEN concat(SUBSTRING(CAST(F.EGACDT AS NVARCHAR(8)), 1, 4), SUBSTRING(F.EGVTXT, 17, 9))
           ELSE ''
       END doc_ref,
       EGYEA4 AS [doc_ref_seq]
FROM MVXJDTA.FGLEDG AS F
     INNER JOIN MVXJDTA.CSYCAL AS C ON F.EGCONO = C.CDCONO
                                       AND F.EGDIVI = C.CDDIVI
                                       AND F.EGACDT = C.CDYMD8
WHERE F.EGCONO=" + @[$Package::CompanyParameter] +" AND (C.CDCYP1 = CAST(YEAR(GETDATE()) AS VARCHAR(4))+RIGHT('0'+CAST(MONTH(GETDATE()) AS VARCHAR(2)), 2)
           OR C.CDCYP1 = CAST(YEAR(DATEADD(d, -15, GETDATE())) AS VARCHAR(4))+RIGHT('0'+CAST(MONTH(DATEADD(d, -15, GETDATE())) AS VARCHAR(2)), 2)); "</DTS:PropertyExpression>
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Load GL Lines\Load GL detail\db M3FDBGRD schema MVXJDTA table FGLEDG"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="db M3FDBGRD schema MVXJDTA table FGLEDG"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(EGCONO, '')), 3), EGDIVI) AS system_entity_id,
       EGJRNO AS batch_num,
       EGJSNO AS batch_seq,
       F.EGTDSC AS batch_source,
       C.CDCYP1 AS acct_period,
       replace(replace(replace(replace(replace(replace(replace(concat(RTRIM(EGAIT1), '-', RTRIM(EGAIT2), '-', RTRIM(EGAIT3), '-', RTRIM(EGAIT4), '-', RTRIM(EGAIT5), '-', RTRIM(EGAIT6), '-', RTRIM(EGAIT7), 'END'), '------END', ''), '-----END', ''), '----END', ''), '---END', ''), '--END', ''), '-END', ''), 'END', '') AS acct_id,
       '' AS pj_acct_id,
       '' AS category_account,
       F.EGTRCD AS trans_code,
       LEFT(F.EGACDT, 4)+'-'+SUBSTRING(CONVERT(NVARCHAR, F.EGACDT), 5, 2)+'-'+SUBSTRING(CONVERT(NVARCHAR, F.EGACDT), 7, 2) AS trans_date,
       F.EGVTXT AS trans_desc,
       CASE
           WHEN F.EGACAM &lt; 0
           THEN 'C'
           ELSE 'D'
       END db_cr,
       (F.EGACAM * -1) AS trans_amount,
       '' AS cust_num
       ,  
		   --,F.[EGVRNO] as doc_ref
       CASE
           WHEN SUBSTRING(F.EGVTXT, 17, 2) in ('77', '99')
           THEN concat(SUBSTRING(CAST(F.EGACDT AS NVARCHAR(8)), 1, 4), SUBSTRING(F.EGVTXT, 17, 9))
           ELSE ''
       END doc_ref,
       EGYEA4 AS [doc_ref_seq]
FROM MVXJDTA.FGLEDG AS F
     INNER JOIN MVXJDTA.CSYCAL AS C ON F.EGCONO = C.CDCONO
                                       AND F.EGDIVI = C.CDDIVI
                                       AND F.EGACDT = C.CDYMD8
WHERE F.EGCONO='093' AND (C.CDCYP1 = CAST(YEAR(GETDATE()) AS VARCHAR(4))+RIGHT('0'+CAST(MONTH(GETDATE()) AS VARCHAR(2)), 2)
           OR C.CDCYP1 = CAST(YEAR(DATEADD(d, -15, GETDATE())) AS VARCHAR(4))+RIGHT('0'+CAST(MONTH(DATEADD(d, -15, GETDATE())) AS VARCHAR(2)), 2)); </property>
