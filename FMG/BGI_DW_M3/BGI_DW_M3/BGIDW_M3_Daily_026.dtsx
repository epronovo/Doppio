                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       RTRIM(LTRIM(a.MMITNO)) AS item_num,
       RTRIM(LTRIM(a.MMITDS)) AS item_desc,
       RTRIM(LTRIM(a.MMITTY)) AS item_type,
       a.MMSTAT AS active_flag,
       RTRIM(LTRIM(a.MMITCL)) AS product_code_1,
       RTRIM(LTRIM(a.MMCFI3)) AS product_code_2,
       RTRIM(LTRIM(a.MMBUAR)) AS product_code_3,
       RTRIM(LTRIM(a.MMPDLN)) AS atrrib_text_1
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
WHERE CAST(SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(a.MMLMDT AS VARCHAR(8)), 7, 2) AS DATE) &gt;= DATEADD(d, -15, GETDATE())
      AND MMCONO = '093'</property>
