            <SQLTask:SqlTaskData
              SQLTask:Connection="{9938E5A1-58F2-41D6-BFFE-4BB7B044E19F}"
              SQLTask:SqlStatementSource="-- GL Chart of ACcounts&#xA;INSERT INTO [DW_BGI_OpData].dbo.gl_chart_of_account&#xA;           ([system_id]&#xA;           ,[system_entity_id]&#xA;           ,[ledger_id]&#xA;           ,[acct_id]&#xA;           ,[internal_acct_id]&#xA;           ,[type]&#xA;           ,[currency]&#xA;           ,[description]&#xA;           ,[eff_date]&#xA;           ,[obs_date]&#xA;           ,[BPC_extractflag]&#xA;           ,[cat_acct]&#xA;           ,[acct_level1]&#xA;           ,[acct_level2]&#xA;           ,[acct_level3]&#xA;           ,[acct_level4]&#xA;           ,[acct_level5]&#xA;&#x9;&#x9;   ,[acct_level6]&#xA;           ,[acct_level7]&#xA;           ,[control_account]&#xA;           ,[reports_to_acct]&#xA;           ,[acct_display]&#xA;           ,[date_inserted])&#xA;&#xA;       SELECT  distinct &#xA;           a.[system_id]&#xA;           ,a.[system_entity_id]&#xA;           ,COALESCE(RTRIM(b.[ledger_id]),'')  as ledger_id&#xA;           ,a.[acct_id]&#xA;           ,a.[internal_acct_id]&#xA;           ,a.[type]&#xA;           ,a.[currency]&#xA;           ,a.[description]&#xA;           ,a.[eff_date]&#xA;           ,a.[obs_date]&#xA;           ,a.[BPC_extractflag]&#xA;           ,a.[cat_acct]&#xA;           ,a.[acct_level1]&#xA;           ,a.[acct_level2]&#xA;           ,a.[acct_level3]&#xA;           ,a.[acct_level4]&#xA;           ,a.[acct_level5]&#xA;&#x9;&#x9;   ,a.[acct_level6]&#xA;           ,a.[acct_level7]&#xA;           ,a.[control_account]&#xA;           ,a.[reports_to_acct]&#xA;           ,a.[acct_display]&#xA;           ,GETDATE() as date_inserted &#x9;&#x9;&#x9;&#xA;                &#xA;        FROM    [DW_BGI_OpData].dbo.gl_chart_of_account_stage a&#xA;                LEFT JOIN  [DW_BGI_OpData].dbo.gl_chart_of_account b ON a.system_id = b.system_id&#xA;                                                   AND a.[system_entity_id] = b.[system_entity_id]&#xA;                                                   AND a.ledger_id = b.ledger_id&#xA;                                                   AND  a.acct_id = b.acct_id&#xA;        WHERE   a.system_id = 22&#xA;       AND (b.acct_id IS NULL or b.acct_id  = '') -- no acct_id, thus do the insert&#xA;&#xA;UPDATE  [DW_BGI_OpData].dbo.gl_chart_of_account&#xA;SET     [description] = b.[description],&#xA;            [currency] = b.[currency],&#xA;             date_inserted = GETDATE()&#xA;FROM    [DW_BGI_OpData].dbo.gl_chart_of_account a&#xA;        INNER JOIN [DW_BGI_OpData].dbo.gl_chart_of_account_stage b ON a.system_id = b.system_id&#xA;                                                  AND a.[system_entity_id] = b.[system_entity_id]&#xA;                                                  AND a.ledger_id = b.ledger_id&#xA;                                                  AND a.acct_id = b.acct_id&#xA;WHERE   a.currency &lt;&gt; b.currency&#xA;        OR a.[description] &lt;&gt; b.[description]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
