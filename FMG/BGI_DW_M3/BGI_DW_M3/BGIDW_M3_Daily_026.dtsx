                <component
                  refId="Package\Sales Order Backlog\Load co_line table\select from schema MVXJDTA table OOLINE"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="select from schema MVXJDTA table OOLINE"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 22 AS [system_id],
       CONCAT(RIGHT(CONCAT('000', ISNULL(O.OBCONO, '')), 3), O.OBDIVI) AS [system_entity_id],
       O.OBORNO AS [co_num],
       O.OBPONR AS [co_line],
       O.OBPOSX AS [co_release],
       O.OBCUNO AS [cust_bill_num],
       '' AS [cust_bill_seq],
       O.OBDECU AS [cust_ship_num],
       O.OBADID AS [cust_ship_seq],
       O.OBITNO AS [item],
       O.OBPOPN AS [cust_item],
       O.OBORQT AS [qty_ordered],
       OBDLQT + OBIVQT AS [qty_shipped],
       O.OBDIP1 AS [disc_pct],
       O.OBDIA1 AS [disc_amt],
       O.OBSAPR AS [price],
       OH.OACUCD AS [currency_code],
       O.OBCUOR AS [cust_po_num],
       O.OBCUPO AS [cust_po_line_num],
       CAST(SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBDWDT AS VARCHAR(8)), 7, 2) AS DATE) AS [due_date],
       CAST(SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 1, 4)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 5, 2)+'-'+SUBSTRING(CAST(O.OBCODT AS VARCHAR(8)), 7, 2) AS DATE) AS [promise_date],
       O.OBORST,
       CASE
           WHEN CAST(O.OBORST AS INT) &gt;= 22
                AND CAST(O.OBORST AS INT) &lt; 67
           THEN 'O'
           ELSE 'C'
       END AS [status],
       '' AS [DPAS_code],
       O.OBCUCT AS [internal_transfer_currency],
	   (O.OBLNAM/O.OBORQT) * (O.OBORQT - (OBDLQT + OBIVQT)) AS [line_value], 
       '' AS [cust_attr1],
       '' AS [cust_attr2],
       '' AS [cust_attr3],
	  COALESCE(R.CUARAT, 1) AS [rate],
       CAST((O.OBLNAM/O.OBORQT) * (O.OBORQT - (OBDLQT + OBIVQT)) * COALESCE(R.CUARAT, 1) AS MONEY)  AS [base_line_value]
FROM MVXJDTA.OOLINE AS O 
INNER JOIN MVXJDTA.OOHEAD AS OH 
ON O.OBCONO=OH.OACONO AND O.OBDIVI=OH.OADIVI AND O.OBORNO=OH.OAORNO
LEFT JOIN (
SELECT a.CUCONO ,
       a.CUDIVI ,
       a.CUCUCD ,
       a.CUARAT
FROM   MVXJDTA.CCURRA a
       INNER JOIN (   SELECT   CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP ,
                               MAX(CUCUTD) AS CUCUTD
                      FROM     MVXJDTA.CCURRA
                      GROUP BY CUCONO ,
                               CUDIVI ,
                               CUCUCD ,
                               CUCRTP
                  ) AS b ON a.CUCONO = b.CUCONO
                            AND a.CUDIVI = b.CUDIVI
                            AND a.CUCUCD = b.CUCUCD
                            AND a.CUCRTP = b.CUCRTP
                            AND a.CUCUTD = b.CUCUTD
WHERE  a.CUCRTP = 1

) AS R
ON O.OBCONO=R.CUCONO AND O.OBDIVI=R.CUDIVI AND OH.OACUCD=R.CUCUCD
WHERE  O.OBCONO='093'</property>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">30</property>
