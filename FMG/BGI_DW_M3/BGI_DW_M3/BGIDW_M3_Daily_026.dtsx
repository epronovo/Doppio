    <DTS:Executable
      DTS:refId="Package\GL Chart of Account Balances"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{2D58BFD6-116D-4058-824B-150FDE0B2B6A}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="GL Chart of Account Balances">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\GL Chart of Account Balances\Load gl account balances"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{2ED82383-D971-4C8B-AADB-CD1EC70D9F5C}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load gl account balances"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[GL account balances - Source].[SqlCommand]">"SELECT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(RKCONO, '')), 3), RKDIVI) AS [entity_id],
       replace(replace(replace(concat(RTRIM(RKBIT1), '-', RTRIM(RKBIT2), '-', RTRIM(RKBIT7), 'END'), '--END', ''), '-END', ''), 'END', '') AS acct_id,
       RKBIT1 AS acct_id_1,
       RKBIT2 AS acct_id_2,
       RKBIT7 AS acct_id_7,
       tbl_b.acct_period,
       SUM(CASE
               WHEN tbl_a.acct_period = tbl_b.acct_period
               THEN RVACAD
               ELSE 0
           END) AS net_amount_debit,
       SUM(CASE
               WHEN tbl_a.acct_period = tbl_b.acct_period
               THEN RVACAC
               ELSE 0
           END) AS net_amount_credit,
       SUM(RVACAD) AS fy_amount_debit,
       SUM(RVACAC) AS fy_amount_credit,
       SUM(CASE
               WHEN tbl_a.RVPERI &lt;&gt; 0
               THEN RVACAD
               ELSE 0
           END) AS cy_amount_debit,
       SUM(CASE
               WHEN tbl_a.RVPERI &lt;&gt; 0
               THEN RVACAC
               ELSE 0
           END) AS cy_amount_credit
FROM
(
    SELECT K.*,
           B.*,
           C.EAAT01 AS BSACCT,
           C.EAAT02 AS PLACCT,
           CAST(CAST(RVYEA4 AS VARCHAR(4))+RIGHT('00'+CAST(RVPERI AS VARCHAR(2)), 2) AS INT) AS acct_period
    FROM MVXJDTA.FBAKEY AS K
         JOIN MVXJDTA.FBAVAL AS B ON B.RVBAKY = K.RKBAKY
                                     AND K.RKPTID = B.RVPTID
                                     AND K.RKBAKY = 8
                                     AND K.RKCONO = B.RVCONO
         JOIN MVXJDTA.FCHACC AS C ON K.RKCONO = C.EACONO
                                     AND K.RKDIVI = C.EADIVI
                                     AND K.RKBIT1 = C.EAAITM
                                     AND C.EAAITP = '1'
    WHERE RKCONO = " + @[$Package::CompanyParameter] + "
) AS tbl_a
CROSS JOIN
(
    SELECT DISTINCT
           CAST(CAST(RVYEA4 AS VARCHAR(4))+RIGHT('00'+CAST(RVPERI AS VARCHAR(2)), 2) AS INT) AS acct_period
    FROM MVXJDTA.FBAVAL
    WHERE RVCONO = " + @[$Package::CompanyParameter] + "
          AND ((RVYEA4 = YEAR(GETDATE())
                AND RVPERI = MONTH(GETDATE()))
               OR (RVYEA4 = YEAR(DATEADD(d, -15, GETDATE()))
                   AND RVPERI = MONTH(DATEADD(d, -15, GETDATE()))))
) AS tbl_b
WHERE(--tbl_a.PLACCT = 0
      --AND tbl_a.acct_period &lt;= tbl_b.acct_period)
     --OR (tbl_a.PLACCT = 1
     --    AND 
	 tbl_a.acct_period &lt;= tbl_b.acct_period
         AND tbl_a.RVYEA4 = LEFT(tbl_b.acct_period, 4)) 
GROUP BY CONCAT(RIGHT(CONCAT('000', ISNULL(RKCONO, '')), 3), RKDIVI),
         replace(replace(replace(concat(RTRIM(RKBIT1), '-', RTRIM(RKBIT2), '-', RTRIM(RKBIT7), 'END'), '--END', ''), '-END', ''), 'END', ''),
         RKBIT1,
         RKBIT2,
         RKBIT7,
         tbl_b.acct_period;"</DTS:PropertyExpression>
