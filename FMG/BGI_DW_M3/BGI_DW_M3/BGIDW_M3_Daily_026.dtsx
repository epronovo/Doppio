    <DTS:Executable
      DTS:refId="Package\Load product codes"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{62CD112D-1829-40F9-8DA8-657C3A11AADA}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load product codes">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Load product codes\Load product codes"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{23332AC1-1892-48C3-9A33-DD6F58BE9EC2}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load product codes"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[M3 - product code descriptions query].[SqlCommand]">"SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       1 AS product_code,
       RTRIM(LTRIM(a.MMITCL)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ITCL'
                                    AND CTSTKY = a.MMITCL
WHERE MMCONO = " +@[$Package::CompanyParameter] + "
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       2 AS product_code,
       RTRIM(LTRIM(a.MMCFI3)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'CFI3'
                                    AND CTSTKY = a.MMCFI3
WHERE MMCONO = " +@[$Package::CompanyParameter] + "
UNION ALL
SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       3 AS product_code,
       RTRIM(LTRIM(a.MMBUAR)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'BUAR'
                                    AND CTSTKY = a.MMBUAR
WHERE MMCONO = " +@[$Package::CompanyParameter] + "SELECT DISTINCT
       22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', a.MMCONO), 3), c.CFDIVI) AS system_entity_id,
       4 AS product_code,
       RTRIM(LTRIM(a.MMACRF)) AS code,
       d.CTTX15 AS [description]
FROM MVXJDTA.MITMAS a
     INNER JOIN MVXJDTA.MITFAC b ON a.MMCONO = b.M9CONO
                                    AND a.MMITNO = b.M9ITNO
     INNER JOIN MVXJDTA.CFACIL c ON b.M9CONO = c.CFCONO
                                    AND b.M9FACI = c.CFFACI
     INNER JOIN MVXJDTA.CSYTAB d ON a.MMCONO = CTCONO
                                    AND d.CTSTCO = 'ACRF'
                                    AND CTSTKY = a.MMACRF
WHERE MMCONO = " +@[$Package::CompanyParameter]</DTS:PropertyExpression>
