      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Customers\Load customers"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{9C680F08-EEB7-43A3-B729-EDC645AC4C95}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load customers"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:PropertyExpression
            DTS:Name="[M3 customers query].[SqlCommand]">"SELECT DISTINCT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(a.OPCONO, '')), 3), c.CFDIVI) AS system_entity_id,
       a.OPCUNO AS cust_num,
       a.OPADID AS cust_seq,
       a.OPCUNM AS [name],
       a.OPCUA1 AS address_1,
       a.OPCUA2 AS address_2,
       a.OPCUA3 AS address_3,
       a.OPCUA4 AS address_4,
       a.OPTOWN AS city,
       a.OPECAR AS [state],
       a.OPCSCD AS erp_country,
       a.OPPONO AS postal_code_1
FROM MVXJDTA.OCUSAD AS a
     INNER JOIN MVXJDTA.OCUSMA b ON a.OPCONO = b.OKCONO
                                    AND a.OPCUNO = b.OKCUNO
     INNER JOIN MVXJDTA.CFACIL c ON b.OKFACI = c.CFFACI
WHERE a.OPCONO = " + @[$Package::CompanyParameter] + "
UNION ALL
SELECT DISTINCT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(a.OKCONO, '')), 3), c.CFDIVI) AS system_entity_id,
       a.OKCUNO AS cust_num,
       '' AS cust_seq,
       a.OKCUNM AS [name],
       a.OKCUA1 AS address_1,
       a.OKCUA2 AS address_2,
       a.OKCUA3 AS address_3,
       a.OKCUA4 AS address_4,
       a.OKTOWN AS city,
       a.OKECAR AS [state],
       a.OKCSCD AS erp_country,
       a.OKPONO AS postal_code_1
FROM MVXJDTA.OCUSMA a
     INNER JOIN MVXJDTA.CFACIL c ON a.OKFACI = c.CFFACI
WHERE a.OKCONO = " + @[$Package::CompanyParameter]</DTS:PropertyExpression>
