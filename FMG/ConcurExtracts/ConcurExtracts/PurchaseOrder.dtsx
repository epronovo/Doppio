        /// <summary>
        /// Record Type 220
        /// </summary>
        /// <param name="purchase_order_number"></param>
        /// <returns></returns>
        private ShipToAddress GetShipToAddress(string purchase_order_number)
        {
            ShipToAddress shipToAddress = null;

            using (SqlConnection cnn1 = new SqlConnection(ConnectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("App_Concur.dbo.p_concurinvoicepo_get_poshipto", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@po_num", purchase_order_number);
                        

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                shipToAddress = new ShipToAddress
                                {
                                    record_type = reader["record_type"].ToString(),
                                    external_id = reader["external_id"].ToString(),
                                    name = reader["name"].ToString(),
                                    address_1 = reader["address_1"].ToString(),
                                    address_2 = reader["address_2"].ToString(),
                                    address_3 = reader["address_3"].ToString(),
                                    city = reader["city"].ToString(),
                                    state = reader["state"].ToString(),
                                    postal_code = reader["postal_code"].ToString(),
                                    country_code = reader["country_code"].ToString(),
                                    future_use_1 = reader["future_use_1"].ToString(),
                                    future_use_2 = reader["future_use_2"].ToString(),
                                    future_use_3 = reader["future_use_3"].ToString(),
                                    future_use_4 = reader["future_use_4"].ToString(),
                                    future_use_5 = reader["future_use_5"].ToString(),
                                    future_use_6 = reader["future_use_6"].ToString(),
                                    future_use_7 = reader["future_use_7"].ToString(),
                                    future_use_8 = reader["future_use_8"].ToString(),
                                    future_use_9 = reader["future_use_9"].ToString(),
                                    future_use_10 = reader["future_use_10"].ToString(),
                                };

                            }
                        }
                    }
                }
                catch (Exception)
                {

                    throw;
                }
            }

            return shipToAddress;
        }

        /// <summary>
        /// Record Type 210
        /// </summary>
        /// <param name="purchase_order_number"></param>
        /// <returns></returns>
        private BillToAddress GetBillToAddress(string purchase_order_number)
        {
            BillToAddress billToAddress = null;

            using (SqlConnection cnn1 = new SqlConnection(ConnectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("App_Concur.dbo.p_concurinvoicepo_get_pobillto", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@po_num", purchase_order_number);
                        

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                billToAddress = new BillToAddress
                                {
                                    record_type = reader["record_type"].ToString(),
                                    external_id = reader["external_id"].ToString(),
