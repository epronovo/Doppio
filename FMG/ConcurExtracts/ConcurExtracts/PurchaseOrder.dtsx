        private void WriteFlatFile<T>(List<T> records, string path)
        {
            var lines = new List<string>();
            IEnumerable<PropertyDescriptor> props = TypeDescriptor.GetProperties(typeof(T)).OfType<PropertyDescriptor>();

            var propertyName = string.Join(",", props.ToList().Select(x => x.Name));
            var valueLines = records.Select(row => string.Join(",", propertyName.Split(',').Select(a => row.GetType().GetProperty(a).GetValue(row, null))));
            lines.AddRange(valueLines);
            File.AppendAllLines(path, lines.ToArray());
        }

        private void WriteFlatFile<T>(T records, string path)
        {
            var lines = new List<string>();
            IEnumerable<PropertyDescriptor> props = TypeDescriptor.GetProperties(typeof(T)).OfType<PropertyDescriptor>();
            var propertyName = string.Join(",", props.ToList().Select(x => x.Name));
            
            string[] _recordsObject = records.GetType()
                .GetProperties()
                .Select(p => 
                    { 
                        object value = p.GetValue(records, null);
                        return value == null ? null : value.ToString();
                    }).ToArray();


            var valueLines = string.Join(",", _recordsObject);

            File.AppendAllText(path, valueLines + Environment.NewLine);

        }

    

     

        private void SetProperties()
        {

            var conn = Dts.Connections["App_Concur"].ConnectionString;
            var connBldr = new OleDbConnectionStringBuilder(conn);
            connBldr.Remove("provider");
            connBldr.Remove("auto translate");
            ConnectionString = connBldr.ConnectionString;
            //ConnectionString = Dts.Variables["CNN_SQLMI_ADO_DW"].Value.ToString();
            
            FlatFileVendor = Dts.Variables["FF_Vendor"].Value.ToString();
            EntityCode = Dts.Variables["varEntityCode"].Value.ToString();
            FlatFileVendor = FlatFileVendor.Replace("[entitycode]", EntityCode).Replace(".txt", DateTime.Now.ToString("yyyyMMddHHmmss")) + ".txt";
        }

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

	}
}]]></ProjectItem>
