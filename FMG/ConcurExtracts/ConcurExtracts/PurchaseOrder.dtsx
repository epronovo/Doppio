            return billToAddress;
        }

        private void WriteFlatFile<T>(List<T> records, string path)
        {
            var lines = new List<string>();
            IEnumerable<PropertyDescriptor> props = TypeDescriptor.GetProperties(typeof(T)).OfType<PropertyDescriptor>();

            var propertyName = string.Join(",", props.ToList().Select(x => x.Name));
            var valueLines = records.Select(row => string.Join(",", propertyName.Split(',').Select(a => row.GetType().GetProperty(a).GetValue(row, null))));
            lines.AddRange(valueLines);
            File.AppendAllLines(path, lines.ToArray());
        }

        private void WriteFlatFile<T>(T records, string path)
        {
            var lines = new List<string>();
            IEnumerable<PropertyDescriptor> props = TypeDescriptor.GetProperties(typeof(T)).OfType<PropertyDescriptor>();
            var propertyName = string.Join(",", props.ToList().Select(x => x.Name));
            
            string[] _recordsObject = records.GetType()
                .GetProperties()
                .Select(p => 
                    { 
                        object value = p.GetValue(records, null);
                        return value == null ? null : value.ToString();
                    }).ToArray();


            var valueLines = string.Join(",", _recordsObject);

            File.AppendAllText(path, valueLines + Environment.NewLine);

        }

