        private List<PurchaseOrderLine> GetPurchaseOrderLines(string purchase_order_number)
        {
            List<PurchaseOrderLine> purchaseOrderLines = new List<PurchaseOrderLine>();

            using (SqlConnection cnn1 = new SqlConnection(ConnectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("App_Concur.dbo.p_concurinvoicepo_get_poline", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@po_num", purchase_order_number);

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                purchaseOrderLines.Add(new PurchaseOrderLine
                                {
                                    record_type = reader["record_type"].ToString(),
                                    external_id = reader["external_id"].ToString(),
                                    line_number = reader["line_number"].ToString(),
                                    supplier_part_id = reader["supplier_part_id"].ToString(),
                                    requested_delivery_date = reader["requested_delivery_date"].ToString(),
