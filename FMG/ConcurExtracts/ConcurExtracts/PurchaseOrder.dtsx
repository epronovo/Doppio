        public string ConnectionString { get; set; }
        
        public string FlatFilePoInvoice { get; set; }
        public string EntityCode { get; set; }

        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
		{
            SetProperties();

            var directory = Path.GetDirectoryName(FlatFilePoInvoice);

            if (!string.IsNullOrEmpty(directory))
            {
                Directory.CreateDirectory(directory);
            }

            /*List<PurchaseOrder> purchaseOrders = GetPurchaseOrders();

            foreach (var purchaseOrder in purchaseOrders)
            {

                List<PurchaseOrderLine> purchaseOrderLines = GetPurchaseOrderLines(purchaseOrder.purchase_order_number);
                WriteFlatFile(purchaseOrderLines, FlatFilePoInvoice);

                BillToAddress billToAddress = GetBillToAddress(purchaseOrder.purchase_order_number);
                WriteFlatFile(billToAddress, FlatFilePoInvoice);

                ShipToAddress shipToAddress = GetShipToAddress(purchaseOrder.purchase_order_number);
                WriteFlatFile(shipToAddress, FlatFilePoInvoice);

                WriteFlatFile(purchaseOrder, FlatFilePoInvoice);
            }
            */
            using (var writer = new StreamWriter(FlatFilePoInvoice, false, Encoding.UTF8, 65536))
            {
                List<PurchaseOrder> purchaseOrders = GetPurchaseOrders();

                foreach (var purchaseOrder in purchaseOrders)
                {
                    WritePurchaseOrderLinesToWriter(purchaseOrder.po_num, writer);

                    WriteBillToAddressToWriter(purchaseOrder.po_num, writer);

                    WriteShipToAddressToWriter(purchaseOrder.po_num, writer);

                    // Write PO Header
                    WritePurchaseOrderToWriter(purchaseOrder, writer);
                }
            }


            Dts.TaskResult = (int)ScriptResults.Success;
		}

        private void WritePurchaseOrderToWriter(PurchaseOrder po, StreamWriter writer)
        {
            try
            {
                writer.Write(Escape(po.record_type)); writer.Write(",");
                writer.Write(Escape(po.purchase_order_number)); writer.Write(",");
                writer.Write(Escape(po.policy_external_id)); writer.Write(",");
                writer.Write(Escape(po.currency_code)); writer.Write(",");
                writer.Write(Escape(po.vendor_code)); writer.Write(",");
                writer.Write(Escape(po.vendor_address_code)); writer.Write(",");
                writer.Write(Escape(po.order_date)); writer.Write(",");
                writer.Write(Escape(po.name)); writer.Write(",");
                writer.Write(Escape(po.description)); writer.Write(",");
                writer.Write(Escape(po.requested_delivery_date)); writer.Write(",");
                writer.Write(Escape(po.requested_by)); writer.Write(",");
                writer.Write(Escape(po.payment_terms)); writer.Write(",");
                writer.Write(Escape(po.discount_terms)); writer.Write(",");
                writer.Write(Escape(po.discount_percentage)); writer.Write(",");
                writer.Write(Escape(po.tax)); writer.Write(",");
                writer.Write(Escape(po.shipping)); writer.Write(",");
                writer.Write(Escape(po.shipping_description)); writer.Write(",");
                writer.Write(Escape(po.is_test)); writer.Write(",");
                writer.Write(Escape(po.shipping_terms)); writer.Write(",");
                writer.Write(Escape(po.shipping_method)); writer.Write(",");
                writer.Write(Escape(po.needed_by_date)); writer.Write(",");
                writer.Write(Escape(po.vendor_account_number)); writer.Write(",");
                writer.Write(Escape(po.status_of_the_purchase_order)); writer.Write(",");
                writer.Write(Escape(po.vendor_tax_identification_number)); writer.Write(",");
                writer.Write(Escape(po.provincial_tax_identification_number)); writer.Write(",");
                writer.Write(Escape(po.vat_amount_1)); writer.Write(",");
                writer.Write(Escape(po.vat_amount_2)); writer.Write(",");
                writer.Write(Escape(po.vat_rate_1)); writer.Write(",");
                writer.Write(Escape(po.vat_rate_2)); writer.Write(",");
                writer.Write(Escape(po.amount_without_vat)); writer.Write(",");
                writer.Write(Escape(po.receipt_type)); writer.Write(",");
                writer.Write(Escape(po.ledger_code)); writer.Write(",");                
                writer.Write(Escape(po.future_use_16)); writer.Write(",");
                writer.Write(Escape(po.future_use_17)); writer.Write(",");
                writer.Write(Escape(po.future_use_18)); writer.Write(",");
                writer.Write(Escape(po.future_use_19)); writer.Write(",");
                writer.Write(Escape(po.future_use_20)); writer.Write(",");
                writer.Write(Escape(po.custom_1)); writer.Write(",");
                writer.Write(Escape(po.custom_2)); writer.Write(",");
                writer.Write(Escape(po.custom_3)); writer.Write(",");
                writer.Write(Escape(po.custom_4)); writer.Write(",");
                writer.Write(Escape(po.custom_5)); writer.Write(",");
                writer.Write(Escape(po.custom_6)); writer.Write(",");
                writer.Write(Escape(po.custom_7)); writer.Write(",");
                writer.Write(Escape(po.custom_8)); writer.Write(",");
                writer.Write(Escape(po.custom_9)); writer.Write(",");
                writer.Write(Escape(po.custom_10)); writer.Write(",");
                writer.Write(Escape(po.custom_11)); writer.Write(",");
                writer.Write(Escape(po.custom_12)); writer.Write(",");
                writer.Write(Escape(po.custom_13)); writer.Write(",");
                writer.Write(Escape(po.custom_14)); writer.Write(",");
                writer.Write(Escape(po.custom_15)); writer.Write(",");
                writer.Write(Escape(po.custom_16)); writer.Write(",");
                writer.Write(Escape(po.custom_17)); writer.Write(",");
                writer.Write(Escape(po.custom_18)); writer.Write(",");
                writer.Write(Escape(po.custom_19)); writer.Write(",");
                writer.Write(Escape(po.custom_20)); writer.Write(",");
                writer.Write(Escape(po.custom_21)); writer.Write(",");
                writer.Write(Escape(po.custom_22)); writer.Write(",");
                writer.Write(Escape(po.custom_23)); writer.Write(",");
                writer.Write(Escape(po.custom_24));
                writer.WriteLine();

            }
            catch (Exception)
            {

                throw;
            }
        }

        private void WriteShipToAddressToWriter(string purchase_order_number, StreamWriter writer)
        {
            using (SqlConnection cnn1 = new SqlConnection(ConnectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("App_Concur.dbo.p_concurinvoicepo_get_poshipto", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@po_num", purchase_order_number);
                        

                        using (SqlDataReader reader = cmd.ExecuteReader(CommandBehavior.SequentialAccess))
                        {
                            int fieldCount = reader.FieldCount;

                            while (reader.Read())
                            {
                                for (int i = 0; i < fieldCount; i++)
                                {
                                    if (reader.IsDBNull(i))
                                        writer.Write("");
                                    else
                                        writer.Write(Escape(reader.GetValue(i)));

                                    if (i < fieldCount - 1)
                                        writer.Write(",");
                                }

                                writer.WriteLine();
                            }
                        }
                    }
                }
                catch (Exception)
                {

                    throw;
                }
            }
        }

