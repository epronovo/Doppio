          <ProjectItem
            Name="Invoice.cs"
            Encoding="UTF8"><![CDATA[using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ST_e130e7214774424f9209c2a9e09fd039
{
    public class Invoice
    {
        public string ParentCompany { get; set; }
        public string CompanyNumber { get; set; }
        public string SupplierNumber { get; set; }
        public string SupplierSeqNumber { get; set; }
        public string PurchaseOrderNumber { get; set; }
        public string TransactionType { get; set; }
        public string InvoiceDate { get; set; }
        public string InvoiceNumber { get; set; }
        public string TotalInvoiceAmount { get; set; }
        public string Currency { get; set; }
        public string TotalFreightAmount { get; set; }
        public string TotalTaxAmount { get; set; }
        public string TotalFuelAmount { get; set; }
        public string TotalMaterialAmount { get; set; }
        public string TotalOtherAmount { get; set; }
        public string TotalFutureAmount { get; set; }
        public string CustomerAccountNumber { get; set; }
        public string PaymentText { get; set; }
        public string Description { get; set; }
        public string BatchType { get; set; }
        public string CatalystIdNumber { get; set; }
        public string EditingStatusCode { get; set; }
        public string ImportDate { get; set; }
        public string ImportTime { get; set; }
        public string EditDate { get; set; }
        public string EditTime { get; set; }
        public string APBatchNumber { get; set; }
        public string GLBatchNumber { get; set; }
        public string APVoucherNumber { get; set; }

        public List<HeaderCharges> HeaderCharges { get; set; } = new List<HeaderCharges>();
       /* public string ChargeType { get; set; }
        public string ChargeSequence { get; set; }
        public string ChargeID { get; set; }
        public string ChargeDescription { get; set; }
        public string ChargeAmount { get; set; }*/


        public List<InvoiceDetails> InvoiceDetails { get; set; } = new List<InvoiceDetails>();
        public string Company { get; internal set; }
        public string Division { get; internal set; }
        public string Contact { get; internal set; }
        public string MinPoline { get; internal set; }
    }

    public class HeaderCharges
    {
        public string ChargeType { get; set; }
        public string ChargeSequence { get; set; }
        public string ChargeID { get; set; }
        public string ChargeDescription { get; set; }
        public string ChargeAmount { get; set; }
    }

    public class InvoiceDetails
    {
        public string ParentCompany { get; set; }
        public string CompanyNumber { get; set; }
        public string BillOfLadingNumber { get; set; }
        public string InvoiceLineNumber { get; set; }
        public string PurchaseOrderNumber { get; set; }
        public string PurchaseOrderLineNumber { get; set; }
        public string PurchaseOrderLineSeqNumber { get; set; }
        public string QuantityInvoice { get; set; }
        public string InvoicedUnitPrice { get; set; }
        public string InvoiceLineAmount { get; set; }
        public string QuantityReceived { get; set; }
        public string ItemReceived { get; set; }
        public string UnitOfMeasure { get; set; }
        public string AccountNumber { get; set; }
        public string DepartmentCode { get; set; }
        public string CatalystIdNumber { get; set; }
        public string EditingStatusCode { get; set; }
        public string ImportDate { get; set; }
        public string ImportTime { get; set; }
        public string EditDate { get; set; }
        public string EditTime { get; set; }
        public bool delete_from_line_details { get; set; } = false;
        public List<LineCharges> LineCharges { get; set; } = new List<LineCharges>();

    }
    public class LineCharges
    {
        public string ChargeSequence { get; set; }
        public string ChargeID { get; set; }
        public string ChargeAmount { get; set; }
        public string ChargeLineNumber { get; internal set; }
    }
    
}]]></ProjectItem>
