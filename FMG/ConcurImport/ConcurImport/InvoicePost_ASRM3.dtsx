         * 
         * Example of firing an information event:
         *  Dts.Events.FireInformation(3, "Process Values", "Processing has started", "", 0, ref fireAgain)
         * 
         * Example of firing a warning event:
         *  Dts.Events.FireWarning(14, "Process Values", "No values received for input", "", 0);
         * */
        #endregion

        #region Help:  Using Integration Services connection managers in a script
        /* Some types of connection managers can be used in this script task.  See the topic 
         * "Working with Connection Managers Programatically" for details.
         * 
         * Example of using an ADO.Net connection manager:
         *  object rawConnection = Dts.Connections["Sales DB"].AcquireConnection(Dts.Transaction);
         *  SqlConnection myADONETConnection = (SqlConnection)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Sales DB"].ReleaseConnection(rawConnection);
         *
         * Example of using a File connection manager
         *  object rawConnection = Dts.Connections["Prices.zip"].AcquireConnection(Dts.Transaction);
         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion


        byte[] emptyByte = new byte[0];
        string packageName;
        string connectionString;
        public string DWconnectionString { get; set; }
        List<string> accountCodes;

        string saveDirectory;
        string backupDirectory;
        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        public void Main()
        {
            // TODO: Add your code here
            DWconnectionString = Dts.Variables["CNN_SQLMI_ADO_DW"].Value.ToString();
            connectionString = Dts.Variables["CNN_Concur_Invoice_Worktables"].Value.ToString();
            saveDirectory = Dts.Variables["ASRM3_Xml_Directory"].Value.ToString();
            backupDirectory = Dts.Variables["ASRM3_Xml_BackupDirectory"].Value.ToString();
            accountCodes = GetAccountCodes();
            

            List<Invoice> invoices = new List<Invoice>();
            using (SqlConnection cnn1 = new SqlConnection(connectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("p_get_concur_invoice_headers_m3_raymond", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            Invoice _invoice;
                            while (reader.Read())
                            {
                                _invoice = new Invoice();
                                string parentCompany = reader["PCNO91"].ToString();
                                string companyNumber = reader["CONO91"].ToString();
                                string purchaseOrderNumber = reader["PONO91"].ToString();

                                _invoice.ParentCompany = reader["PCNO91"].ToString();
                                _invoice.CompanyNumber = reader["CONO91"].ToString();
                                _invoice.SupplierNumber = reader["VEND91"].ToString();
                                _invoice.SupplierSeqNumber = reader["VSEQ91"].ToString();
                                _invoice.PurchaseOrderNumber = reader["PONO91"].ToString();
                                _invoice.TransactionType = reader["TYPE91"].ToString();
                                _invoice.InvoiceDate = reader["M3INVOICEDATE"].ToString(); //reader["INDT91"].ToString();
                                _invoice.InvoiceNumber = reader["INVN91"].ToString();
                                _invoice.TotalInvoiceAmount = reader["TINV91"].ToString();
                                _invoice.Currency = reader["CURC91"].ToString();
                                _invoice.TotalFreightAmount = reader["TFRT91"].ToString();
                                _invoice.TotalTaxAmount = reader["TTAX91"].ToString();
                                _invoice.TotalFuelAmount = reader["TFUL91"].ToString();
                                _invoice.TotalMaterialAmount = reader["TMAT91"].ToString();
                                _invoice.TotalOtherAmount = reader["TOTH91"].ToString();
                                _invoice.TotalFutureAmount = reader["TFUT91"].ToString();
                                _invoice.CustomerAccountNumber = reader["AINV91"].ToString();
                                _invoice.PaymentText = reader["PYMT91"].ToString();
                                _invoice.Description = reader["DESC91"].ToString();
                                _invoice.BatchType = reader["PTYP91"].ToString();
                                _invoice.CatalystIdNumber = reader["CIDN91"].ToString();
                                _invoice.EditingStatusCode = reader["CODE91"].ToString();
                                _invoice.ImportDate = reader["PDAT91"].ToString();
                                _invoice.ImportTime = reader["PTIM91"].ToString();
                                _invoice.EditDate = reader["EDAT91"].ToString();
                                _invoice.EditTime = reader["ETIM91"].ToString();
                                _invoice.APBatchNumber = reader["APBT91"].ToString();
                                _invoice.GLBatchNumber = reader["GLBT91"].ToString();
                                _invoice.APVoucherNumber = reader["VCHR91"].ToString();
                                _invoice.Company = reader["M3CONO"].ToString();
                                _invoice.Division = reader["M3DIVI"].ToString();
                                _invoice.Contact = reader["contact"].ToString();
                                _invoice.MinPoline = reader["minpoline"].ToString();
                                GetInvoiceDetails(_invoice);
                                invoices.Add(_invoice);
                            }
                        }
                    }

                }
                catch (Exception ex)
                {

                    System.Diagnostics.Debug.WriteLine(ex.Message);
                }
            }

            if (invoices != null)
            {

                foreach (var invoice in invoices)
                {
                    SetChargers(invoice);
                }


                CreateXMLDocument(invoices);
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        private List<string> GetAccountCodes()
        {
            List<string> codes = new List<string>();

            using (SqlConnection cnn1 = new SqlConnection(DWconnectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("App_Concur.dbo.p_concur_get_account_codes", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                codes.Add(reader["account_code"].ToString());
                            }
                        }
                    }
                }
                catch (Exception ex)
                {

                    throw;
                }
            }

            return codes;
        }

        private void SetChargers(Invoice invoice)
        {
            var record = invoice;
            
            foreach (var item in invoice.InvoiceDetails)
            {
                List<Charge> Charges = GetCharges(invoice.PurchaseOrderNumber, item.PurchaseOrderLineNumber,item.ItemReceived, item.InvoicedUnitPrice, item.AccountNumber, invoice.MinPoline);

                if (Charges != null)
                {
                    foreach (var charge in Charges)
                    {
                        if (charge.po_line == "0")
                        {
                            invoice.HeaderCharges.Add(new HeaderCharges
                            {
                                ChargeID = charge.charge_id,
                                ChargeAmount = charge.charge_amount,
                                ChargeDescription = charge.description,
                                ChargeType = charge.charge_type,
                                ChargeSequence = charge.charge_sequence
                            });
                            item.delete_from_line_details = true;
                        }
                        else
                        {
                            item.LineCharges.Add(new LineCharges
                            {
                                ChargeAmount = charge.charge_amount,
                                ChargeID = charge.charge_id,
                                ChargeSequence = charge.charge_sequence,
                                ChargeLineNumber = charge.charge_line
                            });
                            
                            if (accountCodes.Contains(item.AccountNumber))
                            {
                                item.delete_from_line_details = true;
                            }
                        }
                    }
                }
            }
        }

        private List<Charge> GetCharges(string purchaseOrderNumber, string purchaseOrderLineNumber, string itemReceived, string invoicedUnitPrice, string accountNumber, string minpoLine)
        {
            List<Charge> charges = new List<Charge>();
            using (SqlConnection cnn1 = new SqlConnection(DWconnectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("App_Concur.dbo.p_concur_get_po_chargers", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@po_no", purchaseOrderNumber);
                        cmd.Parameters.AddWithValue("@po_line", purchaseOrderLineNumber);
                        cmd.Parameters.AddWithValue("@item", itemReceived);
                        cmd.Parameters.AddWithValue("@amount", invoicedUnitPrice);
                        cmd.Parameters.AddWithValue("@accountcode", accountNumber);
                        cmd.Parameters.AddWithValue("@minpo_line", minpoLine);

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                charges.Add(new Charge
                                {
                                    po_line = reader["po_line"].ToString(),
                                    charge_sequence = reader["charge_sequence"].ToString(),
                                    charge_type = reader["charge_type"].ToString(),
                                    charge_id = reader["charge_id"].ToString(),
                                    charge_amount = reader["charge_amount"].ToString(),
                                    currency_code = reader["currency_code"].ToString(),
                                    description = reader["description"].ToString(),
                                    charge_line = reader["po_line"].ToString()
                                });
                            }
                        }
                    }
                }
                catch (Exception ex)
                {

                    throw;
                }
            }
            return charges;
        }

        private void GetInvoiceDetails(Invoice invoice)
        {
            using (SqlConnection cnn1 = new SqlConnection(connectionString))
            {
                try
                {
                    cnn1.Open();
                    using (SqlCommand cmd = new SqlCommand("p_get_concur_invoice_details_m3_raymond", cnn1))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@parentCompany", invoice.ParentCompany);
                        cmd.Parameters.AddWithValue("@companyNumber", invoice.CompanyNumber);
                        cmd.Parameters.AddWithValue("@poNumber", invoice.PurchaseOrderNumber);
                        cmd.Parameters.AddWithValue("@catalystIDNumber", invoice.CatalystIdNumber);

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            InvoiceDetails _invoiceDetails;
                            while (reader.Read())
                            {
                                _invoiceDetails = new InvoiceDetails();
                                _invoiceDetails.ParentCompany = reader["PCNO92"].ToString();
                                _invoiceDetails.CompanyNumber = reader["CONO92"].ToString();
                                _invoiceDetails.BillOfLadingNumber = reader["BOLN92"].ToString();
                                _invoiceDetails.InvoiceLineNumber = reader["INVL92"].ToString();
                                _invoiceDetails.PurchaseOrderNumber = reader["PONO92"].ToString();
                                _invoiceDetails.PurchaseOrderLineNumber = reader["POLN92"].ToString();
                                _invoiceDetails.PurchaseOrderLineSeqNumber = reader["POLS92"].ToString();
                                _invoiceDetails.QuantityInvoice = reader["QTYI92"].ToString();
                                _invoiceDetails.InvoicedUnitPrice = reader["IPRC92"].ToString();
                                _invoiceDetails.InvoiceLineAmount = reader["IAMT92"].ToString();
                                _invoiceDetails.QuantityReceived = reader["QTYR92"].ToString();
                                _invoiceDetails.ItemReceived = reader["ITEM92"].ToString();
                                _invoiceDetails.UnitOfMeasure = reader["UOM92"].ToString();
                                _invoiceDetails.AccountNumber = reader["ACCT92"].ToString();
                                _invoiceDetails.DepartmentCode = reader["DEPT92"].ToString();
                                _invoiceDetails.CatalystIdNumber = reader["CIDN92"].ToString();
                                _invoiceDetails.EditingStatusCode = reader["CODE92"].ToString();
                                _invoiceDetails.ImportDate = reader["PDAT92"].ToString();
                                _invoiceDetails.ImportTime = reader["PTIM92"].ToString();
                                _invoiceDetails.EditDate = reader["EDAT92"].ToString();
                                _invoiceDetails.EditTime = reader["ETIM92"].ToString();

                                invoice.InvoiceDetails.Add(_invoiceDetails);

                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine(ex.Message);
                }
            }
        }

        private void CreateXMLDocument(List<Invoice> invoices)
        {
            foreach (var item in invoices)
            {
                if (item.BatchType.ToUpper() == "M")
                {
                    MatchScenario(item);
                }
                else
                {
                    ExceptionDirectScenario(item);
                }
            }
        }

        private void ExceptionDirectScenario(Invoice item)
        {
            string entityId = item.Company + '_' + item.Division;

            var details = item.InvoiceDetails;
            XNamespace xmlns = XNamespace.Get("http://schema.infor.com/InforOAGIS/2");
            XNamespace xsi = XNamespace.Get("http://www.w3.org/2001/XMLSchema-instance");
            XNamespace schemaLocation = XNamespace.Get("http://schema.infor.com/InforOAGIS/2 http://schema.infor.com/2.13.0/InforOAGIS/BODs/LoadSupplierInvoice.xsd");

            XDocument doc = new XDocument
                (
                new XDeclaration("1.0", "UTF-9", null),
                new XElement(xmlns + "LoadSupplierInvoice",
                new XAttribute(XNamespace.Xmlns + "xsi", xsi),
                new XAttribute(xsi + "schemaLocation", schemaLocation),
                new XAttribute("releaseID", "9.2"), new XAttribute("versionID", "2.13.0"),
                new XAttribute("systemEnvironmentCode", "production"),
                new XAttribute("languageCode", "GB"),
                new XElement("ApplicationArea",
                new XElement("Sender",
                    new XElement("LogicalID", new XAttribute("schemeVersionID", "16.0.0.020"), "lid://infor.m3.m3"),
                    new XElement("ComponentID", new XAttribute("schemeVersionID", "16.0.0.20230822184312.6"), "M3BE"),
                    new XElement("ConfirmationCode", "OnError")),
                new XElement("CreationDateTime", DateTime.Now.ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss.fffZ")),
                new XElement("BODID", "0a02464c-db28-459f-83c6-9b8e6bd97723")),
                new XElement("DataArea",
                new XElement("Load",
                new XElement("AccountingEntityID", entityId),
                new XElement("ActionCriteria",
                new XElement("ActionExpression", new XAttribute("actionCode", "Replace")))),
                new XElement("SupplierInvoice", new XAttribute("type", "Invoice"),
                new XElement("SupplierInvoiceHeader",
                new XElement("DocumentID",
                new XElement("ID", new XAttribute("accountingEntity", entityId), new XAttribute("lid", "lid://infor.m3.m3"), item.InvoiceNumber)),
                new XElement("DocumentDateTime", item.InvoiceDate),
                new XElement("TotalAmount", new XAttribute("currencyID", item.Currency), item.TotalInvoiceAmount),
                new XElement("SupplierParty",
                new XElement("PartyIDs",
                new XElement("ID", new XAttribute("schemeName", "SupplierNumber"), item.SupplierNumber))),
                new XElement("CustomerParty",
                new XElement("Contact",
                new XElement("ID", item.Contact))),
                new XElement("UserArea",
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "scenario"), item.BatchType)),
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine"), "True")))
                ),
                from line in details
                select
                new XElement("SupplierInvoiceLine",
                new XElement("ExtendedAmount", line.InvoiceLineAmount),
                new XElement("UserArea",
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine_Dim1"), line.AccountNumber)),
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine_Dim2"), line.DepartmentCode)),
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine_Dim3"), "")),
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine_Dim4"), "")),
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine_Dim5"), "")),
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine_Dim6"), "")),
                new XElement("Property",
                new XElement("NameValue", new XAttribute("name", "AccountingLine_Dim7"), "AP50200")))
                //new XElement("PurchaseOrderReference",
                //new XElement("LineNumber", line.PurchaseOrderLineNumber),
                //new XElement("DocumentID",
                //new XElement("ID", line.PurchaseOrderNumber))),
                //new XElement("Quantity", new XAttribute("unitCode", line.UnitOfMeasure), line.QuantityInvoice),
                //new XElement("UnitPrice",
                //new XElement("Amount", line.InvoicedUnitPrice),
                //new XElement("PerQuantity", new XAttribute("unitCode", line.UnitOfMeasure))),
                //new XElement("Item",
                //new XElement("ItemID",
                //new XElement("ID", line.ItemReceived)))
                )
              ))));
            string timestamp = DateTime.Now.ToString("yyyyMMddHHmmss");
            string inv = RemoveSpecialCharacters(item.InvoiceNumber);
            string fileName = $"{entityId}_{inv}_{item.BatchType}_{timestamp}.xml";
            string filePath = System.IO.Path.Combine(saveDirectory, fileName);
            string fileBackup = System.IO.Path.Combine(backupDirectory, fileName);

            //Remove empty namespaces from child nodes
            foreach (var node in doc.Root.Descendants())
            {
                if (node.Name.Namespace == "")
                {
                    node.Attributes("xmlns").Remove();
                    node.Name = node.Parent.Name.Namespace + node.Name.LocalName;
                }
            }

            doc.Save(filePath);

            FileBackup(filePath, fileBackup);
        }

        private void FileBackup(string filePath, string fileBackup)
        {
            try
            {
                System.IO.File.Copy(filePath, fileBackup);
            }
            catch (Exception)
            {
                //
            }
        }

        private void MatchScenario(Invoice item)
        {
            string entityId = item.Company + '_' + item.Division;

            var details = item.InvoiceDetails;
            XNamespace xmlns = XNamespace.Get("http://schema.infor.com/InforOAGIS/2");
            XNamespace xsi = XNamespace.Get("http://www.w3.org/2001/XMLSchema-instance");
            XNamespace schemaLocation = XNamespace.Get("http://schema.infor.com/InforOAGIS/2 http://schema.infor.com/2.13.0/InforOAGIS/BODs/LoadSupplierInvoice.xsd");

            try
            {
                XDocument doc = new XDocument
                       (
                       new XDeclaration("1.0", "UTF-9", null),
                       new XElement(xmlns + "LoadSupplierInvoice",
                       new XAttribute(XNamespace.Xmlns + "xsi", xsi),
                       new XAttribute(xsi + "schemaLocation", schemaLocation),
                       new XAttribute("releaseID", "9.2"), new XAttribute("versionID", "2.13.0"),
                       new XAttribute("systemEnvironmentCode", "production"),
                       new XAttribute("languageCode", "GB"),
                       new XElement("ApplicationArea",
                       new XElement("Sender",
                           new XElement("LogicalID", new XAttribute("schemeVersionID", "16.0.0.020"), "lid://infor.m3.m3"),
                           new XElement("ComponentID", new XAttribute("schemeVersionID", "16.0.0.20230822184312.6"), "M3BE"),
                           new XElement("ConfirmationCode", "OnError")),
                       new XElement("CreationDateTime", DateTime.Now.ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss.fffZ")),
                       new XElement("BODID", "0a02464c-db28-459f-83c6-9b8e6bd97723")),
                       new XElement("DataArea",
                       new XElement("Load",
                       new XElement("AccountingEntityID", entityId),
                       new XElement("ActionCriteria",
                       new XElement("ActionExpression", new XAttribute("actionCode", "Replace")))),
                       new XElement("SupplierInvoice", new XAttribute("type", "Invoice"),
                       new XElement("SupplierInvoiceHeader",
                       new XElement("DocumentID",
                       new XElement("ID", new XAttribute("accountingEntity", entityId), new XAttribute("lid", "lid://infor.m3.m3"), item.InvoiceNumber)),
                       new XElement("DocumentDateTime", item.InvoiceDate),
                       new XElement("TotalAmount", new XAttribute("currencyID", item.Currency), item.TotalInvoiceAmount),
                       new XElement("SupplierParty",
                       new XElement("PartyIDs",
                       new XElement("ID", new XAttribute("schemeName", "SupplierNumber"), item.SupplierNumber))),
                       new XElement("CustomerParty",
                       new XElement("Contact",
                       new XElement("ID", item.Contact))),
                       /*  Not needed for match scenario
                       new XElement("PurchaseOrderReference",
                       new XElement("DocumentID",
                       new XElement("ID", item.PurchaseOrderNumber))),
                       */
                       new XElement("UserArea",
                       new XElement("Property",
                       new XElement("NameValue", new XAttribute("name", "scenario"), item.BatchType))),
                       new XElement("UserArea",
                       new XElement("Property",
                       new XElement("NameValue", new XAttribute("name", "ext_ref_number"), item.CatalystIdNumber)))

                       ,from headerCharge in item.HeaderCharges
                       select
                       new XElement("Charge", new XAttribute("type", headerCharge.ChargeType ?? ""), new XAttribute("sequence", headerCharge.ChargeSequence ?? ""),
                       new XElement("ID", headerCharge.ChargeID ?? ""),
                       new XElement("Description", headerCharge.ChargeDescription ?? ""),
                       new XElement("Amount", headerCharge.ChargeAmount ?? ""))

                       /*
                       ,new XElement("Charge", new XAttribute("type", item.ChargeType ?? ""), new XAttribute("sequence", item.ChargeSequence ?? ""),
                       new XElement("ID", item.ChargeID ?? ""),
                       new XElement("Description", item.ChargeDescription ?? ""),
                       new XElement("Amount", item.ChargeAmount ?? ""))
                       */

                       ),
                       from line in details.Where(x => x.delete_from_line_details == false)// x.QuantityInvoice != "0.000" && x.PurchaseOrderLineNumber.StartsWith("99")==false )
                       select
                       new XElement("SupplierInvoiceLine",
                       new XElement("PurchaseOrderReference",
                       new XElement("LineNumber", line.PurchaseOrderLineNumber),
                       new XElement("DocumentID",
                       new XElement("ID", line.PurchaseOrderNumber))),
                       new XElement("Quantity", new XAttribute("unitCode", line.UnitOfMeasure), line.QuantityInvoice),
                       new XElement("UnitPrice",
                       new XElement("Amount", line.InvoicedUnitPrice),
                       new XElement("PerQuantity", new XAttribute("unitCode", line.UnitOfMeasure))),
                       new XElement("Item",
                       new XElement("ItemID",
                       new XElement("ID", line.ItemReceived)))),
                      from line in details
                      from lineCharge in line.LineCharges
                      select
                      new XElement("SupplierInvoiceLine",
                      new XElement("PurchaseOrderReference",
                      new XElement("LineNumber", lineCharge.ChargeLineNumber ?? ""),
                      new XElement("DocumentID",
                      new XElement("ID", line.PurchaseOrderNumber ?? ""))),
                      new XElement("InvoiceCharge", new XAttribute("sequence", lineCharge.ChargeSequence ?? ""),
                      new XElement("ID", lineCharge.ChargeID ?? ""),
                      new XElement("Amount", lineCharge.ChargeAmount ?? "")))
                     ))));
                string timestamp = DateTime.Now.ToString("yyyyMMddHHmmss");
                string inv = RemoveSpecialCharacters(item.InvoiceNumber);
                string fileName = $"{entityId}_{inv}_{item.BatchType}_{timestamp}.xml";
                string filePath = System.IO.Path.Combine(saveDirectory, fileName);
                string fileBackup = System.IO.Path.Combine(backupDirectory, fileName);

                //Remove empty namespaces from child nodes
                foreach (var node in doc.Root.Descendants())
                {
                    if (node.Name.Namespace == "")
                    {
                        node.Attributes("xmlns").Remove();
                        node.Name = node.Parent.Name.Namespace + node.Name.LocalName;
                    }
                }

                doc.Save(filePath);

                FileBackup(filePath, fileBackup);
            }
            catch (Exception ex)
            {

                System.Diagnostics.Debug.WriteLine(ex.Message);
            }
        }

        private string RemoveSpecialCharacters(string invoiceNumber)
        {
            char[] buffer = new char[invoiceNumber.Length];
            int index = 0;

            foreach (char c in invoiceNumber.Where(c => char.IsLetterOrDigit(c)))
                buffer[index++] = c;

            return new string(buffer, 0, index);

        }

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

    }
}]]></ProjectItem>
