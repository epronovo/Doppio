                <component
                  refId="Package\Invoice Detail\Load invoice detail\Inv Lines from Aurora"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Inv Lines from Aurora"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
	1 as system_id,
	cono70 as entity_id,
	invn70 as inv_num ,
	CAST(desn70 as nvarchar(6)) as inv_seq,
	ordl70 as inv_line, 
 	case when dtin65 = 0 then null else 
		SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 4, 2) CONCAT '/' CONCAT
               		SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
              		SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 2, 2)  
        	end as dtin65,
	ordn70 as co_num,
	ordl70 as co_line,
	0 as co_release,
	CAST('' as nvarchar(1)) as item_customer,
	catn70 as item_internal,
	lqty70 as qty_invoiced,
	bdis70 as discount,
	cval70 as cost,
	uprc70 as price,
	bliv70 as base_line_value,
	lval70 AS inv_line_value,
	curn00 as currency_code,
	desn70 as ship_ref,
	CAST('' as nvarchar(1)) as ship_line,
	CAST('' as nvarchar(1)) as ship_seq,
	invn70 as source_inv_num,
	'I' as line_type,
	CASE
		WHEN d.qtor55 = (SELECT SUM(lqty70) FROM ault2f2prd.oep70 AS sq where sq.cono70=a.cono70 and sq.ordn70=a.ordn70 AND sq.ordl70=a.ordl70 AND sq.dttr70 &lt;= a.dttr70 AND sq.invn70 &lt;= a.invn70)
		THEN 1
		ELSE 0
	END Line_Count,
	CASE 
		WHEN a.dttr70 &gt; d.dtdr55
		THEN 0
		ELSE 1
	END as ot_count,
	d.qtor55 as order_qty,
(SELECT SUM(lqty70) FROM ault2f2prd.oep70 AS sq where sq.cono70=a.cono70 and sq.ordn70=a.ordn70 AND sq.ordl70=a.ordl70 AND sq.dttr70 &lt;= a.dttr70 AND sq.invn70 &lt;= a.invn70) as cum_ship_qty
	
from ault2f2prd.oep70 a
inner join ault2f2prd.oep65 b on b.cono65 = a.cono70 and
b.invn65 = a.invn70
inner join AULT1F2PRD.COMPANY c
on a.cono70=c.cono
LEFT JOIN ault2f2prd.oep55 d
			ON a.cono70=d.cono55 and a.ordn70=d.ordn55 and a.ordl70=d.ordl55
where (dtin65 &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 30 days, 'YYMMDD') FROM sysibm.sysdummy1) AS INT)
OR dtlc65 &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 30 days, 'YYMMDD') FROM sysibm.sysdummy1) AS INT))


UNION ALL
select 
	1 as system_id,
	cono50 as entity_id,
	invn50 as inv_num,
	CAST(1000 + CAST(DESN50 AS INT) as nvarchar(6)) as inv_seq,
	sqno50 as inv_line,
	case when dtin65 = 0 then null else 
		SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 4, 2) CONCAT '/' CONCAT
               		SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
              		SUBSTR(Right('0' concat CAST(dtin65 AS VARCHAR(7)),7), 2, 2)  
        	end as dtin65,
	ordn50 as CO_NUM,
	SQNO50 AS CO_LINE,
	0 AS CO_RELEASE,
	CAST('' as nvarchar(1)) as item_customer,
	ODES50 AS item_internal,
	1 as qty_invoiced,
	0 as discount,
	0 as cost,
	chgv50 as price,
	bchv50 as base_line_value,
	chgv50 AS inv_line_value,
	curn00 as currency_code,
	desn65 as ship_ref,
	0 as ship_line,
	0 as ship_seq,
	invn50 as source_inv_num,
	'C' as line_type,
0 as Line_Count,
0 as ot_count,
0 as order_qty,
0 as cum_ship_qty

from ault2f2prd.oep50 a 
inner join ault2f2prd.oep65 b on a.cono50=b.cono65  and
a.invn50=b.invn65
inner join AULT1F2PRD.COMPANY c
on a.cono50=c.cono
where  (dtin65 &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 48 months, 'YYMMDD') FROM sysibm.sysdummy1) AS INT)
OR dtlc65 &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 48 months, 'YYMMDD') FROM sysibm.sysdummy1) AS INT))
and RTRIM(LTRIM(INVN50)) &lt;&gt; ''</property>
