                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT A.CONO, A.ACCN04,  '20' concat Right(cast(A.PSTPER as char(5)), 4) as PSTPER, A.LEDNO, 
A.PSQYTD, A.PSQTPR, A.MEMOAC, A.NPDR04, A.NPCR04, 
A.FYDR04, A.FYCR04, A.CYDR04, A.CYCR04 
FROM AULT1F2PRD.FLP004 as A
WHERE A.CONO IN (SELECT CONO FROM ASGHDCA.DWCOMPANY) and
 PSTPER &gt;= '1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 4 months, 'YYMM') FROM sysibm.sysdummy1)</property>
