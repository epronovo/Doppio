                </component>
                <component
                  refId="Package\Invoice Header\Load credit memos - unapplied cash - etc\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
	CONO15		as system_entity_id,
	LREF15		as inv_num,
	'0'		as inv_seq,
	CUSN15		as cust_ship_num,
	'000'		as cust_ship_seq,
	CUSN15		as cust_inv_num,
	'000'		as cust_inv_seq,
	case when docd15 = 0 then '' else 
		SUBSTR(Right('0' concat CAST(docd15 AS VARCHAR(7)),7), 4, 2)  CONCAT '/' CONCAT
		SUBSTR(Right('0' concat CAST(docd15 AS VARCHAR(7)),7), 6, 2) CONCAT '/20' CONCAT
		SUBSTR(Right('0' concat CAST(docd15 AS VARCHAR(7)),7), 2, 2)  
	end 		as inv_date,
	SUM(BTMT15)	as inv_total,
	b.CURN00 		as currency_code,
	1		as currency_rate,
	'C' CONCAT TRIM(ETYP15)	as inv_type,
	CASE WHEN SUM(BBAL15) &lt;&gt; 0 THEN 'O' ELSE 'C' END as inv_status,
	0		as terms, --(PDUE15-DOCD15)
	SOPN15		as co_num,
	''		as cust_po,
	LREF15		as ship_ref,
	DSEQ15		as ship_seq,
CASE WHEN LEFT(CAST(pper15 AS VARCHAR(5)), 1) = '1' THEN
      '20' CONCAT RIGHT(CAST(pper15 as varchar(5)), 4)
ELSE
      '19' CONCAT RIGHT(CAST(pper15 as varchar(5)), 4)
END AS pern

from ault1f2prd.slp15 a
LEFT JOIN ault1f2prd.company b
on a.cono15=b.cono
LEFT JOIN ault2f2prd.oep65 c
on a.cono15=c.cono65
and a.lref15=c.invn65

WHERE
--etyp15='CR'
invn65 IS NULL
and srcE15='E'
and docd15 &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 48 months, 'YYMMDD') FROM sysibm.sysdummy1) AS INT)

group by
CONO15,
LREF15,
CUSN15,
DOCD15,
b.CURN00,
SOPN15,
DSEQ15,
'C' CONCAT TRIM(ETYP15),
CASE WHEN LEFT(CAST(pper15 AS VARCHAR(5)), 1) = '1' THEN
      '20' CONCAT RIGHT(CAST(pper15 as varchar(5)), 4)
ELSE
      '19' CONCAT RIGHT(CAST(pper15 as varchar(5)), 4)
END</property>
