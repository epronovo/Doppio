        <DTS:Executable
          DTS:refId="Package\Chart Of Accounts\Upsert"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{64113B94-A5F2-49FE-8B75-B5B7E0520837}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Upsert"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server 2008 R2; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F8976FEE-7128-4781-B650-C187019B6D6A}"
              SQLTask:SqlStatementSource="INSERT  INTO gl_chart_of_account&#xA;        SELECT  a.* ,&#xA;                GETDATE()&#xA;        FROM    gl_chart_of_account_stage a&#xA;                LEFT JOIN gl_chart_of_account b ON a.system_id = b.system_id&#xA;                                                   AND a.system_entity_id = b.[system_entity_id]&#xA;                                                   AND a.ledger_id = b.ledger_id&#xA;                                                   AND a.acct_id = b.acct_id&#xA;        WHERE   a.system_id=? AND b.acct_id IS NULL&#xA;&#xA;       UPDATE  gl_chart_of_account&#xA;        SET     [description] = b.[description]&#xA;        FROM     gl_chart_of_account a&#xA;                INNER JOIN gl_chart_of_account_stage b ON&#xA;&#x9;&#x9;&#x9;&#x9;a.system_id=b.system_id AND&#xA;&#x9;&#x9;&#x9;&#x9;a.system_entity_id = b.[system_entity_id] AND&#xA;&#x9;&#x9;&#x9;&#x9;a.ledger_id=b.ledger_id AND&#xA;&#x9;&#x9;&#x9;&#x9;a.acct_id=b.acct_id&#xA;        WHERE   a.currency&lt;&gt;b.currency&#xA;&#x9;&#x9;OR a.[description] &lt;&gt; b.[description]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::System_ID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
