                <component
                  refId="Package\GL for 00 Corp Expenses\Load GL\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select T01.CONO As EntityID,
 T01.ACCN08 AS AccountNumber,
 T01.LINDES As LineDescription,
 T01.TXSRCE As TransactionSource,
 T01.UPDNOG As BatchCode,
 T01.TT AS TransactionType,
 T01.DOCREF As DocumentReference,
T01.LINO As DocSeq,
 T02.DOCDT As DocumentDate,
 CASE 
    WHEN SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 1, 1)='1' THEN
       SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 4, 2)  CONCAT '/' CONCAT SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 6, 2) CONCAT '/20' CONCAT SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 2, 2)
    WHEN SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 1, 1)='0' THEN
       SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 4, 2)  CONCAT '/' CONCAT SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 6, 2) CONCAT '/19' CONCAT SUBSTR(CAST(T02.DOCDT AS CHAR(7)), 2, 2) 
    ELSE NULL END AS FormattedDate,
  T02.SESNO AS SessionNumber,
CAST('20' concat Right(cast(T01.PSTPER as char(5)), 4) AS VARCHAR(6))  As PostingPeriod,
  (T01.pstamt * -1) as PostingAmount,
  T01.prlacc as PrivateLedgerAccount,
  RIGHT(TRIM(T01.ACCN08), 4) As CategoryAccount

 from ault1f2prd.flp008 as T01
 inner join
  ault1f2prd.flp007 as T02 on T01.CONO=T02.CONO AND T01.DOCREF=T02.DOCREF AND T01.TXSRCE=T02.TXSRCE AND  T01.TT=T02.TT 
WHERE T01.CONO='00' 
AND T01.PSTPER &gt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP - 1 months, 'YYMM') FROM sysibm.sysdummy1) AS INT) 

AND T01.PSTPER &lt;= CAST('1' CONCAT (select VARCHAR_FORMAT(CURRENT TIMESTAMP, 'YYMM') FROM sysibm.sysdummy1) AS INT)</property>
