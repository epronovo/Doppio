                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
                  name="GL account balances - Source"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 22 AS system_id,
       CONCAT(RIGHT(CONCAT('000', ISNULL(RKCONO, '')), 3), RKDIVI) AS [entity_id],
       REPLACE(
                  REPLACE(
                             REPLACE(CONCAT(RTRIM(RKBIT1), '-', RTRIM(RKBIT2), '-', RTRIM(RKBIT7), 'END'), '--END', ''),
                             '-END',
                             ''
                         ),
                  'END',
                  ''
              ) AS acct_id,
       RKBIT1 AS acct_id_1,
       RKBIT2 AS acct_id_2,
       RKBIT7 AS acct_id_7,
       CONVERT(NVARCHAR(6), tbl_b.acct_date, 112) AS acct_period,
       SUM(   CASE
                  WHEN tbl_a.acct_date = CASE
                                             WHEN RKDIVI = '026' THEN
                                                 DATEADD(m, -3, tbl_b.acct_date)
                                             ELSE
                                                 tbl_b.acct_date
                                         END THEN
                      RVACAD
                  ELSE
                      0
              END
          ) AS net_amount_debit,
       SUM(   CASE
                  WHEN tbl_a.acct_date = CASE
                                             WHEN RKDIVI = '026' THEN
                                                 DATEADD(m, -3, tbl_b.acct_date)
                                             ELSE
                                                 tbl_b.acct_date
                                         END THEN
                      RVACAC
                  ELSE
                      0
              END
          ) AS net_amount_credit,
       SUM(RVACAD) AS fy_amount_debit,
       SUM(RVACAC) AS fy_amount_credit,
       SUM(   CASE
                  WHEN tbl_a.RVPERI &lt;&gt; 0 THEN
                      RVACAD
                  ELSE
                      0
              END
          ) AS cy_amount_debit,
       SUM(   CASE
                  WHEN tbl_a.RVPERI &lt;&gt; 0 THEN
                      RVACAC
                  ELSE
                      0
              END
          ) AS cy_amount_credit
FROM
(
    SELECT K.[RKCONO],
      K.[RKDIVI],
      K.[RKBAKY],
      K.[RKBIT1],
      K.[RKBIT2],
      --K.[RKBIT3],
      --K.[RKBIT4],
      --K.[RKBIT5],
      --K.[RKBIT6],
      K.[RKBIT7],
      B.[RVYEA4],
      B.[RVPERI],
      B.[RVACAD],
      B.[RVACAC],
      C.EAAT01 AS BSACCT,
      C.EAAT02 AS PLACCT,
      CAST(CAST(CASE
                         WHEN RVPERI = 0 THEN
                             1
                         WHEN RVPERI = 13 THEN
                             12
                         ELSE
                             RVPERI
                     END AS VARCHAR) + '/1/' + CAST(RVYEA4 AS VARCHAR) AS DATE) AS acct_date
    FROM FBAKEY AS K
        JOIN FBAVAL AS B
            ON B.RVBAKY = K.RKBAKY
               AND K.RKPTID = B.RVPTID
               AND K.RKBAKY = 8
               AND K.RKCONO = B.RVCONO
			   AND B.RVVTYP = 0
			   AND COALESCE(B.deleted ,0 ) = 0
        JOIN FCHACC AS C
            ON K.RKCONO = C.EACONO
               AND K.RKDIVI = C.EADIVI
               AND K.RKBIT1 = C.EAAITM
               AND C.EAAITP = '1'
			   AND COALESCE(C.deleted ,0 ) = 0
    WHERE COALESCE(K.deleted ,0 ) = 0 AND RKCONO = '900'
) AS tbl_a
CROSS JOIN
(
    SELECT DISTINCT 
           CAST(CAST(RVPERI AS VARCHAR) + '/1/' + CAST(RVYEA4 AS VARCHAR) AS DATE) AS acct_date
    FROM FBAVAL
    WHERE RVCONO = '900' AND COALESCE(deleted ,0 ) = 0
          AND ((RVYEA4 = YEAR(GETDATE())
                AND RVPERI = MONTH(GETDATE()))
               OR (RVYEA4 = YEAR(DATEADD(d, -15, GETDATE()))
                   AND RVPERI = MONTH(DATEADD(d, -15, GETDATE()))))
) AS tbl_b
WHERE (PLACCT = 0
      AND tbl_a.acct_date &lt;= CASE
                                 WHEN RKDIVI = '026'
                                 THEN DATEADD(m, -3, tbl_b.acct_date)
                                 ELSE tbl_b.acct_date
                             END
      AND YEAR(tbl_a.acct_date) = YEAR(CASE
                                           WHEN RKDIVI = '026'
                                           THEN DATEADD(m, -3, tbl_b.acct_date)
                                           ELSE tbl_b.acct_date
                                       END))
     OR (PLACCT = 1
         AND tbl_a.acct_date &lt;= CASE
                                    WHEN RKDIVI = '026'
                                    THEN DATEADD(m, -3, tbl_b.acct_date)
                                    ELSE tbl_b.acct_date
                                END
         AND ((YEAR(tbl_a.acct_date) = YEAR(tbl_b.acct_date)
               AND RKDIVI &lt;&gt; '026')
              OR (RKDIVI = '026'
                  AND tbl_a.acct_date &gt;= CAST('10/1/' + CAST(YEAR(DATEADD(m, -3, tbl_b.acct_date)) - 1 AS NVARCHAR(4)) AS DATE))))
GROUP BY CONCAT(RIGHT(CONCAT('000', ISNULL(RKCONO, '')), 3), RKDIVI),
         REPLACE(
                    REPLACE(
                               REPLACE(
                                          CONCAT(RTRIM(RKBIT1), '-', RTRIM(RKBIT2), '-', RTRIM(RKBIT7), 'END'),
                                          '--END',
                                          ''
                                      ),
                               '-END',
                               ''
                           ),
                    'END',
                    ''
                ),
         RKBIT1,
         RKBIT2,
         RKBIT7,
         CONVERT(NVARCHAR(6), tbl_b.acct_date, 112);</property>
