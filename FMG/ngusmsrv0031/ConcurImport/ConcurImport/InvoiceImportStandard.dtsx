         * */
        #endregion


        /// <summary>
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// </summary>
        byte[] emptyByte = new byte[0];
        string packageName;
        string connectionString;

        public void Main()
        {
            // TODO: Add your code here
            packageName = Dts.Variables["PackageName"].Value.ToString();
            connectionString = Dts.Variables["CNN_Concur_Invoice_Worktables"].Value.ToString();

            Dts.Log($"{packageName} - Entring {System.Reflection.MethodBase.GetCurrentMethod().Name.ToString()}", 0, emptyByte);

            string importFile = Dts.Variables["varImportFile"].Value.ToString();
            FileInfo fileInfo = new FileInfo(importFile);

            //string directoryPath = fileInfo.DirectoryName;
            //string storePath = Path.Combine(directoryPath, "save", "store");

            //DirectoryInfo directoryInfo = new DirectoryInfo(storePath);
            //FileInfo[] files = directoryInfo.GetFiles("*.TXT");

            try
            {
                //foreach (var item in files)
                //{
                string firstLine = File.ReadAllLines(fileInfo.FullName).First();
                var firstLineCol = firstLine.Split('|');

                Model.Concur_Standard_Raw_Files concur_Raw_File = new Model.Concur_Standard_Raw_Files()
                {
                    Raw_File_Name = fileInfo.Name,
                    Raw_File_Path = Path.Combine(fileInfo.DirectoryName.ToLower(), "processed"),
                    Batch_Id = (firstLineCol.Length > 1 ? firstLineCol[1].ToNullableInt() : (int?)null),
                    Batch_Date = (firstLineCol.Length > 2 ? firstLineCol[2] : null),
                    Record_Count = (firstLineCol.Length > 3 ? firstLineCol[3].ToNullableInt() : (int?)null),
                    Journal_Amount_Total = (firstLineCol.Length > 4 ? firstLineCol[4].ToNullableDecimal() : (decimal?)null)
                };
                Guid raw_file_id = InsertFile(concur_Raw_File);

                List<Model.Concur_Standard_Raw_Files_Data> concur_Raw_Files_Data = new List<Model.Concur_Standard_Raw_Files_Data>();
                int lineNumber = 0;
                foreach (string line in File.ReadAllLines(fileInfo.FullName).Skip(1))
                {
                    lineNumber++;
                    var dataCol = line.Split('|');

