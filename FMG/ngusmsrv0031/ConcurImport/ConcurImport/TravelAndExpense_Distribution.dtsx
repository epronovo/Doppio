                DTS:Name="SqlStatementSource">"INSERT INTO " + @[$Package::PLP81EU] + " (BTCH81, BDAT81, CONO81, RCUR81, CNTY81, PNME81, SCUR81, CEXR81, RDIR81, ACCT81, TTYP81, JAMT81, ACM181, ACM281, CACT81, LACT81, FNAM81, LNAM81, CODE81, PDAT81, PTIM81, EDAT81, ETIM81, DOCR81, GLBT81)
