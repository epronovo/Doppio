              <DTS:Variables />
              <DTS:PropertyExpression
                DTS:Name="SqlStatementSource">"SELECT COUNT(1) as jba_batch_insert_row_count FROM " + @[$Package::BR_PLP81U]  + " WHERE BTCH81 = " + @[User::batch_id]</DTS:PropertyExpression>
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
