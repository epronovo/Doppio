            <DTS:Executable
              DTS:refId="Package\Foreach Batch ID\JBA_Aurora\Check if Batch Already Exists"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{D1677548-D16D-4375-B108-61A12B6EBA33}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Check if Batch Already Exists"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:PropertyExpression
                DTS:Name="SqlStatementSource">"SELECT COUNT(1) as jba_batch_count FROM " + @[$Package::PLP81U] + " WHERE BTCH81 = " + @[User::batch_id]</DTS:PropertyExpression>
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{FB795368-5072-49B4-9CF0-590F4D88995B}"
                  SQLTask:SqlStatementSource="SELECT COUNT(1) as jba_batch_count FROM PRDMODSF4.PLP81U WHERE BTCH81 = "
                  SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ResultBinding
                    SQLTask:ResultName="jba_batch_count"
                    SQLTask:DtsVariableName="User::jba_batch_count" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
            </DTS:Executable>
