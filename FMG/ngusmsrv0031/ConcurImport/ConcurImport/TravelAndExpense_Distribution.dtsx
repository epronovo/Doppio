              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Check if Batch Already Exists"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:PropertyExpression
                DTS:Name="SqlStatementSource">"SELECT COUNT(1) as jba_batch_count FROM " + @[$Package::BR_PLP81U]   + " WHERE BTCH81 = "  +  @[User::batch_id]</DTS:PropertyExpression>
