                        cmd.Parameters.AddWithValue("@raw_file_path", concur_Raw_File.Raw_File_Path);
                        cmd.Parameters.AddWithValue("@batch_id", concur_Raw_File.Batch_Id);
                        cmd.Parameters.AddWithValue("@offset_batch_id", concur_Raw_File.Offset_Batch_Id);
                        cmd.Parameters.AddWithValue("@record_count", ((object)concur_Raw_File.Record_Count) ?? DBNull.Value);
                        cmd.Parameters.AddWithValue("@journal_amount", ((object)concur_Raw_File.Journal_Amount) ?? DBNull.Value);
                        cmd.Parameters.Add("@raw_file_id", System.Data.SqlDbType.UniqueIdentifier);
                        cmd.Parameters["@raw_file_id"].Direction = System.Data.ParameterDirection.Output;

